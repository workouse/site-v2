---
/**
 * AuditForm — URL and work-email request form for the free website audit.
 *
 * Mounted on the /audit route inside the new Layout. Flow: validate the URL
 * locally, POST { url, email } to /api/audit, then either forward to an already
 * completed report (cached) or confirm that the verification email was sent.
 * Feedback is written with textContent only, so API messages are never parsed as HTML.
 */
import Button from '../ui/Button.astro';
---

<form id="auditForm" class="audit-form">
  <div class="audit-form__field">
    <label for="auditUrl" class="audit-form__label">Website URL</label>
    <input
      type="text"
      id="auditUrl"
      name="url"
      class="audit-form__input"
      placeholder="example.com"
      autocomplete="url"
      inputmode="url"
      required
    />
  </div>

  <div class="audit-form__field">
    <label for="auditEmail" class="audit-form__label">Work email</label>
    <p id="auditEmailHint" class="audit-form__hint">For a 1-click verification link</p>
    <input
      type="email"
      id="auditEmail"
      name="email"
      class="audit-form__input"
      placeholder="you@company.com"
      autocomplete="email"
      aria-describedby="auditEmailHint"
      required
    />
  </div>

  <div id="formFeedback" class="audit-form__feedback" role="status" aria-live="polite" hidden></div>

  <Button kind="primary" type="submit" id="submitBtn" icon="→" block class="audit-form__submit">
    <span id="btnText">Run free website audit</span>
    <span id="btnSpinner" class="audit-form__spinner" aria-hidden="true" hidden></span>
  </Button>

  <p class="audit-form__note">
    Spam protection: a verification link is emailed before any audit runs.
  </p>
</form>

<script>
  import { trackAuditRequested } from '../../lib/analytics';
  import { validateAuditUrl } from '../../lib/url-validator';

  interface AuditApiResponse {
    message?: string;
    error?: string;
    redirectUrl?: string;
    cached?: boolean;
    verifyUrlDev?: string;
  }

  type FeedbackTone = 'success' | 'error';

  const AUDIT_API_ENDPOINT = '/api/audit';
  const AUDIT_TRACKING_SOURCE = 'audit_page';
  const REDIRECT_DELAY_MS = 1200;
  const SUBMIT_LABEL = 'Run free website audit';
  const VERIFYING_LABEL = 'Verifying domain...';
  const DEFAULT_URL_ERROR = 'Please provide a valid website URL.';
  const DEFAULT_REQUEST_ERROR = 'Failed to initiate audit.';
  const DEV_LOG_PREFIX = '[DEV ONLY] Verification link:';

  function showFeedback(element: HTMLElement, message: string, tone: FeedbackTone): void {
    element.textContent = message;
    element.dataset.tone = tone;
    element.hidden = false;
  }

  function clearFeedback(element: HTMLElement): void {
    element.hidden = true;
    element.textContent = '';
    element.removeAttribute('data-tone');
  }

  function initAuditForm(): void {
    const form = document.getElementById('auditForm') as HTMLFormElement | null;
    const feedback = document.getElementById('formFeedback');
    const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement | null;
    const btnText = document.getElementById('btnText');
    const btnSpinner = document.getElementById('btnSpinner');

    if (!form || !feedback || !submitBtn || !btnText || !btnSpinner) return;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      clearFeedback(feedback);

      const formData = new FormData(form);
      const url = String(formData.get('url') ?? '');
      const email = String(formData.get('email') ?? '');

      // Instant client-side URL validation before any network call
      const localCheck = await validateAuditUrl(url, { checkDns: false });
      if (!localCheck.isValid) {
        showFeedback(feedback, localCheck.error || DEFAULT_URL_ERROR, 'error');
        return;
      }

      submitBtn.disabled = true;
      btnText.textContent = VERIFYING_LABEL;
      btnSpinner.hidden = false;

      trackAuditRequested({
        targetUrl: url,
        hasEmail: Boolean(email),
        source: AUDIT_TRACKING_SOURCE,
      });

      try {
        const res = await fetch(AUDIT_API_ENDPOINT, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ url, email }),
        });

        const data = (await res.json()) as AuditApiResponse;

        if (!res.ok) {
          throw new Error(data.error || DEFAULT_REQUEST_ERROR);
        }

        if (data.redirectUrl) {
          showFeedback(
            feedback,
            data.cached ? `⚡ ${data.message ?? ''} Opening report...` : `✅ ${data.message ?? ''}`,
            'success',
          );
          form.reset();

          window.setTimeout(() => {
            window.location.href = data.redirectUrl as string;
          }, REDIRECT_DELAY_MS);
          return;
        }

        showFeedback(feedback, `✅ ${data.message ?? ''}`, 'success');
        form.reset();

        if (data.verifyUrlDev) {
          console.log(DEV_LOG_PREFIX, data.verifyUrlDev);
        }
      } catch (err: unknown) {
        const message = err instanceof Error ? err.message : DEFAULT_REQUEST_ERROR;
        showFeedback(feedback, `⚠️ ${message}`, 'error');
      } finally {
        submitBtn.disabled = false;
        btnText.textContent = SUBMIT_LABEL;
        btnSpinner.hidden = true;
      }
    });
  }

  initAuditForm();
</script>

<style>
  .audit-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-24, 24px);
    width: 100%;
    font-family: var(--font-sans);
    font-variation-settings: var(--font-sans-opsz);
    color: var(--text-primary);
  }

  .audit-form__field {
    display: flex;
    flex-direction: column;
    gap: var(--space-8, 8px);
  }

  .audit-form__label {
    font-size: 14px;
    line-height: 20px;
    font-weight: 500;
    color: var(--text-primary);
  }

  .audit-form__hint {
    margin: 0;
    font-size: 12px;
    line-height: 18px;
    color: var(--text-secondary, #5b6574);
  }

  /* 44px minimum target; 16px text prevents iOS zoom-on-focus. */
  .audit-form__input {
    box-sizing: border-box;
    width: 100%;
    min-height: 44px;
    margin: 0;
    padding: var(--space-12, 12px) var(--space-16, 16px);
    border: 1px solid var(--border-subtle, #d7d9df);
    border-radius: var(--radius-2, 2px);
    background-color: var(--surface-raised, #ffffff);
    color: var(--text-primary);
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 26px;
    font-variation-settings: var(--font-sans-opsz);
  }

  .audit-form__input::placeholder {
    color: var(--text-secondary, #5b6574);
  }

  .audit-form__input:focus-visible {
    outline: 2px solid var(--focus-color, #53658e);
    outline-offset: 2px;
  }

  .audit-form__feedback {
    box-sizing: border-box;
    padding: var(--space-16, 16px);
    border: 1px solid var(--border-subtle, #d7d9df);
    border-radius: var(--radius-2, 2px);
    background-color: var(--surface-raised, #ffffff);
    color: var(--text-primary);
    font-size: 14px;
    line-height: 20px;
  }

  .audit-form__feedback[hidden] {
    display: none;
  }

  .audit-form__feedback[data-tone='error'] {
    border-color: var(--text-link, #53658e);
  }

  .audit-form__submit {
    width: 100%;
  }

  .audit-form__spinner {
    display: inline-block;
    width: 16px;
    height: 16px;
    margin-left: var(--space-8, 8px);
    border: 2px solid currentColor;
    border-right-color: transparent;
    border-radius: 50%;
    vertical-align: middle;
    animation: audit-form-spin 0.8s linear infinite;
  }

  .audit-form__spinner[hidden] {
    display: none;
  }

  .audit-form__note {
    margin: 0;
    font-size: 12px;
    line-height: 18px;
    color: var(--text-secondary, #5b6574);
    text-align: center;
  }

  @keyframes audit-form-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .audit-form__spinner {
      animation-duration: 2.4s;
    }
  }
</style>

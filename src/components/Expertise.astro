---
---

<section id="expertise" class="py-24 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto border-t border-zinc-900 scroll-mt-16">
  
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-16">
    
    <!-- Left Side: Tech Stack & Niche Innovation -->
    <div class="lg:col-span-7 space-y-12">
      <!-- Title -->
      <div class="space-y-3">
        <div class="flex items-center gap-3">
          <span class="text-xs font-mono font-bold tracking-widest text-brand-yellow uppercase">Expertise</span>
          <span class="h-[1px] w-8 bg-zinc-800"></span>
        </div>
        <h2 class="font-display text-3xl font-bold tracking-tight text-white">
          Technical Capabilities & Stack
        </h2>
        <p class="text-zinc-400 font-sans text-sm sm:text-base leading-relaxed">
          I build platforms using vetted, mature languages and tools that guarantee performance, type safety, and deployment reproducibility.
        </p>
      </div>

      <!-- Core Tech Badges -->
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
        {[
          { name: "PHP / Symfony", desc: "Enterprise Backends & Core Frameworks" },
          { name: "TS / JS / Node / Express / Astro", desc: "Fluid Fullstack UIs & Edge APIs" },
          { name: "Haskell / Nix", desc: "Functional Systems & Reproducible Environments" },
          { name: "Rust / Go / Python", desc: "High-performance Tooling & Data Pipelines" },
          { name: "DevOps & Security", desc: "Hardened CI/CD & Secure Architecture" },
          { name: "AWS / Cloudflare", desc: "Highly Available & Distributed Edge Hosting" }
        ].map(tech => (
          <div class="p-4 rounded-xl border border-zinc-800/80 bg-zinc-900/10 hover:border-zinc-700 hover:bg-zinc-900/30 transition duration-300">
            <div class="font-mono text-[11px] sm:text-xs font-semibold text-zinc-100">{tech.name}</div>
            <div class="text-[9px] text-zinc-500 font-sans mt-1">{tech.desc}</div>
          </div>
        ))}
      </div>

      <!-- Niche Innovation Block -->
      <div class="p-6 rounded-2xl border border-zinc-900 bg-zinc-950/40 space-y-4">
        <h3 class="font-display text-sm font-bold uppercase tracking-wider text-zinc-300 flex items-center gap-2">
          <svg class="w-4 h-4 text-brand-yellow" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
          </svg>
          Niche Innovation Interests
        </h3>
        <p class="text-xs text-zinc-400 font-sans leading-relaxed">
          I am actively engaged in developing architectures for decentralized networks and privacy-focused systems. This includes building custom relays for the <span class="text-zinc-200">Nostor protocol</span>, engineering peer-to-peer (P2P) systems, and implementing secure cryptographic/Web3 validation mechanisms.
        </p>
      </div>
    </div>

    <!-- Right Side: Open Source Contributions -->
    <div class="lg:col-span-5 space-y-8">
      <div class="space-y-3">
        <div class="flex items-center gap-3">
          <span class="text-xs font-mono font-bold tracking-widest text-brand-yellow uppercase">OSS</span>
          <span class="h-[1px] w-8 bg-zinc-800"></span>
        </div>
        <h2 class="font-display text-3xl font-bold tracking-tight text-white">
          Open Source
        </h2>
        <p class="text-zinc-400 font-sans text-sm leading-relaxed">
          I maintain and contribute to tools that improve SEO health and enterprise e-commerce velocity.
        </p>
      </div>

      <div class="space-y-4">
        <!-- Project 1 -->
        <a 
          href="https://github.com/workouse" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="block p-6 rounded-2xl border border-zinc-900 bg-zinc-950/20 hover:border-zinc-800 hover:bg-zinc-900/20 transition group"
        >
          <div class="flex items-center justify-between mb-2">
            <span class="font-mono text-sm font-semibold text-zinc-200 group-hover:text-brand-yellow transition duration-300">
              Sitemap Validation Tools
            </span>
            <svg class="w-4 h-4 text-zinc-600 group-hover:text-brand-yellow transition duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </div>
          <p class="text-xs text-zinc-500 font-sans leading-relaxed">
            Automated Go-based sitemap parsers and validation scrapers to verify site mapping integrity and search crawler compliance for massive static and headless storefronts.
          </p>
        </a>

        <!-- Project 2 -->
        <a 
          href="https://github.com/workouse" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="block p-6 rounded-2xl border border-zinc-900 bg-zinc-950/20 hover:border-zinc-800 hover:bg-zinc-900/20 transition group"
        >
          <div class="flex items-center justify-between mb-2">
            <span class="font-mono text-sm font-semibold text-zinc-200 group-hover:text-brand-yellow transition duration-300">
              Custom E-commerce Extensions
            </span>
            <svg class="w-4 h-4 text-zinc-600 group-hover:text-brand-yellow transition duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </div>
          <p class="text-xs text-zinc-500 font-sans leading-relaxed">
            Plugins and extensions for the Sylius headless PHP framework, addressing complex logistics, checkout automation, and currency normalization rules.
          </p>
        </a>
      </div>

    </div>

  </div>
</section>

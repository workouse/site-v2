---
import { getFeaturedOrLatestPosts } from '../lib/blog';
import BlogCard from './BlogCard.astro';

interface Props {
  lang?: 'en' | 'tr';
  limit?: number;
}

const { lang = 'en', limit = 3 } = Astro.props;
const posts = await getFeaturedOrLatestPosts(lang, limit);
---

{posts.length > 0 && (
  <section id="journal" class="py-24 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto border-t border-zinc-200 dark:border-zinc-900 scroll-mt-16 transition-colors duration-300">
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
      <div class="max-w-2xl space-y-3">
        <div class="inline-flex items-center gap-3">
          <span class="text-xs font-mono font-bold tracking-widest text-brand-blue dark:text-brand-yellow uppercase">// Engineering Journal</span>
          <span class="h-[1px] w-8 bg-zinc-300 dark:bg-zinc-800"></span>
        </div>
        <h2 class="font-display text-3xl sm:text-4xl font-bold tracking-tight text-zinc-950 dark:text-white">
          Latest Insights & Architecture Notes
        </h2>
        <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-400">
          In-depth technical writeups on edge computing, distributed architectures, high-concurrency systems, and production engineering.
        </p>
      </div>

      <!-- Desktop View All Link -->
      <div class="hidden md:block shrink-0">
        <a
          href={lang === 'tr' ? '/blog/tr' : '/blog'}
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-xs font-mono font-semibold uppercase tracking-wider bg-zinc-100 dark:bg-zinc-900 text-zinc-900 dark:text-zinc-100 border border-zinc-200 dark:border-zinc-800 hover:border-brand-yellow/50 hover:text-brand-blue dark:hover:text-brand-yellow transition duration-300"
        >
          <span>{lang === 'tr' ? 'Tüm Yazılar' : 'View All Articles'}</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </div>

    <!-- 3-Column Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-10">
      {posts.map((post) => (
        <BlogCard post={post} lang={lang} />
      ))}
    </div>

    <!-- Mobile View All Link -->
    <div class="md:hidden text-center pt-2">
      <a
        href={lang === 'tr' ? '/blog/tr' : '/blog'}
        class="inline-flex items-center justify-center w-full py-3 px-6 rounded-xl text-xs font-mono font-semibold uppercase tracking-wider bg-zinc-100 dark:bg-zinc-900 text-zinc-900 dark:text-zinc-100 border border-zinc-200 dark:border-zinc-800 hover:text-brand-blue dark:hover:text-brand-yellow transition duration-300"
      >
        <span>{lang === 'tr' ? 'Tüm Yazıları Gör' : 'View All Articles'}</span>
        <svg class="w-4 h-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  </section>
)}

---
interface Props {
  currentLang: 'en' | 'tr';
  targetPathEn?: string;
  targetPathTr?: string;
}

const {
  currentLang,
  targetPathEn = '/blog',
  targetPathTr = '/blog/tr',
} = Astro.props;
---

<div class="inline-flex items-center p-1 rounded-full bg-zinc-900 border border-zinc-800 text-xs font-medium">
  <a
    href={targetPathEn}
    class={`px-3 py-1 rounded-full transition-all duration-200 ${
      currentLang === 'en'
        ? 'bg-brand-yellow text-zinc-950 font-bold shadow-sm'
        : 'text-zinc-400 hover:text-zinc-100'
    }`}
    aria-label="Switch to English"
  >
    🇬🇧 EN
  </a>
  <a
    href={targetPathTr}
    class={`px-3 py-1 rounded-full transition-all duration-200 ${
      currentLang === 'tr'
        ? 'bg-brand-yellow text-zinc-950 font-bold shadow-sm'
        : 'text-zinc-400 hover:text-zinc-100'
    }`}
    aria-label="Türkçe'ye geç"
  >
    🇹🇷 TR
  </a>
</div>

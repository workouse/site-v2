                          ? `
                          <div class="text-zinc-300 text-[11px] space-y-0.5">
                            <div>Title: <strong class="${rawResults.seo.hasTitle ? 'text-emerald-400' : 'text-rose-400'}">${rawResults.seo.hasTitle ? 'Present' : 'Missing'}</strong></div>
                            <div>Meta Description: <strong class="${rawResults.seo.hasMetaDescription ? 'text-emerald-400' : 'text-amber-400'}">${rawResults.seo.hasMetaDescription ? 'Present' : 'Missing'}</strong></div>
                            <div>H1 Count: <strong>${rawResults.seo.h1Count}</strong></div>
                            <div>Canonical Tag: <strong>${rawResults.seo.hasCanonical ? 'Present' : 'Missing'}</strong></div>
                            <div>Robots.txt: <strong>${rawResults.seo.hasRobotsTxt ? 'Present' : 'Missing'}</strong></div>
                          </div>
                        `
                          : '<div class="text-zinc-500 text-[11px]">No raw SEO data recorded</div>'
                      }
                    </div>
                  </div>

                  <!-- Actionable Issues & Flagged Items Breakdown -->
                  ${
                    aiOutput?.issues && aiOutput.issues.length > 0
                      ? `
                    <div class="bg-zinc-950/90 border border-zinc-850 p-3.5 rounded-xl space-y-2.5">
                      <div class="flex items-center justify-between">
                        <span class="text-[#FEC500] font-bold text-[11px] uppercase tracking-wider flex items-center gap-1.5">
                          <span>⚡ Actionable Issues & Flagged Items (${aiOutput.issues.length})</span>
                        </span>
                        <span class="text-[10px] text-zinc-400 font-mono">Immediate Targets</span>
                      </div>
                      <div class="space-y-2 max-h-72 overflow-y-auto pr-1">
                        ${aiOutput.issues
                          .map(
                            (iss: any) => `
                          <div class="p-2.5 rounded-lg bg-zinc-900 border border-zinc-800 space-y-1.5 font-mono text-[11px]">
                            <div class="flex flex-wrap items-center justify-between gap-2">
                              <div class="flex items-center gap-2">
                                <span class="px-2 py-0.5 rounded text-[9px] font-bold uppercase ${
                                  iss.severity === 'critical'
                                    ? 'bg-rose-950 text-rose-400 border border-rose-800'
                                    : iss.severity === 'warning'
                                    ? 'bg-amber-950 text-amber-400 border border-amber-800'
                                    : 'bg-blue-950 text-blue-400 border border-blue-800'
                                }">${iss.severity}</span>
                                <strong class="text-zinc-100 font-bold">${iss.title}</strong>
                              </div>
                              <span class="text-zinc-400 text-[10px]">${iss.estimatedMinutes || 0}m · $${iss.price || 0} USD</span>
                            </div>
                            ${
                              iss.proof
                                ? `<div class="text-[10px] text-zinc-400">🔍 <span class="text-zinc-300">${iss.proof}</span></div>`
                                : ''
                            }
                            ${
                              iss.items && iss.items.length > 0
                                ? `
                              <div class="mt-1.5 space-y-1 border-t border-zinc-800 pt-1.5">
                                ${iss.items
                                  .map(
                                    (it: any) => `
                                  <div class="flex flex-wrap items-center justify-between gap-2 text-[10px] text-zinc-400 bg-zinc-950 p-1.5 rounded border border-zinc-850">
                                    <div class="truncate max-w-md">
                                      ${it.url ? `<a href="${it.url.startsWith('http') ? it.url : '#'}" target="_blank" class="text-blue-400 hover:underline font-mono font-semibold">${it.url}</a>` : ''}
                                      ${it.selector ? `<code class="text-purple-300 font-mono bg-zinc-900 px-1 py-0.5 rounded">${it.selector}</code>` : ''}
                                      ${it.label ? `<span class="text-zinc-200 font-bold ml-1">${it.label}</span>` : ''}
                                      ${it.snippet ? `<span class="text-zinc-400 font-mono ml-1">(${it.snippet})</span>` : ''}
                                    </div>
                                    <div class="flex items-center gap-1.5 shrink-0 font-mono">
                                      ${it.size ? `<span class="text-zinc-200 font-bold bg-zinc-800 px-1.5 py-0.5 rounded text-[9px]">${it.size}</span>` : ''}
                                      ${it.wasted ? `<span class="text-amber-400 font-bold bg-amber-950/40 px-1.5 py-0.5 rounded text-[9px]">${it.wasted}</span>` : ''}
                                      ${it.details ? `<span class="text-zinc-400 text-[9px]">${it.details}</span>` : ''}
                                    </div>
                                  </div>
                                `
                                  )
                                  .join('')}
                              </div>
                            `
                                : ''
                            }
                          </div>
                        `
                          )
                          .join('')}
                      </div>
                    </div>
                  `
                      : ''
                  }

                  <!-- Raw JSON Accordion -->
                  <details class="bg-zinc-950/80 border border-zinc-850 rounded-lg p-2.5">
                    <summary class="cursor-pointer font-bold text-zinc-400 hover:text-white transition text-[11px] select-none">
                      🔍 View Complete Raw API Payload JSON (Debug Mode)
                    </summary>
                    <pre class="mt-2 p-3 bg-black rounded border border-zinc-850 text-[10px] text-emerald-400 overflow-x-auto max-h-60 font-mono">${JSON.stringify({ rawResults, aiOutput, auditLogs }, null, 2)}</pre>
                  </details>
                </div>
              </div>
            `;
          })
          .join('');

        // Wire Accordion Toggle Handlers
        container.querySelectorAll('.btn-toggle-accordion').forEach((btn) => {
          btn.addEventListener('click', (e) => {
            e.stopPropagation();
            const targetId = btn.getAttribute('data-target');
            if (!targetId) return;
            const content = document.getElementById(targetId);
            const parentRow = document.getElementById(targetId.replace('audit_details_', 'audit_row_'));
            const chevrons = parentRow?.querySelectorAll('.chevron-icon');

            if (content?.classList.contains('hidden')) {
              content.classList.remove('hidden');
              chevrons?.forEach((c) => c.classList.add('rotate-180'));
            } else if (content) {
              content.classList.add('hidden');
              chevrons?.forEach((c) => c.classList.remove('rotate-180'));
            }
          });
        });

        // Wire Inline Re-audit Handlers
        container.querySelectorAll('.btn-reaudit-item').forEach((btn) => {
          btn.addEventListener('click', async (e) => {
            e.stopPropagation();
            const buttonEl = btn as HTMLButtonElement;
            const auditId = buttonEl.getAttribute('data-audit-id') || '';
            const targetUrl = buttonEl.getAttribute('data-url') || '';
            const email = buttonEl.getAttribute('data-email') || '';
            const originalContent = buttonEl.innerHTML;

            buttonEl.disabled = true;
            buttonEl.innerHTML = `
              <svg class="w-3.5 h-3.5 animate-spin text-amber-400" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
              </svg>
              <span>Queuing...</span>
            `;

            adminLog('info', 'RE-AUDIT', `POST /api/admin/re-audit (item inline) → ${JSON.stringify({ auditId, url: targetUrl, email })}`);

            try {
              const res = await fetch('/api/admin/re-audit', {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json',
                  Authorization: `Bearer ${token}`,
                },
                body: JSON.stringify({ auditId, url: targetUrl, email }),
              });

              if (res.status === 401 || res.status === 403) {
                handleUnauthorized();
                return;
              }

              const resData: any = await res.json();
              if (res.ok && resData.success) {
                adminLog('success', 'RE-AUDIT', `Enqueued — auditId: ${resData.auditId}`);
                buttonEl.innerHTML = `<span>✓ Queued</span>`;
                buttonEl.className = 'btn-reaudit-item bg-emerald-950/80 text-emerald-400 border border-emerald-800/80 px-2.5 py-1.5 rounded-lg text-xs font-semibold flex items-center gap-1.5';
                setTimeout(() => {
                  fetchAuditLogs(token, _currentAuditSearch, _currentAuditPage);
                }, 1200);
              } else {
                adminLog('error', 'RE-AUDIT', `${res.status} — ${resData?.error || 'Failed to trigger re-audit'}`);
                alert(`Re-audit error: ${resData?.error || 'Failed to trigger re-audit'}`);
                buttonEl.disabled = false;
                buttonEl.innerHTML = originalContent;
              }
            } catch (err: any) {
              adminLog('error', 'RE-AUDIT', `Network error — ${err.message}`);
              alert(`Network error: ${err.message}`);
              buttonEl.disabled = false;
              buttonEl.innerHTML = originalContent;
            }
          });
        });

        // Wire Delete / Remove Handlers
        container.querySelectorAll('.btn-delete-item').forEach((btn) => {
          btn.addEventListener('click', async (e) => {
            e.stopPropagation();
            const buttonEl = btn as HTMLButtonElement;
            const auditId = buttonEl.getAttribute('data-audit-id') || '';
            const targetUrl = buttonEl.getAttribute('data-url') || '';

            const confirmed = window.confirm(
              `Are you sure you want to permanently delete the audit report for:\n${targetUrl} (ID: ${auditId})?\n\nThis will remove all associated database records and R2 storage objects.`
            );

            if (!confirmed) return;

            buttonEl.disabled = true;
            buttonEl.innerHTML = `
              <svg class="w-3.5 h-3.5 animate-spin text-rose-400" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
              </svg>
              <span>Deleting...</span>
            `;

            adminLog('info', 'DELETE-AUDIT', `DELETE /api/admin/audit-logs?id=${auditId} → pending`);

            try {
              const res = await fetch(`/api/admin/audit-logs?id=${encodeURIComponent(auditId)}`, {
                method: 'DELETE',
                headers: {
                  Authorization: `Bearer ${token}`,
                },
              });

              if (res.status === 401 || res.status === 403) {
                handleUnauthorized();
                return;
              }

              const resData: any = await res.json();
              if (res.ok && resData.success) {
                adminLog('success', 'DELETE-AUDIT', `Deleted audit ${auditId}`);
                // Refresh list on current page (or previous if last item on page)
                const newPage = (_currentAuditPage > 1 && data.logs.length === 1) ? _currentAuditPage - 1 : _currentAuditPage;
                fetchAuditLogs(token, _currentAuditSearch, newPage);
              } else {
                adminLog('error', 'DELETE-AUDIT', `${res.status} — ${resData?.error || 'Failed to delete audit'}`);
                alert(`Delete error: ${resData?.error || 'Failed to delete audit'}`);
                buttonEl.disabled = false;
                buttonEl.innerHTML = `
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                  </svg>
                  <span>Delete</span>
                `;
              }
            } catch (err: any) {
              adminLog('error', 'DELETE-AUDIT', `Network error — ${err.message}`);
              alert(`Network error: ${err.message}`);
              buttonEl.disabled = false;
              buttonEl.innerHTML = `
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                </svg>
                <span>Delete</span>
              `;
            }
          });
        });

        // Update Pagination Controls UI
        renderPaginationControls(token);
      } else {
        adminLog('error', 'AUDIT-LOGS', `${res.status} ${res.statusText} — ${data?.error || 'unexpected response'}`);
      }
    } catch (err: any) {
      adminLog('error', 'AUDIT-LOGS', `Network error — ${err.message}`);
    }
  }

  function renderPaginationControls(token: string) {
    const paginationContainer = document.getElementById('auditPaginationContainer');
    const startEl = document.getElementById('auditPageStart');
    const endEl = document.getElementById('auditPageEnd');
    const totalEl = document.getElementById('auditPageTotal');
    const prevBtn = document.getElementById('auditPrevPageBtn') as HTMLButtonElement | null;
    const nextBtn = document.getElementById('auditNextPageBtn') as HTMLButtonElement | null;
    const numbersContainer = document.getElementById('auditPageNumbers');

    if (!paginationContainer) return;

    if (_totalAuditCount === 0) {
      paginationContainer.classList.add('hidden');
      return;
    }

    paginationContainer.classList.remove('hidden');

    const startIdx = (_currentAuditPage - 1) * _auditLimit + 1;
    const endIdx = Math.min(_currentAuditPage * _auditLimit, _totalAuditCount);

    if (startEl) startEl.innerText = startIdx.toString();
    if (endEl) endEl.innerText = endIdx.toString();
    if (totalEl) totalEl.innerText = _totalAuditCount.toString();

    if (prevBtn) {
      prevBtn.disabled = _currentAuditPage <= 1;
      prevBtn.onclick = () => {
        if (_currentAuditPage > 1) {
          fetchAuditLogs(token, _currentAuditSearch, _currentAuditPage - 1);
        }
      };
    }

    if (nextBtn) {
      nextBtn.disabled = _currentAuditPage >= _totalAuditPages;
      nextBtn.onclick = () => {
        if (_currentAuditPage < _totalAuditPages) {
          fetchAuditLogs(token, _currentAuditSearch, _currentAuditPage + 1);
        }
      };
    }

    if (numbersContainer) {
      // Build sliding window of pages
      const pagesToShow: number[] = [];
      const delta = 2;
      for (let i = 1; i <= _totalAuditPages; i++) {
        if (i === 1 || i === _totalAuditPages || (i >= _currentAuditPage - delta && i <= _currentAuditPage + delta)) {
          pagesToShow.push(i);
        }
      }

      let html = '';
      let lastPage = 0;

      for (const p of pagesToShow) {
        if (lastPage && p - lastPage > 1) {
          html += `<span class="px-2 py-1 text-zinc-600">...</span>`;
        }
        const isActive = p === _currentAuditPage;
        html += `
          <button
            type="button"
            data-page="${p}"
            class="pagination-page-btn px-3 py-1 rounded-lg text-xs font-semibold transition ${
              isActive
                ? 'bg-[#FEC500] text-zinc-950 shadow'
                : 'bg-zinc-900 hover:bg-zinc-800 text-zinc-300 border border-zinc-800'
            }"
          >
            ${p}
          </button>
        `;
        lastPage = p;
      }

      numbersContainer.innerHTML = html;

      numbersContainer.querySelectorAll('.pagination-page-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const pageNum = parseInt(btn.getAttribute('data-page') || '1', 10);
          if (pageNum !== _currentAuditPage) {
            fetchAuditLogs(token, _currentAuditSearch, pageNum);
          }
        });
      });
    }
  }

  if (reAuditForm) {
    reAuditForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!reAuditFeedback || !reAuditInput) return;

      const token = getStoredToken();
      if (!token) {
        handleUnauthorized();
        return;
      }

      const targetVal = reAuditInput.value.trim();
      if (!targetVal) return;

      const isUrlInput = targetVal.startsWith('http://') || targetVal.startsWith('https://') || targetVal.includes('.');
      if (isUrlInput) {
        const urlValidation = await validateAuditUrl(targetVal, { checkDns: false });
        if (!urlValidation.isValid) {
          reAuditFeedback.className = 'text-xs px-3 py-2 rounded-lg font-mono bg-rose-950 text-rose-400 border border-rose-800 block';
          reAuditFeedback.innerText = `⚠️ ${urlValidation.error || 'Please provide a valid website URL.'}`;
          return;
        }
      }

      const reAuditPayload = isUrlInput ? { url: targetVal } : { auditId: targetVal };
      adminLog('info', 'RE-AUDIT', `POST /api/admin/re-audit → ${JSON.stringify(reAuditPayload)}`);

      reAuditFeedback.className = 'text-xs px-3 py-2 rounded-lg font-mono bg-zinc-800 text-zinc-300 block';
      reAuditFeedback.innerText = 'Initiating re-audit job...';

      try {
        const res = await fetch('/api/admin/re-audit', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Authorization: `Bearer ${token}`,
          },
          body: JSON.stringify(reAuditPayload),
        });

        if (res.status === 401 || res.status === 403) {
          adminLog('warn', 'RE-AUDIT', `${res.status} ${res.statusText} — session expired`);
          handleUnauthorized();
          return;
        }

        const data: any = await res.json();
        if (res.ok && data.success) {
          adminLog('success', 'RE-AUDIT', `Enqueued — auditId: ${data.auditId}`);
          reAuditFeedback.className = 'text-xs px-3 py-2 rounded-lg font-mono bg-emerald-950 text-emerald-400 border border-emerald-800 block';
          reAuditFeedback.innerHTML = `Success! Enqueued Re-audit (ID: <span class="font-bold text-white">${data.auditId}</span>)`;
          reAuditInput.value = '';
          loadAdminData();
        } else {
          adminLog('error', 'RE-AUDIT', `${res.status} ${res.statusText} — ${data?.error || 'unexpected response'}`);
          reAuditFeedback.className = 'text-xs px-3 py-2 rounded-lg font-mono bg-rose-950 text-rose-400 border border-rose-800 block';
          reAuditFeedback.innerText = data.error || 'Failed to initiate re-audit.';
        }
      } catch (err: any) {
        adminLog('error', 'RE-AUDIT', `Network error — ${err.message}`);
        reAuditFeedback.className = 'text-xs px-3 py-2 rounded-lg font-mono bg-rose-950 text-rose-400 border border-rose-800 block';
        reAuditFeedback.innerText = err.message || 'Network error.';
      }
    });
  }

  // Initial load
  loadAdminData();
</script>


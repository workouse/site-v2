---
// Workouse Audit Tool - Executive Admin Dashboard Component
---

<div class="space-y-8" id="overview">
  <!-- Top Control & Auth Token Header -->
  <div class="bg-zinc-900/80 border border-zinc-800 p-4 rounded-2xl flex flex-col md:flex-row items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-zinc-800 flex items-center justify-center text-[#FEC500]">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
        </svg>
      </div>
      <div>
        <h2 class="text-white font-bold text-lg leading-snug">Executive Platform Control</h2>
        <p class="text-zinc-400 text-xs">Real-time audit performance, consultation pipeline, and batch operations.</p>
      </div>
    </div>

    <!-- Logged in Admin Info & Actions -->
    <div class="flex items-center gap-3 w-full md:w-auto justify-end">
      <div class="bg-zinc-950 border border-zinc-800 rounded-xl px-3 py-1.5 flex items-center gap-2 text-xs">
        <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
        <span id="adminUserEmailDisplay" class="text-zinc-300 font-mono">admin@workouse.com</span>
      </div>

      <button
        id="refreshAnalyticsBtn"
        class="bg-zinc-800 hover:bg-zinc-700 text-white text-xs font-semibold px-3 py-1.5 rounded-xl border border-zinc-700 transition flex items-center gap-1.5 whitespace-nowrap"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
        </svg>
        Refresh
      </button>

      <button
        id="adminLogoutBtn"
        class="bg-rose-950/60 hover:bg-rose-900/80 text-rose-300 border border-rose-800/60 text-xs font-semibold px-3 py-1.5 rounded-xl transition flex items-center gap-1.5 whitespace-nowrap"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
        </svg>
        Sign Out
      </button>
    </div>
  </div>

  <!-- KPI Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <!-- Stat 1: Total Audits -->
    <div class="bg-zinc-900/60 border border-zinc-800 p-5 rounded-2xl space-y-2">
      <div class="flex items-center justify-between text-zinc-400 text-xs font-medium">
        <span>Total Executed Audits</span>
        <span class="p-1.5 rounded-lg bg-zinc-800/80 text-blue-400">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
        </span>
      </div>
      <div id="statTotalAudits" class="text-3xl font-black text-white tracking-tight">--</div>
      <div class="text-xs text-zinc-400 flex items-center gap-2">
        <span id="statCompletedAudits" class="text-emerald-400 font-semibold">-- completed</span>
        <span>•</span>
        <span id="statFailedAudits" class="text-zinc-500">-- failed</span>
      </div>
    </div>

    <!-- Stat 2: Lead Conversion -->
    <div class="bg-zinc-900/60 border border-zinc-800 p-5 rounded-2xl space-y-2">
      <div class="flex items-center justify-between text-zinc-400 text-xs font-medium">
        <span>Lead Conversion Rate</span>
        <span class="p-1.5 rounded-lg bg-zinc-800/80 text-[#FEC500]">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
          </svg>
        </span>
      </div>
      <div id="statConversionRate" class="text-3xl font-black text-[#FEC500] tracking-tight">--%</div>
      <div class="text-xs text-zinc-400">
        <span id="statTotalLeads" class="text-white font-semibold">--</span> total consultation leads
      </div>
    </div>

    <!-- Stat 3: Repair Pipeline ($) -->
    <div class="bg-zinc-900/60 border border-zinc-800 p-5 rounded-2xl space-y-2">
      <div class="flex items-center justify-between text-zinc-400 text-xs font-medium">
        <span>Estimated Repair Pipeline</span>
        <span class="p-1.5 rounded-lg bg-zinc-800/80 text-emerald-400">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </span>
      </div>
      <div id="statPipelineUsd" class="text-3xl font-black text-emerald-400 tracking-tight">$--</div>
      <div class="text-xs text-zinc-400">Based on $35/hr repair labor quotes</div>
    </div>

    <!-- Stat 4: Average Score -->
    <div class="bg-zinc-900/60 border border-zinc-800 p-5 rounded-2xl space-y-2">
      <div class="flex items-center justify-between text-zinc-400 text-xs font-medium">
        <span>Average Health Score</span>
        <span class="p-1.5 rounded-lg bg-zinc-800/80 text-purple-400">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 30a1 1 0 000 2h2a1 1 0 000-2h-2z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </span>
      </div>
      <div id="statAvgScore" class="text-3xl font-black text-white tracking-tight">-- / 100</div>
      <div class="text-xs text-zinc-400 flex items-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-amber-400"></span>
        <span>Across all completed audits</span>
      </div>
    </div>
  </div>

  <!-- Debug Console & Real-Time Durable Object Telemetry Panel -->
  <div class="bg-zinc-900/80 border border-zinc-800 rounded-2xl overflow-hidden" id="debugConsolePanel">
    <!-- Header — always visible, click to expand/collapse -->
    <div
      id="debugConsoleHeader"
      class="flex flex-col sm:flex-row sm:items-center justify-between px-5 py-3.5 cursor-pointer hover:bg-zinc-800/30 transition select-none gap-2"
    >
      <div class="flex items-center gap-3">
        <span class="font-mono text-[11px] font-bold text-zinc-300 flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-zinc-500" id="debugStatusDot"></span>
          🖥 Live Durable Object Telemetry
        </span>
        <span id="wsStatusBadge" class="bg-zinc-800 border border-zinc-700 text-zinc-400 text-[10px] font-mono px-2 py-0.5 rounded-full">Connecting...</span>
        <span id="debugEntryBadge" class="bg-zinc-800 border border-zinc-700 text-zinc-500 text-[10px] font-mono px-2 py-0.5 rounded-full">0 events</span>
        <span id="debugErrorBadge" class="hidden bg-rose-950 border border-rose-800 text-rose-400 text-[10px] font-mono px-2 py-0.5 rounded-full font-bold"></span>
      </div>
      <div class="flex items-center gap-2">
        <!-- Category filter buttons -->
        <div class="flex items-center gap-1 font-mono text-[10px]" id="debugFilters">
          <button data-filter="all"   class="debug-filter-btn bg-zinc-700 text-zinc-300 border-zinc-600 px-2 py-0.5 rounded border transition">ALL</button>
          <button data-filter="ai"    class="debug-filter-btn text-purple-400 border-zinc-700 px-2 py-0.5 rounded border transition hover:bg-zinc-800">AI GATEWAY</button>
          <button data-filter="audit" class="debug-filter-btn text-blue-400   border-zinc-700 px-2 py-0.5 rounded border transition hover:bg-zinc-800">AUDIT</button>
          <button data-filter="lead"  class="debug-filter-btn text-[#FEC500] border-zinc-700 px-2 py-0.5 rounded border transition hover:bg-zinc-800">LEADS</button>
          <button data-filter="error" class="debug-filter-btn text-rose-400  border-zinc-700 px-2 py-0.5 rounded border transition hover:bg-zinc-800">ERR</button>
        </div>
        <button id="debugClearBtn" class="text-[10px] font-mono px-2.5 py-0.5 rounded border border-zinc-700 text-zinc-400 hover:text-white hover:bg-zinc-800 transition">
          Clear
        </button>
        <svg id="debugChevron" class="w-4 h-4 text-zinc-500 transform transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
        </svg>
      </div>
    </div>
    <!-- Console body — hidden by default, auto-expands on first error or active event -->
    <div id="debugConsoleBody" class="hidden border-t border-zinc-800">
      <div
        id="debugLogList"
        class="font-mono text-[11px] max-h-96 overflow-y-auto p-3 space-y-1.5 bg-black/80"
      >
        <div class="text-zinc-600 italic py-1">No telemetry events recorded yet — waiting for system activity...</div>
      </div>
    </div>
  </div>

  <!-- Re-audit Quick Trigger Box -->
  <div class="bg-zinc-900/80 border border-zinc-800 p-6 rounded-2xl space-y-4" id="re-audit">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-[#FEC500]"></span>
        <h3 class="text-white font-bold text-base">Trigger Automated Re-audit</h3>
      </div>
      <span class="text-xs text-zinc-400">Enqueues differential re-scan job</span>
    </div>

    <form id="reAuditForm" class="flex flex-col sm:flex-row gap-3">
      <input
        type="text"
        id="reAuditInput"
        placeholder="Enter target URL or existing Audit ID (e.g. https://example.com)"
        required
        class="flex-1 bg-zinc-950 border border-zinc-700 rounded-xl px-4 py-2.5 text-sm text-white placeholder-zinc-500 focus:outline-none focus:border-[#FEC500]"
      />
      <button
        type="submit"
        class="bg-[#FEC500] hover:bg-[#e5b200] text-zinc-950 font-bold px-6 py-2.5 rounded-xl transition shadow-md whitespace-nowrap flex items-center justify-center gap-2"
      >
        <span>Initiate Re-audit</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
        </svg>
      </button>
    </form>
    <div id="reAuditFeedback" class="hidden text-xs px-3 py-2 rounded-lg font-mono"></div>
  </div>

  <!-- Lead Management Section -->
  <div class="bg-zinc-900/80 border border-zinc-800 rounded-2xl p-6 space-y-6" id="leads">
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-4 border-b border-zinc-800">
      <div>
        <h3 class="text-white font-bold text-lg">Consultation Leads & Inquiries</h3>
        <p class="text-zinc-400 text-xs">High-intent client submissions captured directly from audit reports.</p>
      </div>

      <div class="flex items-center gap-2">
        <select
          id="leadFilterService"
          class="bg-zinc-950 border border-zinc-700 text-zinc-300 text-xs rounded-xl px-3 py-2 focus:outline-none focus:border-[#FEC500]"
        >
          <option value="">All Services</option>
          <option value="fix">Fix ($700)</option>
          <option value="rebuild">Rebuild ($2,800)</option>
          <option value="consultation">Consultation ($350)</option>
        </select>
      </div>
    </div>

    <!-- Leads Table -->
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead class="text-zinc-400 bg-zinc-950/60 uppercase font-mono tracking-wider border-b border-zinc-800">
          <tr>
            <th class="py-3 px-4">Contact</th>
            <th class="py-3 px-4">Service</th>
            <th class="py-3 px-4">Target Domain</th>
            <th class="py-3 px-4">Score</th>
            <th class="py-3 px-4">Budget</th>
            <th class="py-3 px-4">Submitted</th>
            <th class="py-3 px-4 text-right">Actions</th>
          </tr>
        </thead>
        <tbody id="leadsTableBody" class="divide-y divide-zinc-800/60 text-zinc-300">
          <tr>
            <td colspan="7" class="py-8 text-center text-zinc-500">Loading audit leads...</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Audit Logs & Raw API Debugger Section -->
  <div class="bg-zinc-900/80 border border-zinc-800 rounded-2xl p-6 space-y-6" id="audit-logs">
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-4 border-b border-zinc-800">
      <div>
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-blue-400"></span>
          <h3 class="text-white font-bold text-lg">Audit Logs & Raw API Debugger</h3>
        </div>
        <p class="text-zinc-400 text-xs">Detailed diagnostic log traces and raw API metrics (PageSpeed, Security Headers, SEO Metadata, Audit Engine timeline).</p>
      </div>

      <div class="flex items-center gap-2 w-full sm:w-auto">
        <input
          type="text"
          id="auditLogSearchInput"
          placeholder="Search Audit ID or URL (e.g. uYYWPGp4zRxg)"
          class="bg-zinc-950 border border-zinc-700 text-zinc-300 text-xs rounded-xl px-3 py-2 focus:outline-none focus:border-[#FEC500] w-full sm:w-64 font-mono"
        />
        <button
          id="fetchAuditLogsBtn"
          class="bg-zinc-800 hover:bg-zinc-700 text-white text-xs font-semibold px-4 py-2 rounded-xl border border-zinc-700 transition whitespace-nowrap"
        >
          Search Logs
        </button>
      </div>
    </div>

    <!-- Audit Logs List Container -->
    <div id="auditLogsContainer" class="space-y-3">
      <div class="py-8 text-center text-zinc-500 font-mono text-xs">Loading diagnostic audit logs...</div>
    </div>

    <!-- Audit Logs Pagination Controls Bar -->
    <div id="auditPaginationContainer" class="hidden flex flex-col sm:flex-row items-center justify-between gap-4 pt-4 border-t border-zinc-800/80 font-mono text-xs">
      <div id="auditPaginationSummary" class="text-zinc-400">
        Showing <span id="auditPageStart" class="text-white font-semibold">0</span>–<span id="auditPageEnd" class="text-white font-semibold">0</span> of <span id="auditPageTotal" class="text-white font-semibold">0</span> audits
      </div>
      <div class="flex items-center gap-2" id="auditPaginationControls">
        <button
          id="auditPrevPageBtn"
          disabled
          class="bg-zinc-950 hover:bg-zinc-800 disabled:opacity-40 disabled:hover:bg-zinc-950 text-zinc-300 px-3 py-1.5 rounded-xl border border-zinc-800 transition flex items-center gap-1.5"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
          Previous
        </button>
        <div id="auditPageNumbers" class="flex items-center gap-1"></div>
        <button
          id="auditNextPageBtn"
          disabled
          class="bg-zinc-950 hover:bg-zinc-800 disabled:opacity-40 disabled:hover:bg-zinc-950 text-zinc-300 px-3 py-1.5 rounded-xl border border-zinc-800 transition flex items-center gap-1.5"
        >
          Next
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  import { validateAuditUrl } from '../lib/url-validator';

  // ─── Real-Time Durable Object Telemetry & Debug Manager ────────────────────
  const DEBUG_MAX_ENTRIES = 200;
  let _telemetryEvents: Array<any> = [];
  let _debugFilter = 'all';
  let _adminWs: WebSocket | null = null;
  let _pingInterval: any = null;
  let _lastPingTime = 0;

  function _debugOpen() {
    document.getElementById('debugConsoleBody')?.classList.remove('hidden');
    document.getElementById('debugChevron')?.classList.add('rotate-180');
  }

  function connectAdminWebSocket() {
    const token = getStoredToken();
    if (!token) return;

    const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
    const wsUrl = `${protocol}//${window.location.host}/api/admin/ws?token=${encodeURIComponent(token)}`;

    const statusBadge = document.getElementById('wsStatusBadge');
    const statusDot = document.getElementById('debugStatusDot');

    if (_adminWs) {
      try { _adminWs.close(); } catch {}
    }

    try {
      _adminWs = new WebSocket(wsUrl);

      _adminWs.onopen = () => {
        if (statusBadge) {
          statusBadge.textContent = '🟢 DO Live WS';
          statusBadge.className = 'bg-emerald-950 border border-emerald-800 text-emerald-400 text-[10px] font-mono px-2 py-0.5 rounded-full font-semibold';
        }
        if (statusDot) statusDot.className = 'w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse';

        adminLog('success', 'WS', 'WebSocket connected to Global Telemetry Durable Object (admin-global-telemetry)');

        // Start ping loop
        if (_pingInterval) clearInterval(_pingInterval);
        _pingInterval = setInterval(() => {
          if (_adminWs?.readyState === WebSocket.OPEN) {
            _lastPingTime = Date.now();
            _adminWs.send(JSON.stringify({ type: 'ping' }));
          }
        }, 15000);
      };

      _adminWs.onmessage = (event) => {
        try {
          const msg = JSON.parse(event.data);
          if (msg.type === 'pong' && _lastPingTime > 0) {
            const rtt = Date.now() - _lastPingTime;
            if (statusBadge) {
              statusBadge.textContent = `🟢 DO Live (${rtt}ms)`;
            }
          } else if (msg.type === 'telemetry' && msg.event) {
            addTelemetryEvent(msg.event);
          } else if (msg.type === 'telemetry_history' && Array.isArray(msg.events)) {
            msg.events.forEach((evt: any) => addTelemetryEvent(evt, false));
            _debugRender();
          }
        } catch {}
      };

      _adminWs.onclose = () => {
        if (statusBadge) {
          statusBadge.textContent = '🔴 WS Disconnected';
          statusBadge.className = 'bg-rose-950 border border-rose-800 text-rose-400 text-[10px] font-mono px-2 py-0.5 rounded-full';
        }
        if (statusDot) statusDot.className = 'w-2.5 h-2.5 rounded-full bg-rose-500';
        if (_pingInterval) clearInterval(_pingInterval);
        // Reconnect after 5 seconds
        setTimeout(() => connectAdminWebSocket(), 5000);
      };

      _adminWs.onerror = () => {
        adminLog('warn', 'WS', 'WebSocket connection error');
      };
    } catch (err: any) {
      adminLog('warn', 'WS', `Failed to open WebSocket: ${err.message}`);
    }
  }

  function addTelemetryEvent(evt: any, shouldRender = true) {
    // Avoid duplicate events if already present
    if (_telemetryEvents.some(e => e.id === evt.id)) return;
    _telemetryEvents.unshift(evt);
    if (_telemetryEvents.length > DEBUG_MAX_ENTRIES) {
      _telemetryEvents.length = DEBUG_MAX_ENTRIES;
    }
    if (evt.category === 'error' && document.getElementById('debugConsoleBody')?.classList.contains('hidden')) {
      _debugOpen();
    }
    _debugUpdateBadges();
    if (shouldRender) _debugRender();
  }

  function _debugRender() {
    const list = document.getElementById('debugLogList');
    if (!list) return;

    const filtered = _debugFilter === 'all'
      ? _telemetryEvents
      : _telemetryEvents.filter(e => e.category === _debugFilter);

    if (filtered.length === 0) {
      list.innerHTML = `<div class="text-zinc-600 italic py-1">No ${_debugFilter === 'all' ? '' : _debugFilter + ' '}telemetry events recorded.</div>`;
      return;
    }

    list.innerHTML = filtered.map(e => {
      const date = new Date(e.timestamp || Date.now());
      const p2 = (n: number) => String(n).padStart(2, '0');
      const ts = `[${p2(date.getHours())}:${p2(date.getMinutes())}:${p2(date.getSeconds())}.${String(date.getMilliseconds()).padStart(3, '0')}]`;

      const catBadge =
        e.category === 'ai'    ? '<span class="px-1.5 py-0.5 rounded text-[9px] font-bold bg-purple-950 text-purple-400 border border-purple-800 uppercase">AI GATEWAY</span>'
      : e.category === 'audit' ? '<span class="px-1.5 py-0.5 rounded text-[9px] font-bold bg-blue-950 text-blue-400 border border-blue-800 uppercase">AUDIT</span>'
      : e.category === 'lead'  ? '<span class="px-1.5 py-0.5 rounded text-[9px] font-bold bg-amber-950 text-[#FEC500] border border-amber-800 uppercase">LEAD</span>'
      : e.category === 'error' ? '<span class="px-1.5 py-0.5 rounded text-[9px] font-bold bg-rose-950 text-rose-400 border border-rose-800 uppercase">ERROR</span>'
      : '<span class="px-1.5 py-0.5 rounded text-[9px] font-bold bg-zinc-800 text-zinc-300 border border-zinc-700 uppercase">SYSTEM</span>';

      const actionColor =
        e.category === 'error' ? 'text-rose-400 font-bold'
      : e.category === 'ai'    ? 'text-purple-300 font-bold'
      : 'text-zinc-200 font-bold';

      const detailsStr = e.details ? JSON.stringify(e.details) : '';
      const hasDetails = Boolean(e.details && Object.keys(e.details).length > 0);

      return `
        <div class="p-2 rounded bg-zinc-950/90 border border-zinc-850 hover:border-zinc-750 transition space-y-1 font-mono text-[11px]">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div class="flex items-center gap-2">
              <span class="text-zinc-500">${ts}</span>
              ${catBadge}
              <span class="${actionColor}">${e.action}</span>
              ${e.url ? `<span class="text-zinc-400 text-[10px]">(${e.url})</span>` : ''}
              ${e.auditId ? `<span class="text-zinc-500 text-[10px]">ID: <strong class="text-zinc-300">${e.auditId}</strong></span>` : ''}
            </div>
            ${hasDetails ? `<span class="text-[10px] text-zinc-500 font-mono">click details below</span>` : ''}
          </div>
          ${hasDetails ? `
            <details class="text-[10px] text-zinc-400 pt-1 border-t border-zinc-900">
              <summary class="cursor-pointer hover:text-zinc-200">🔍 View Event Details JSON</summary>
              <pre class="mt-1 p-2 bg-black/90 rounded text-emerald-400 overflow-x-auto max-h-36">${JSON.stringify(e.details, null, 2)}</pre>
            </details>
          ` : ''}
        </div>
      `;
    }).join('');
  }

  function _debugUpdateBadges() {
    const total = _telemetryEvents.length;
    const errors = _telemetryEvents.filter(e => e.category === 'error').length;
    const badge = document.getElementById('debugEntryBadge');
    const errorBadge = document.getElementById('debugErrorBadge');
    if (badge) badge.textContent = `${total} event${total === 1 ? '' : 's'}`;
    if (errorBadge) {
      if (errors > 0) {
        errorBadge.textContent = `⚠ ${errors} error${errors > 1 ? 's' : ''}`;
        errorBadge.classList.remove('hidden');
      } else {
        errorBadge.classList.add('hidden');
      }
    }
  }

  function adminLog(level: string, tag: string, message: string) {
    const category = level === 'error' ? 'error' : level === 'warn' ? 'system' : 'system';
    addTelemetryEvent({
      id: `client_${Date.now()}_${Math.random().toString(36).substring(2, 6)}`,
      category,
      action: tag,
      details: { message, level },
      timestamp: Date.now(),
    });
  }

  // Wire Debug Console header toggle
  const _debugHeader = document.getElementById('debugConsoleHeader');
  if (_debugHeader) {
    _debugHeader.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('#debugFilters, #debugClearBtn')) return;
      const body    = document.getElementById('debugConsoleBody');
      const chevron = document.getElementById('debugChevron');
      if (body?.classList.contains('hidden')) {
        body.classList.remove('hidden');
        chevron?.classList.add('rotate-180');
      } else {
        body?.classList.add('hidden');
        chevron?.classList.remove('rotate-180');
      }
    });
  }

  // Wire category filter buttons
  document.querySelectorAll('.debug-filter-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      _debugFilter = (btn as HTMLElement).dataset.filter || 'all';
      document.querySelectorAll('.debug-filter-btn').forEach(b => {
        b.classList.remove('bg-zinc-700', 'text-zinc-300', 'border-zinc-600');
        b.classList.add('border-zinc-700');
      });
      btn.classList.add('bg-zinc-700', 'text-zinc-300', 'border-zinc-600');
      btn.classList.remove('border-zinc-700');
      _debugRender();
    });
  });

  // Wire Clear button
  document.getElementById('debugClearBtn')?.addEventListener('click', (e) => {
    e.stopPropagation();
    _telemetryEvents = [];
    _debugFilter = 'all';
    document.querySelectorAll('.debug-filter-btn').forEach(b => {
      b.classList.remove('bg-zinc-700', 'text-zinc-300', 'border-zinc-600');
      b.classList.add('border-zinc-700');
    });
    const allBtn = document.querySelector('.debug-filter-btn[data-filter="all"]');
    if (allBtn) {
      allBtn.classList.add('bg-zinc-700', 'text-zinc-300', 'border-zinc-600');
      allBtn.classList.remove('border-zinc-700');
    }
    _debugUpdateBadges();
    _debugRender();
  });

  // ─── Admin Helpers ────────────────────────────────────────────────────────
  function getStoredToken(): string {
    return localStorage.getItem('workouse_admin_token') || '';
  }

  function getStoredEmail(): string {
    return localStorage.getItem('workouse_admin_email') || 'admin@workouse.com';
  }

  function handleUnauthorized() {
    adminLog('warn', 'AUTH', 'handleUnauthorized() called — clearing session, dispatching logout event');
    localStorage.removeItem('workouse_admin_token');
    localStorage.removeItem('workouse_admin_email');
    window.dispatchEvent(new CustomEvent('admin-logout'));
  }

  const refreshBtn = document.getElementById('refreshAnalyticsBtn');
  const logoutBtn = document.getElementById('adminLogoutBtn');
  const userEmailDisplay = document.getElementById('adminUserEmailDisplay');
  const reAuditForm = document.getElementById('reAuditForm') as HTMLFormElement | null;
  const reAuditInput = document.getElementById('reAuditInput') as HTMLInputElement | null;
  const reAuditFeedback = document.getElementById('reAuditFeedback');
  const leadFilterService = document.getElementById('leadFilterService') as HTMLSelectElement | null;
  const auditLogSearchInput = document.getElementById('auditLogSearchInput') as HTMLInputElement | null;
  const fetchAuditLogsBtn = document.getElementById('fetchAuditLogsBtn');

  if (userEmailDisplay) {
    userEmailDisplay.innerText = getStoredEmail();
  }

  if (logoutBtn) {
    logoutBtn.addEventListener('click', () => {
      handleUnauthorized();
    });
  }

  if (refreshBtn) {
    refreshBtn.addEventListener('click', () => loadAdminData());
  }

  if (leadFilterService) {
    leadFilterService.addEventListener('change', () => fetchLeads(getStoredToken()));
  }

  if (fetchAuditLogsBtn) {
    fetchAuditLogsBtn.addEventListener('click', () => {
      const token = getStoredToken();
      const q = auditLogSearchInput ? auditLogSearchInput.value.trim() : '';
      fetchAuditLogs(token, q, 1);
    });
  }

  if (auditLogSearchInput) {
    auditLogSearchInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        const token = getStoredToken();
        fetchAuditLogs(token, auditLogSearchInput.value.trim(), 1);
      }
    });
  }

  async function loadAdminData() {
    const token = getStoredToken();
    if (!token) {
      adminLog('warn', 'INIT', 'No token in localStorage — redirecting to login');
      handleUnauthorized();
      return;
    }
    adminLog('info', 'INIT', 'Token present — establishing DO WebSocket telemetry & firing REST fetches');
    connectAdminWebSocket();
    await Promise.all([fetchAnalytics(token), fetchLeads(token), fetchAuditLogs(token)]);
    adminLog('success', 'INIT', 'All admin data fetches complete');
  }

  async function fetchAnalytics(token: string) {
    adminLog('info', 'ANALYTICS', 'GET /api/admin/analytics → pending');
    try {
      const res = await fetch('/api/admin/analytics', {
        headers: { Authorization: `Bearer ${token}` },
      });

      if (res.status === 401 || res.status === 403) {
        adminLog('warn', 'ANALYTICS', `${res.status} ${res.statusText} — session expired`);
        handleUnauthorized();
        return;
      }

      const data: any = await res.json();
      if (res.ok && data.success) {
        const { analytics } = data;
        adminLog('success', 'ANALYTICS', `200 OK — totalAudits: ${analytics.totalAudits}, leads: ${analytics.totalLeads}, avgScore: ${analytics.avgScore}`);
        (document.getElementById('statTotalAudits') as HTMLElement).innerText = analytics.totalAudits.toString();
        (document.getElementById('statCompletedAudits') as HTMLElement).innerText = `${analytics.completedAudits} completed`;
        (document.getElementById('statFailedAudits') as HTMLElement).innerText = `${analytics.failedAudits} failed`;
        (document.getElementById('statConversionRate') as HTMLElement).innerText = `${analytics.conversionRatePct}%`;
        (document.getElementById('statTotalLeads') as HTMLElement).innerText = analytics.totalLeads.toString();
        (document.getElementById('statPipelineUsd') as HTMLElement).innerText = `$${analytics.totalPipelineValueUsd.toLocaleString()}`;
        (document.getElementById('statAvgScore') as HTMLElement).innerText = `${analytics.avgScore} / 100`;
      } else {
        adminLog('error', 'ANALYTICS', `${res.status} ${res.statusText} — ${data?.error || 'unexpected response shape'}`);
      }
    } catch (err: any) {
      adminLog('error', 'ANALYTICS', `Network error — ${err.message}`);
    }
  }

  async function fetchLeads(token: string) {
    const tbody = document.getElementById('leadsTableBody');
    if (!tbody) return;

    const filterVal = leadFilterService ? leadFilterService.value : '';
    const url = filterVal ? `/api/admin/leads?serviceType=${filterVal}` : '/api/admin/leads';
    adminLog('info', 'LEADS', `GET ${url} → pending`);

    try {
      const res = await fetch(url, {
        headers: { Authorization: `Bearer ${token}` },
      });

      if (res.status === 401 || res.status === 403) {
        adminLog('warn', 'LEADS', `${res.status} ${res.statusText} — session expired`);
        handleUnauthorized();
        return;
      }

      const data: any = await res.json();

      if (res.ok && data.success && data.leads) {
        adminLog('success', 'LEADS', `200 OK — ${data.leads.length} lead(s) loaded`);
        if (data.leads.length === 0) {
          tbody.innerHTML = `<tr><td colspan="7" class="py-8 text-center text-zinc-500">No leads recorded yet.</td></tr>`;
          return;
        }

        tbody.innerHTML = data.leads
          .map((lead: any) => {
            const dateStr = new Date(lead.created_at * 1000).toLocaleDateString();
            const badgeClass =
              lead.service_type === 'rebuild'
                ? 'bg-amber-950/80 text-amber-400 border-amber-800/60'
                : lead.service_type === 'fix'
                ? 'bg-blue-950/80 text-blue-400 border-blue-800/60'
                : 'bg-zinc-800 text-zinc-300 border-zinc-700';

            return `
              <tr class="hover:bg-zinc-850/50 transition">
                <td class="py-3.5 px-4 font-semibold text-white">
                  <div>${lead.name}</div>
                  <div class="text-zinc-400 text-[11px] font-normal">${lead.email}</div>
                </td>
                <td class="py-3.5 px-4">
                  <span class="px-2.5 py-1 rounded-full text-[10px] font-bold border uppercase tracking-wider ${badgeClass}">
                    ${lead.service_type}
                  </span>
                </td>
                <td class="py-3.5 px-4 font-mono text-zinc-300 text-[11px]">
                  <a href="/audit/${lead.audit_id}" target="_blank" class="hover:text-[#FEC500] underline">
                    ${lead.url || lead.audit_id}
                  </a>
                </td>
                <td class="py-3.5 px-4 font-mono font-bold">
                  <span class="${(lead.score || 0) >= 70 ? 'text-emerald-400' : 'text-amber-400'}">
                    ${lead.score || '--'}
                  </span>
                </td>
                <td class="py-3.5 px-4 font-mono text-zinc-400">${lead.budget || 'N/A'}</td>
                <td class="py-3.5 px-4 text-zinc-400">${dateStr}</td>
                <td class="py-3.5 px-4 text-right">
                  <a
                    href="/audit/${lead.audit_id}"
                    target="_blank"
                    class="bg-zinc-800 hover:bg-zinc-700 text-white px-2.5 py-1 rounded-lg text-[11px] font-medium transition inline-block"
                  >
                    View Audit
                  </a>
                </td>
              </tr>
            `;
          })
          .join('');
      } else {
        adminLog('error', 'LEADS', `${res.status} ${res.statusText} — ${data?.error || 'unexpected response'}`);
      }
    } catch (err: any) {
      adminLog('error', 'LEADS', `Network error — ${err.message}`);
    }
  }

  // ─── Pagination & Audit Logs State ─────────────────────────────────────────
  let _currentAuditPage = 1;
  let _totalAuditPages = 1;
  let _totalAuditCount = 0;
  let _currentAuditSearch = '';
  const _auditLimit = 10;

  async function fetchAuditLogs(token: string, searchQuery: string = '', page: number = 1) {
    const container = document.getElementById('auditLogsContainer');
    const paginationContainer = document.getElementById('auditPaginationContainer');
    if (!container) return;

    _currentAuditPage = page;
    _currentAuditSearch = searchQuery;

    const url = `/api/admin/audit-logs?page=${page}&limit=${_auditLimit}${searchQuery ? `&search=${encodeURIComponent(searchQuery)}` : ''}`;
    adminLog('info', 'AUDIT-LOGS', `GET ${url} → pending`);

    try {
      const res = await fetch(url, {
        headers: { Authorization: `Bearer ${token}` },
      });

      if (res.status === 401 || res.status === 403) {
        adminLog('warn', 'AUDIT-LOGS', `${res.status} ${res.statusText} — session expired`);
        handleUnauthorized();
        return;
      }

      const data: any = await res.json();

      if (res.ok && data.success && data.logs) {
        _totalAuditCount = data.totalCount || data.logs.length;
        _totalAuditPages = data.totalPages || Math.ceil(_totalAuditCount / _auditLimit) || 1;
        _currentAuditPage = data.page || page;

        adminLog('success', 'AUDIT-LOGS', `200 OK — page ${_currentAuditPage}/${_totalAuditPages} (${data.logs.length} records, total ${_totalAuditCount})`);

        if (data.logs.length === 0) {
          container.innerHTML = `<div class="py-12 text-center text-zinc-500 font-mono text-xs">No audit logs matching search standard.</div>`;
          if (paginationContainer) paginationContainer.classList.add('hidden');
          return;
        }

        container.innerHTML = data.logs
          .map((item: any) => {
            const { audit, aiOutput, rawResults, auditLogs } = item;
            const createdDate = new Date(audit.createdAt * 1000).toLocaleString();
            const score = aiOutput?.score ?? '--';
            const cardId = `audit_details_${audit.id}`;

            const statusClass =
              audit.status === 'complete' ? 'bg-emerald-950/80 text-emerald-400 border-emerald-800/60'
              : audit.status === 'failed' ? 'bg-rose-950/80 text-rose-400 border-rose-800/60'
              : 'bg-amber-950/80 text-amber-400 border-amber-800/60';

            const scoreClass =
              typeof score === 'number'
                ? score >= 70
                  ? 'text-emerald-400 bg-emerald-950/50 border-emerald-800/50'
                  : score >= 50
                  ? 'text-amber-400 bg-amber-950/50 border-amber-800/50'
                  : 'text-rose-400 bg-rose-950/50 border-rose-800/50'
                : 'text-zinc-400 bg-zinc-900 border-zinc-800';

            return `
              <div class="bg-zinc-950 border border-zinc-800 hover:border-zinc-700/80 rounded-xl transition overflow-hidden font-mono text-xs" id="audit_row_${audit.id}">
                <!-- Compact Row (Summary) -->
                <div class="p-3.5 flex flex-col lg:flex-row lg:items-center justify-between gap-3 bg-zinc-950/90">
                  <!-- URL, Email & Status -->
                  <div class="flex flex-wrap items-center gap-2.5 min-w-0 flex-1">
                    <button
                      type="button"
                      data-target="${cardId}"
                      class="btn-toggle-accordion text-left font-bold text-white hover:text-[#FEC500] transition flex items-center gap-1.5 truncate max-w-md group"
                      title="Click to expand/collapse details"
                    >
                      <svg class="chevron-icon w-4 h-4 text-zinc-500 group-hover:text-[#FEC500] transform transition-transform duration-200 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                      </svg>
                      <span class="truncate">${audit.url}</span>
                    </button>

                    <a href="${audit.url.startsWith('http') ? audit.url : `https://${audit.url}`}" target="_blank" rel="noopener noreferrer" class="text-zinc-500 hover:text-zinc-300 transition shrink-0" title="Open website in new tab">
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                      </svg>
                    </a>

                    <!-- Reporter Email Badge -->
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-zinc-900 border border-zinc-800 text-zinc-300 text-[11px] font-normal" title="Reporter Email">
                      <svg class="w-3 h-3 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                      </svg>
                      <span>${audit.email}</span>
                    </span>

                    <!-- Status Badge -->
                    <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase border ${statusClass}">

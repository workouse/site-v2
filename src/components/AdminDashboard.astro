  // ─── Admin Helpers ────────────────────────────────────────────────────────
  function getStoredToken(): string {
    return localStorage.getItem('workouse_admin_token') || '';
  }

  function getStoredEmail(): string {
    return localStorage.getItem('workouse_admin_email') || 'admin@workouse.com';
  }

  function handleUnauthorized() {
    adminLog('warn', 'AUTH', 'handleUnauthorized() called — clearing session, dispatching logout event');
    localStorage.removeItem('workouse_admin_token');
    localStorage.removeItem('workouse_admin_email');
    window.dispatchEvent(new CustomEvent('admin-logout'));
  }

  const refreshBtn = document.getElementById('refreshAnalyticsBtn');
  const logoutBtn = document.getElementById('adminLogoutBtn');
  const userEmailDisplay = document.getElementById('adminUserEmailDisplay');
  const reAuditForm = document.getElementById('reAuditForm') as HTMLFormElement | null;
  const reAuditInput = document.getElementById('reAuditInput') as HTMLInputElement | null;
  const reAuditFeedback = document.getElementById('reAuditFeedback');
  const leadFilterService = document.getElementById('leadFilterService') as HTMLSelectElement | null;
  const auditLogSearchInput = document.getElementById('auditLogSearchInput') as HTMLInputElement | null;
  const fetchAuditLogsBtn = document.getElementById('fetchAuditLogsBtn');

  if (userEmailDisplay) {
    userEmailDisplay.innerText = getStoredEmail();
  }

  if (logoutBtn) {
    logoutBtn.addEventListener('click', () => {
      handleUnauthorized();
    });
  }

  if (refreshBtn) {
    refreshBtn.addEventListener('click', () => loadAdminData());
  }

  if (leadFilterService) {
    leadFilterService.addEventListener('change', () => fetchLeads(getStoredToken()));
  }

  if (fetchAuditLogsBtn) {
    fetchAuditLogsBtn.addEventListener('click', () => {
      const token = getStoredToken();
      const q = auditLogSearchInput ? auditLogSearchInput.value.trim() : '';
      fetchAuditLogs(token, q);
    });
  }

  if (auditLogSearchInput) {
    auditLogSearchInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        const token = getStoredToken();
        fetchAuditLogs(token, auditLogSearchInput.value.trim());
      }
    });
  }

  async function loadAdminData() {
    const token = getStoredToken();
    if (!token) {
      adminLog('warn', 'INIT', 'No token in localStorage — redirecting to login');
      handleUnauthorized();
      return;
    }
    adminLog('info', 'INIT', 'Token present — establishing DO WebSocket telemetry & firing REST fetches');
    connectAdminWebSocket();
    await Promise.all([fetchAnalytics(token), fetchLeads(token), fetchAuditLogs(token)]);
    adminLog('success', 'INIT', 'All admin data fetches complete');
  }

  async function fetchAnalytics(token: string) {
    adminLog('info', 'ANALYTICS', 'GET /api/admin/analytics → pending');
    try {
      const res = await fetch('/api/admin/analytics', {
        headers: { Authorization: `Bearer ${token}` },
      });

      if (res.status === 401 || res.status === 403) {
        adminLog('warn', 'ANALYTICS', `${res.status} ${res.statusText} — session expired`);
        handleUnauthorized();
        return;
      }

      const data: any = await res.json();
      if (res.ok && data.success) {
        const { analytics } = data;
        adminLog('success', 'ANALYTICS', `200 OK — totalAudits: ${analytics.totalAudits}, leads: ${analytics.totalLeads}, avgScore: ${analytics.avgScore}`);
        (document.getElementById('statTotalAudits') as HTMLElement).innerText = analytics.totalAudits.toString();
        (document.getElementById('statCompletedAudits') as HTMLElement).innerText = `${analytics.completedAudits} completed`;
        (document.getElementById('statFailedAudits') as HTMLElement).innerText = `${analytics.failedAudits} failed`;
        (document.getElementById('statConversionRate') as HTMLElement).innerText = `${analytics.conversionRatePct}%`;
        (document.getElementById('statTotalLeads') as HTMLElement).innerText = analytics.totalLeads.toString();
        (document.getElementById('statPipelineUsd') as HTMLElement).innerText = `$${analytics.totalPipelineValueUsd.toLocaleString()}`;
        (document.getElementById('statAvgScore') as HTMLElement).innerText = `${analytics.avgScore} / 100`;
      } else {
        adminLog('error', 'ANALYTICS', `${res.status} ${res.statusText} — ${data?.error || 'unexpected response shape'}`);
      }
    } catch (err: any) {
      adminLog('error', 'ANALYTICS', `Network error — ${err.message}`);
    }
  }

  async function fetchLeads(token: string) {
    const tbody = document.getElementById('leadsTableBody');
    if (!tbody) return;

    const filterVal = leadFilterService ? leadFilterService.value : '';
    const url = filterVal ? `/api/admin/leads?serviceType=${filterVal}` : '/api/admin/leads';
    adminLog('info', 'LEADS', `GET ${url} → pending`);

    try {
      const res = await fetch(url, {
        headers: { Authorization: `Bearer ${token}` },
      });

      if (res.status === 401 || res.status === 403) {
        adminLog('warn', 'LEADS', `${res.status} ${res.statusText} — session expired`);
        handleUnauthorized();
        return;
      }

      const data: any = await res.json();

      if (res.ok && data.success && data.leads) {
        adminLog('success', 'LEADS', `200 OK — ${data.leads.length} lead(s) loaded`);
        if (data.leads.length === 0) {
          tbody.innerHTML = `<tr><td colspan="7" class="py-8 text-center text-zinc-500">No leads recorded yet.</td></tr>`;
          return;
        }

        tbody.innerHTML = data.leads
          .map((lead: any) => {
            const dateStr = new Date(lead.created_at * 1000).toLocaleDateString();
            const badgeClass =
              lead.service_type === 'rebuild'
                ? 'bg-amber-950/80 text-amber-400 border-amber-800/60'
                : lead.service_type === 'fix'
                ? 'bg-blue-950/80 text-blue-400 border-blue-800/60'
                : 'bg-zinc-800 text-zinc-300 border-zinc-700';

            return `
              <tr class="hover:bg-zinc-850/50 transition">
                <td class="py-3.5 px-4 font-semibold text-white">
                  <div>${lead.name}</div>
                  <div class="text-zinc-400 text-[11px] font-normal">${lead.email}</div>
                </td>
                <td class="py-3.5 px-4">
                  <span class="px-2.5 py-1 rounded-full text-[10px] font-bold border uppercase tracking-wider ${badgeClass}">
                    ${lead.service_type}
                  </span>
                </td>
                <td class="py-3.5 px-4 font-mono text-zinc-300 text-[11px]">
                  <a href="/audit/${lead.audit_id}" target="_blank" class="hover:text-[#FEC500] underline">
                    ${lead.url || lead.audit_id}
                  </a>
                </td>
                <td class="py-3.5 px-4 font-mono font-bold">
                  <span class="${(lead.score || 0) >= 70 ? 'text-emerald-400' : 'text-amber-400'}">
                    ${lead.score || '--'}
                  </span>
                </td>
                <td class="py-3.5 px-4 font-mono text-zinc-400">${lead.budget || 'N/A'}</td>
                <td class="py-3.5 px-4 text-zinc-400">${dateStr}</td>
                <td class="py-3.5 px-4 text-right">
                  <a
                    href="/audit/${lead.audit_id}"
                    target="_blank"
                    class="bg-zinc-800 hover:bg-zinc-700 text-white px-2.5 py-1 rounded-lg text-[11px] font-medium transition inline-block"
                  >
                    View Audit
                  </a>
                </td>
              </tr>
            `;
          })
          .join('');
      } else {
        adminLog('error', 'LEADS', `${res.status} ${res.statusText} — ${data?.error || 'unexpected response'}`);
      }
    } catch (err: any) {
      adminLog('error', 'LEADS', `Network error — ${err.message}`);
    }
  }


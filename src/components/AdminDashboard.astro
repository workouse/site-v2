                  <!-- Meta summary banner -->
                  <div class="bg-zinc-950/80 border border-zinc-850 rounded-lg p-3 flex flex-wrap items-center justify-between gap-2 text-[11px] text-zinc-400">
                    <div>
                      <span>Audit ID: <strong class="text-zinc-200">${audit.id}</strong></span>
                      <span class="mx-2">•</span>
                      <span>Target: <strong class="text-zinc-200">${audit.url}</strong></span>
                      <span class="mx-2">•</span>
                      <span>Reporter: <strong class="text-zinc-200">${audit.email}</strong></span>
                    </div>
                    <div>
                      <span>Created: ${createdDate}</span>
                      ${audit.completedAt ? `<span class="mx-2">•</span><span>Completed: ${new Date(audit.completedAt * 1000).toLocaleString()}</span>` : ''}
                    </div>
                  </div>

                  <!-- Raw Diagnostics Grid (PageSpeed, Security, SEO) -->
                  <div class="grid grid-cols-1 md:grid-cols-3 gap-3">

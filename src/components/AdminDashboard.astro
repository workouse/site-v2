  const _debugHeader = document.getElementById('debugConsoleHeader');
  if (_debugHeader) {
    _debugHeader.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('#debugFilters, #debugClearBtn')) return;
      const body    = document.getElementById('debugConsoleBody');
      const chevron = document.getElementById('debugChevron');
      if (body?.classList.contains('hidden')) {
        body.classList.remove('hidden');
        chevron?.classList.add('rotate-180');
      } else {
        body?.classList.add('hidden');
        chevron?.classList.remove('rotate-180');
      }
    });
  }

  // Wire category filter buttons
  document.querySelectorAll('.debug-filter-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      _debugFilter = (btn as HTMLElement).dataset.filter || 'all';
      document.querySelectorAll('.debug-filter-btn').forEach(b => {
        b.classList.remove('bg-zinc-700', 'text-zinc-300', 'border-zinc-600');
        b.classList.add('border-zinc-700');
      });
      btn.classList.add('bg-zinc-700', 'text-zinc-300', 'border-zinc-600');
      btn.classList.remove('border-zinc-700');
      _debugRender();
    });
  });

  // Wire Clear button
  document.getElementById('debugClearBtn')?.addEventListener('click', (e) => {
    e.stopPropagation();
    _telemetryEvents = [];
    _debugFilter = 'all';
    document.querySelectorAll('.debug-filter-btn').forEach(b => {
      b.classList.remove('bg-zinc-700', 'text-zinc-300', 'border-zinc-600');
      b.classList.add('border-zinc-700');
    });
    const allBtn = document.querySelector('.debug-filter-btn[data-filter="all"]');
    if (allBtn) {
      allBtn.classList.add('bg-zinc-700', 'text-zinc-300', 'border-zinc-600');
      allBtn.classList.remove('border-zinc-700');

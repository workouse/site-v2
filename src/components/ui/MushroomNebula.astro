---
/**
 * MushroomNebula — decorative editorial studio signature illustration
 * (lilac/indigo mushroom with pigment ribbons and an amber dot), displayed
 * alongside the "The people behind the engineering." heading.
 * Not the Workouse logo; strictly decorative (aria-hidden, non-focusable, no title).
 */
export type MushroomNebulaSize = 'responsive' | 'desktop' | 'mobile';

export interface Props {
  size?: MushroomNebulaSize;
  class?: string;
  id?: string;
  style?: string;
  [key: `data-${string}`]: unknown;
}

const {
  size = 'responsive',
  class: className,
  ...rawRest
} = Astro.props;

// Decorative-only contract: strip any accidentally passed naming/focus attributes.
const rest = { ...rawRest } as Record<string, unknown>;
delete rest.title;
delete rest['aria-label'];
delete rest['aria-labelledby'];
delete rest['aria-hidden'];
delete rest.focusable;
delete rest.role;

const intrinsicWidth = size === 'mobile' ? 100 : 140;
const intrinsicHeight = size === 'mobile' ? 89 : 124;

const classes = ['wo-mushroom-nebula', `wo-mushroom-nebula--${size}`, className]
  .filter(Boolean)
  .join(' ');
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 180 160"
  width={intrinsicWidth}
  height={intrinsicHeight}
  preserveAspectRatio="xMidYMid meet"
  fill="none"
  class={classes}
  {...rest}
  aria-hidden="true"
  focusable="false"
>
  <g transform="translate(71 37)" data-part="pigment-ribbons">
    <path
      d="M0 35C13 19 29 28 43 20C56 13 55 2 73 0C61 5 64 18 49 26C37 33 22 29 14 39L0 35Z"

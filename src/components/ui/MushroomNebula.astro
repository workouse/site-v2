<style>
  .wo-mushroom-nebula {
    display: block;
    flex-shrink: 0;
    overflow: visible;
    pointer-events: none;
    user-select: none;
  }

  .wo-mushroom-nebula--responsive,
  .wo-mushroom-nebula--mobile {
    width: 100px;
    height: 89px;
  }

  .wo-mushroom-nebula--desktop {
    width: 140px;
    height: 124px;
  }

  @media (min-width: 768px) {
    .wo-mushroom-nebula--responsive:not([data-preview-viewport='390']) {
      width: 140px;
      height: 124px;
    }
  }

  .wo-mushroom-nebula--responsive[data-preview-viewport='768'],
  .wo-mushroom-nebula--responsive[data-preview-viewport='1440'] {
    width: 140px;
    height: 124px;
  }
</style>

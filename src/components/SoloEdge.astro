---
---

<section id="engineer" class="py-24 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto border-t border-zinc-200 dark:border-zinc-900 scroll-mt-16 transition-colors duration-300">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
    
    <!-- Left Column: Narrative Pitch -->
    <div class="lg:col-span-7 space-y-6">
      <div class="flex items-center gap-3">
        <span class="text-xs font-mono font-bold tracking-widest text-brand-blue dark:text-brand-yellow uppercase">The Solo Edge</span>
        <span class="h-[1px] w-12 bg-zinc-300 dark:bg-zinc-800"></span>
      </div>
      
      <h2 class="font-display text-3xl sm:text-4xl font-bold tracking-tight text-zinc-950 dark:text-white leading-tight">
        Direct Access to a Senior Architect. <br />
        <span class="text-zinc-600 dark:text-zinc-400">Skip the Agency Overhead.</span>
      </h2>

      <div class="space-y-4 text-zinc-600 dark:text-zinc-400 font-sans text-base sm:text-lg leading-relaxed">
        <p>
          I am <span class="text-zinc-950 dark:text-zinc-100 font-semibold">Emre Yılmaz</span>, founder of Workouse. I work directly with founders and product leaders to design, build, and deploy high-performance applications. 
        </p>
        <p>
          When you hire an agency, you pay for sales cycles, account managers, and junior developers learning on your dime. At Workouse, you get a senior software architect with over 15 years of industry experience. I bridge the gap between robust backend systems and modern frontend details.
        </p>
      </div>

      <!-- Stats Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-6">
        <div class="glow-card p-5 rounded-2xl">
          <div class="font-display text-3xl sm:text-4xl font-bold text-brand-blue dark:text-brand-yellow">15+</div>
          <div class="text-xs font-mono tracking-wider text-zinc-600 dark:text-zinc-500 uppercase mt-1">Years Experience</div>
        </div>
        <div class="glow-card p-5 rounded-2xl">
          <div class="font-display text-3xl sm:text-4xl font-bold text-brand-blue dark:text-brand-yellow">Millions</div>
          <div class="text-xs font-mono tracking-wider text-zinc-600 dark:text-zinc-500 uppercase mt-1">Requests Handled</div>
        </div>
        <div class="glow-card p-5 rounded-2xl">
          <div class="font-display text-3xl sm:text-4xl font-bold text-brand-blue dark:text-brand-yellow">US & EU</div>
          <div class="text-xs font-mono tracking-wider text-zinc-600 dark:text-zinc-500 uppercase mt-1">Market Focused</div>
        </div>
      </div>
    </div>

    <!-- Right Column: Visual Terminal Code Mockup -->
    <div class="lg:col-span-5 w-full">
      <div class="w-full rounded-2xl border border-zinc-300 dark:border-zinc-800/80 bg-zinc-900 overflow-hidden shadow-xl dark:shadow-2xl relative">
        <!-- Terminal Header -->
        <div class="bg-zinc-950/80 px-4 py-3 flex items-center justify-between border-b border-zinc-800/80">
          <div class="flex items-center gap-1.5">
            <span class="w-3 h-3 rounded-full bg-zinc-800"></span>
            <span class="w-3 h-3 rounded-full bg-zinc-800"></span>
            <span class="w-3 h-3 rounded-full bg-zinc-800"></span>
          </div>
          <span class="text-[10px] font-mono text-zinc-400 tracking-wider">architect.ts</span>
          <div class="w-10"></div> <!-- spacing balance -->
        </div>

        <!-- Terminal Content -->
        <div class="p-6 font-mono text-[11px] sm:text-xs leading-relaxed text-zinc-300 overflow-x-auto whitespace-pre">
<span class="text-brand-yellow">const</span> architect <span class="text-white">=</span> &#123;
  name: <span class="text-emerald-400">"Emre Yılmaz"</span>,
  title: <span class="text-emerald-400">"Senior Fullstack Architect"</span>,
  experience: <span class="text-emerald-400">"15+ Years"</span>,
  focusAreas: [
    <span class="text-emerald-400">"PHP / Symfony & Node.js"</span>,
    <span class="text-emerald-400">"Haskell & Nix Deployments"</span>,
    <span class="text-emerald-400">"DevOps, AWS & Cloudflare"</span>
  ],
  bridgeGap: () =&gt; &#123;
    <span class="text-zinc-500">// Connect Infrastructure to Interface</span>
    <span class="text-brand-yellow">return</span> <span class="text-brand-yellow">new</span> System(&#123;
      backend: <span class="text-zinc-100">"Symfony, Express.js, Haskell"</span>,
      frontend: <span class="text-zinc-100">"Astro.js & TypeScript UIs"</span>,
      infra: <span class="text-zinc-100">"Nix, AWS, Cloudflare Pages"</span>
    &#125;);
  &#125;
&#125;;

<span class="text-zinc-500">// Initiating bootstrap sequence...</span>
<span class="text-brand-yellow">await</span> architect.bridgeGap().deploy(&#123;
  monitoring: <span class="text-brand-yellow">true</span>,
  sla: <span class="text-emerald-400">"99.99%"</span>,
  agencyOverhead: <span class="text-brand-yellow">false</span>
&#125;);</div>
      </div>
    </div>

  </div>
</section>

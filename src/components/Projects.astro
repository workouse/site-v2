                </div>
                <span class="text-[6.5px] font-mono font-bold text-zinc-400 shrink-0">120 TL</span>
              </div>

              <div class="flex justify-between items-center bg-zinc-950/50 border border-zinc-850 p-1 rounded">
                <div class="flex items-center gap-1 min-w-0">
                  <span class="text-[7px]">🍟</span>
                  <div class="min-w-0">
                    <div class="text-[6.5px] font-bold text-zinc-200 truncate">Truffle Fries</div>
                  </div>
                </div>
                <span class="text-[6.5px] font-mono font-bold text-zinc-400 shrink-0">60 TL</span>

---
---

<section id="projects" class="py-24 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto border-t border-zinc-900 scroll-mt-16">
  <!-- Section Title -->
  <div class="text-center max-w-2xl mx-auto mb-16 space-y-3">
    <div class="inline-flex items-center gap-3">
      <span class="text-xs font-mono font-bold tracking-widest text-brand-yellow uppercase">Projects</span>
      <span class="h-[1px] w-8 bg-zinc-800"></span>
    </div>
    <h2 class="font-display text-3xl sm:text-4xl font-bold tracking-tight text-white">
      SaaS & Mobile Products
    </h2>
    <p class="text-sm sm:text-base text-zinc-400">
      Production-grade platforms built with performance, security, and exceptional user experience.
    </p>
  </div>

  <!-- Cards Grid (4 columns) -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
    
    <!-- Card 1: 100m.workouse.com -->
    <div class="glow-card p-6 rounded-3xl flex flex-col justify-between group">
      <div class="space-y-6">
        <!-- Header Info -->
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-[9px] font-mono font-bold uppercase tracking-wider text-brand-yellow px-2 rounded-full bg-brand-yellow/10 border border-brand-yellow/20">
              SaaS & Mobile
            </span>
            <span class="text-[9px] font-mono text-zinc-500">100m.workouse.com</span>
          </div>
          <h3 class="font-display text-xl font-bold text-white tracking-wide">
            100m Social Room
          </h3>
          <p class="text-xs text-zinc-400 leading-relaxed font-sans min-h-[80px]">
            Location-verified social networking for physical venues. Check in securely via GPS/QR, see who is in the same room, and connect while keeping your privacy completely protected.
          </p>
        </div>

        <!-- Interactive CSS Mockup: Location Social App -->
        <div class="relative w-full aspect-[4/3] rounded-2xl bg-zinc-950/80 border border-zinc-900 overflow-hidden flex items-center justify-center p-3">
          <!-- Ambient glowing backgrounds inside the mockup -->
          <div class="absolute -top-12 -left-12 w-20 h-20 bg-indigo-500/10 rounded-full blur-xl"></div>
          <div class="absolute -bottom-12 -right-12 w-20 h-20 bg-brand-yellow/10 rounded-full blur-xl"></div>

          <!-- Phone mockup viewport -->
          <div class="w-full max-w-[170px] h-[130px] bg-zinc-900 border border-zinc-800 rounded-2xl p-2 shadow-2xl flex flex-col justify-between relative text-left">
            <!-- Top bar -->
            <div class="flex items-center justify-between border-b border-zinc-800/80 pb-1 mb-1">
              <div class="flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-green-500 animate-ping"></span>
                <span class="text-[7px] font-mono text-zinc-300 font-bold">100m Room</span>
              </div>
              <span class="text-[6px] text-zinc-500 font-mono">Kadıköy Cafe</span>
            </div>

            <!-- Active check-in card -->
            <div class="flex-grow space-y-1 overflow-hidden">
              <div class="p-1 rounded bg-zinc-950 border border-zinc-800/60 flex items-center gap-1.5">
                <div class="w-5 h-5 rounded-full bg-gradient-to-tr from-brand-yellow/20 to-indigo-500/20 border border-zinc-700 flex items-center justify-center text-[8px] text-indigo-300 font-bold shrink-0">
                  EY
                </div>
                <div class="min-w-0">
                  <div class="text-[7.5px] font-bold text-zinc-200 truncate">Emre Yılmaz</div>
                  <div class="text-[5.5px] text-zinc-500 font-mono truncate">Checked-in • 4m ago</div>
                </div>
              </div>

              <!-- Other users list teaser -->
              <div class="flex items-center gap-1 px-0.5 pt-0.5">
                <div class="flex -space-x-1">
                  <div class="w-3.5 h-3.5 rounded-full bg-zinc-800 border border-zinc-900 flex items-center justify-center text-[4px] text-zinc-400 font-bold">A</div>
                  <div class="w-3.5 h-3.5 rounded-full bg-zinc-800 border border-zinc-900 flex items-center justify-center text-[4px] text-zinc-400 font-bold">M</div>
                  <div class="w-3.5 h-3.5 rounded-full bg-zinc-800 border border-zinc-900 flex items-center justify-center text-[4px] text-zinc-400 font-bold">K</div>
                </div>
                <span class="text-[6.5px] text-zinc-400 font-sans">+12 verified nearby</span>
              </div>
            </div>

            <!-- Action Button -->
            <div class="pt-1 border-t border-zinc-800/80">
              <div class="w-full py-0.5 text-center rounded bg-indigo-600 text-[7px] font-bold text-white shadow-md shadow-indigo-600/10">
                Verify My Location
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Action Footer Link -->
      <div class="pt-6 border-t border-zinc-900/60 mt-8">
        <a 
          href="https://100m.workouse.com" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="flex items-center justify-between text-xs font-mono text-zinc-500 group-hover:text-brand-yellow transition duration-300"
        >
          <span>Launch 100m</span>
          <svg class="w-4 h-4 transform group-hover:translate-x-1 transition duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    </div>

    <!-- Card 2: davetiye.workouse.com -->
    <div class="glow-card p-6 rounded-3xl flex flex-col justify-between group">
      <div class="space-y-6">
        <!-- Header Info -->
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-[9px] font-mono font-bold uppercase tracking-wider text-brand-yellow px-2 rounded-full bg-brand-yellow/10 border border-brand-yellow/20">
              SaaS Platform
            </span>
            <span class="text-[9px] font-mono text-zinc-500">davetiye.workouse.com</span>
          </div>
          <h3 class="font-display text-xl font-bold text-white tracking-wide">
            E-Davetiye Builder
          </h3>
          <p class="text-xs text-zinc-400 leading-relaxed font-sans min-h-[80px]">
            Elegant digital wedding invitations. Featuring bespoke typography, real-time RSVP management, location pinning, music integration, and gorgeous layouts to share special days modernly.
          </p>
        </div>

        <!-- Interactive CSS Mockup: Digital Invitation -->
        <div class="relative w-full aspect-[4/3] rounded-2xl bg-zinc-950/80 border border-zinc-900 overflow-hidden flex items-center justify-center p-3">
          <!-- Ambient glowing backgrounds inside the mockup -->
          <div class="absolute -top-12 -left-12 w-20 h-20 bg-yellow-500/5 rounded-full blur-xl"></div>
          <div class="absolute -bottom-12 -right-12 w-20 h-20 bg-brand-blue/10 rounded-full blur-xl"></div>

          <!-- Wedding Card mockup viewport -->
          <div class="w-full max-w-[170px] h-[130px] bg-zinc-900 border border-zinc-800 rounded-2xl p-2 shadow-2xl flex flex-col justify-between relative text-left">
            <!-- Invitation Cover Mockup -->
            <div class="flex-grow flex flex-col justify-between border border-yellow-500/20 rounded-xl p-1.5 bg-gradient-to-b from-zinc-950 to-zinc-900/60 relative overflow-hidden">
              <!-- Corner decorations -->
              <div class="absolute top-1 left-1 w-1.5 h-1.5 border-t border-l border-yellow-500/30"></div>
              <div class="absolute top-1 right-1 w-1.5 h-1.5 border-t border-r border-yellow-500/30"></div>
              <div class="absolute bottom-1 left-1 w-1.5 h-1.5 border-b border-l border-yellow-500/30"></div>
              <div class="absolute bottom-1 right-1 w-1.5 h-1.5 border-b border-r border-yellow-500/30"></div>

              <!-- Content details -->
              <div class="text-center mt-1 space-y-0.5">
                <span class="text-[10px] font-serif text-yellow-500 tracking-wider">G & M</span>
                <div class="text-[5px] text-zinc-400 font-sans tracking-widest uppercase">Ceremony & Celebration</div>
              </div>

              <!-- Equalizer & Audio mockup -->
              <div class="flex items-center justify-between px-1">
                <div class="flex items-end gap-0.5 h-2">
                  <div class="w-0.5 bg-yellow-500/60 h-2 animate-pulse"></div>
                  <div class="w-0.5 bg-yellow-500/60 h-1"></div>
                  <div class="w-0.5 bg-yellow-500/60 h-2.5 animate-pulse"></div>
                  <div class="w-0.5 bg-yellow-500/60 h-1.5"></div>
                </div>
                <span class="text-[5px] font-mono text-zinc-400">Play Audio</span>
              </div>

              <!-- Attendance indicator -->
              <div class="flex justify-between items-center text-[6px] border-t border-zinc-800/80 pt-1 mt-0.5">
                <span class="text-zinc-500 font-mono">142 Attending</span>
                <span class="text-yellow-500 font-bold font-mono">RSVP Open</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Action Footer Link -->
      <div class="pt-6 border-t border-zinc-900/60 mt-8">
        <a 
          href="https://davetiye.workouse.com" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="flex items-center justify-between text-xs font-mono text-zinc-500 group-hover:text-brand-yellow transition duration-300"
        >
          <span>Launch E-Davetiye</span>
          <svg class="w-4 h-4 transform group-hover:translate-x-1 transition duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    </div>

    <!-- Card 3: qr-menu.workouse.com -->
    <div class="glow-card p-6 rounded-3xl flex flex-col justify-between group">
      <div class="space-y-6">
        <!-- Header Info -->
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-[9px] font-mono font-bold uppercase tracking-wider text-brand-yellow px-2 rounded-full bg-brand-yellow/10 border border-brand-yellow/20">
              SaaS Edge
            </span>
            <span class="text-[9px] font-mono text-zinc-500">qr-menu.workouse.com</span>
          </div>
          <h3 class="font-display text-xl font-bold text-white tracking-wide">
            Zero-DB QR Menu
          </h3>
          <p class="text-xs text-zinc-400 leading-relaxed font-sans min-h-[80px]">
            Lightning-fast digital restaurant menus. Compiles updates straight into static files on the edge, bypassing database lag and delivering menu listings in under 100ms globally.
          </p>
        </div>

        <!-- Interactive CSS Mockup: QR Menu compilation -->
        <div class="relative w-full aspect-[4/3] rounded-2xl bg-zinc-950/80 border border-zinc-900 overflow-hidden flex items-center justify-center p-3">
          <!-- Ambient glowing backgrounds inside the mockup -->
          <div class="absolute -top-12 -left-12 w-20 h-20 bg-emerald-500/10 rounded-full blur-xl"></div>
          <div class="absolute -bottom-12 -right-12 w-20 h-20 bg-brand-blue/10 rounded-full blur-xl"></div>

          <!-- Restaurant App mockup viewport -->
          <div class="w-full max-w-[170px] h-[130px] bg-zinc-900 border border-zinc-800 rounded-2xl p-2 shadow-2xl flex flex-col justify-between relative text-left">
            <!-- Compilation top state -->
            <div class="flex items-center justify-between border-b border-zinc-800/80 pb-1 mb-1">
              <span class="text-[6.5px] text-zinc-300 font-bold font-mono">Compiler Active</span>
              <div class="px-1 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-[5px] font-bold font-mono">
                EDGE SYNCED
              </div>
            </div>

            <!-- Menu lists -->
            <div class="flex-grow space-y-1 overflow-hidden">
              <div class="flex justify-between items-center bg-zinc-950/50 border border-zinc-850 p-1 rounded">
                <div class="flex items-center gap-1 min-w-0">
                  <span class="text-[7px]">🍔</span>
                  <div class="min-w-0">
                    <div class="text-[6.5px] font-bold text-zinc-200 truncate">Cheeseburger</div>
                  </div>
                </div>
                <span class="text-[6.5px] font-mono font-bold text-zinc-400 shrink-0">120 TL</span>
              </div>

              <div class="flex justify-between items-center bg-zinc-950/50 border border-zinc-850 p-1 rounded">
                <div class="flex items-center gap-1 min-w-0">
                  <span class="text-[7px]">🍟</span>
                  <div class="min-w-0">
                    <div class="text-[6.5px] font-bold text-zinc-200 truncate">Truffle Fries</div>
                  </div>
                </div>
                <span class="text-[6.5px] font-mono font-bold text-zinc-400 shrink-0">60 TL</span>
              </div>
            </div>

            <!-- Load time stat -->
            <div class="pt-1 border-t border-zinc-800/80 flex items-center justify-between text-[6px] font-mono text-zinc-500">
              <span>Latency</span>
              <span class="text-emerald-400 font-bold">18ms (Edge)</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Action Footer Link -->
      <div class="pt-6 border-t border-zinc-900/60 mt-8">
        <a 
          href="https://qr-menu.workouse.com" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="flex items-center justify-between text-xs font-mono text-zinc-500 group-hover:text-brand-yellow transition duration-300"
        >
          <span>Launch QR Menu</span>
          <svg class="w-4 h-4 transform group-hover:translate-x-1 transition duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    </div>

    <!-- Card 4: dedekorkut.workouse.com -->
    <div class="glow-card p-6 rounded-3xl flex flex-col justify-between group">
      <div class="space-y-6">
        <!-- Header Info -->
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-[9px] font-mono font-bold uppercase tracking-wider text-brand-yellow px-2 rounded-full bg-brand-yellow/10 border border-brand-yellow/20">
              AI Video SaaS
            </span>
            <span class="text-[9px] font-mono text-zinc-500">dedekorkut.workouse.com</span>
          </div>
          <h3 class="font-display text-xl font-bold text-white tracking-wide">
            Dede Korkut AI
          </h3>
          <p class="text-xs text-zinc-400 leading-relaxed font-sans min-h-[80px]">
            AI-powered demo video generator. Converts screenshots, features, or UI workflows into high-converting interactive video walkthroughs with narration and camera zoom.
          </p>
        </div>

        <!-- Interactive CSS Mockup: Video AI Editor -->
        <div class="relative w-full aspect-[4/3] rounded-2xl bg-zinc-950/80 border border-zinc-900 overflow-hidden flex items-center justify-center p-3">
          <!-- Ambient glowing backgrounds inside the mockup -->
          <div class="absolute -top-12 -left-12 w-20 h-20 bg-amber-500/10 rounded-full blur-xl"></div>
          <div class="absolute -bottom-12 -right-12 w-20 h-20 bg-zinc-800/10 rounded-full blur-xl"></div>

          <!-- Video Editor mockup viewport -->
          <div class="w-full max-w-[170px] h-[130px] bg-zinc-900 border border-zinc-800 rounded-2xl p-2 shadow-2xl flex flex-col justify-between relative text-left">
            <!-- Editor Top bar -->
            <div class="flex items-center justify-between border-b border-zinc-800/80 pb-1 mb-1">
              <span class="text-[6.5px] text-zinc-300 font-bold font-mono">Video Editor</span>
              <div class="px-1 py-0.2 rounded bg-amber-500 text-zinc-950 text-[5px] font-bold font-mono">
                RENDER MP4
              </div>
            </div>

            <!-- Video canvas preview -->
            <div class="h-[44px] bg-zinc-950 border border-zinc-850 rounded relative overflow-hidden flex items-center justify-center">
              <!-- Small mock UI inside canvas being recorded -->
              <div class="w-[70px] h-[30px] border border-zinc-800 rounded bg-zinc-900/60 p-1 flex flex-col justify-between">
                <div class="flex gap-0.5">
                  <div class="w-1.5 h-1.5 rounded-full bg-red-500/40"></div>
                  <div class="w-1.5 h-1.5 rounded-full bg-yellow-500/40"></div>
                </div>
                <div class="h-2 w-12 bg-zinc-850 rounded"></div>
              </div>
              <!-- Zoom Indicator target rings -->
              <div class="absolute w-8 h-8 rounded-full border border-amber-500/35 flex items-center justify-center animate-pulse">
                <div class="w-4 h-4 rounded-full border border-amber-500/50"></div>
              </div>
              <span class="absolute bottom-1 right-1 text-[5px] font-mono text-zinc-500 bg-zinc-950/80 px-0.5 rounded">Camera Zoom</span>
            </div>

            <!-- Timeline tracks -->
            <div class="space-y-1">
              <!-- Subtitle / Speech track -->
              <div class="h-2.5 rounded bg-zinc-950/40 border border-zinc-850 flex items-center px-1 justify-between text-[4.5px] font-mono text-zinc-500">
                <span>"Discover the core dashboard..."</span>
                <span class="text-[4px] text-zinc-600">Audio Synth</span>
              </div>
              <!-- Audio voice track wave mockup -->
              <div class="flex items-end gap-0.5 h-3 px-0.5">
                <div class="w-[1.5px] bg-amber-500/50 h-1.5"></div>
                <div class="w-[1.5px] bg-amber-500/50 h-2.5 animate-pulse"></div>
                <div class="w-[1.5px] bg-amber-500/50 h-2"></div>
                <div class="w-[1.5px] bg-amber-500/50 h-3 animate-pulse"></div>
                <div class="w-[1.5px] bg-amber-500/50 h-1"></div>
                <div class="w-[1.5px] bg-amber-500/50 h-2"></div>
              </div>
            </div>

            <!-- Status -->
            <div class="pt-0.5 border-t border-zinc-800/80 flex items-center justify-between text-[5.5px] font-mono text-zinc-500">
              <span>Render Status</span>
              <span class="text-amber-500 font-bold">84%</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Action Footer Link -->
      <div class="pt-6 border-t border-zinc-900/60 mt-8">
        <a 
          href="https://dedekorkut.workouse.com" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="flex items-center justify-between text-xs font-mono text-zinc-500 group-hover:text-brand-yellow transition duration-300"
        >
          <span>Launch Dede Korkut</span>
          <svg class="w-4 h-4 transform group-hover:translate-x-1 transition duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    </div>

  </div>
</section>

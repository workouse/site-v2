<script>
  import { trackProjectClick } from '../lib/analytics';

  const section = document.getElementById('projects');
  if (section) {
    section.addEventListener('click', (e) => {
      const link = (e.target as HTMLElement)?.closest('a[data-project-name]');
      if (!link) return;
      const projectName = link.getAttribute('data-project-name') || '';
      const projectCategory = link.getAttribute('data-project-category') || 'General';
      const destinationUrl = link.getAttribute('href') || '';

      if (projectName && destinationUrl) {
        trackProjectClick({
          projectName,
          projectCategory,
          destinationUrl,
        });
      }
    });
  }
</script>


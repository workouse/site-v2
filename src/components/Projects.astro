<section id="projects" class="py-24 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto border-t border-zinc-200 dark:border-zinc-900 scroll-mt-16 transition-colors duration-300">
  <!-- Section Title -->
  <div class="text-center max-w-2xl mx-auto mb-16 space-y-3">
    <div class="inline-flex items-center gap-3">
      <span class="text-xs font-mono font-bold tracking-widest text-brand-blue dark:text-brand-yellow uppercase">Projects</span>
      <span class="h-[1px] w-8 bg-zinc-300 dark:bg-zinc-800"></span>
    </div>
    <h2 class="font-display text-3xl sm:text-4xl font-bold tracking-tight text-zinc-950 dark:text-white">
      SaaS & Mobile Products
    </h2>
    <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-400">
      Production-grade platforms built with performance, security, and exceptional user experience.
    </p>
  </div>

  <!-- Cards Grid (3 columns) -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    
    <!-- Card 1: 100m.workouse.com -->
    <div class="glow-card p-6 rounded-3xl flex flex-col justify-between group">
      <div class="space-y-6">
        <!-- Header Info -->
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-[9px] font-mono font-bold uppercase tracking-wider text-brand-blue dark:text-brand-yellow px-2 rounded-full bg-brand-yellow/10 border border-brand-yellow/30">
              SaaS & Mobile
            </span>
            <span class="text-[9px] font-mono text-zinc-600 dark:text-zinc-500">100m.workouse.com</span>
          </div>
          <h3 class="font-display text-xl font-bold text-zinc-950 dark:text-white tracking-wide">
            100m Social Room
          </h3>
          <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed font-sans min-h-[80px]">
            Location-verified social networking for physical venues. Check in securely via GPS/QR, see who is in the same room, and connect while keeping your privacy completely protected.
          </p>
        </div>

        <!-- Interactive CSS Mockup: Location Social App -->
        <div class="relative w-full aspect-[4/3] rounded-2xl bg-zinc-100 dark:bg-zinc-950/80 border border-zinc-200 dark:border-zinc-900 overflow-hidden flex items-center justify-center p-3">
          <!-- Ambient glowing backgrounds inside the mockup -->
          <div class="absolute -top-12 -left-12 w-20 h-20 bg-indigo-500/10 rounded-full blur-xl"></div>
          <div class="absolute -bottom-12 -right-12 w-20 h-20 bg-brand-yellow/10 rounded-full blur-xl"></div>

          <!-- Phone mockup viewport -->
          <div class="w-full max-w-[170px] h-[130px] bg-zinc-900 border border-zinc-800 rounded-2xl p-2 shadow-xl flex flex-col justify-between relative text-left">
            <!-- Top bar -->
            <div class="flex items-center justify-between border-b border-zinc-800/80 pb-1 mb-1">
              <div class="flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-green-500 animate-ping"></span>
                <span class="text-[7px] font-mono text-zinc-300 font-bold">100m Room</span>
              </div>
              <span class="text-[6px] text-zinc-500 font-mono">Kadıköy Cafe</span>
            </div>

            <!-- Active check-in card -->
            <div class="flex-grow space-y-1 overflow-hidden">
              <div class="p-1 rounded bg-zinc-950 border border-zinc-800/60 flex items-center gap-1.5">
                <div class="w-5 h-5 rounded-full bg-gradient-to-tr from-brand-yellow/20 to-indigo-500/20 border border-zinc-700 flex items-center justify-center text-[8px] text-indigo-300 font-bold shrink-0">
                  EY
                </div>
                <div class="min-w-0">
                  <div class="text-[7.5px] font-bold text-zinc-200 truncate">Emre Yılmaz</div>
                  <div class="text-[5.5px] text-zinc-500 font-mono truncate">Checked-in • 4m ago</div>
                </div>
              </div>

              <!-- Other users list teaser -->
              <div class="flex items-center gap-1 px-0.5 pt-0.5">
                <div class="flex -space-x-1">
                  <div class="w-3.5 h-3.5 rounded-full bg-zinc-800 border border-zinc-900 flex items-center justify-center text-[4px] text-zinc-400 font-bold">A</div>
                  <div class="w-3.5 h-3.5 rounded-full bg-zinc-800 border border-zinc-900 flex items-center justify-center text-[4px] text-zinc-400 font-bold">M</div>
                  <div class="w-3.5 h-3.5 rounded-full bg-zinc-800 border border-zinc-900 flex items-center justify-center text-[4px] text-zinc-400 font-bold">K</div>
                </div>
                <span class="text-[6.5px] text-zinc-400 font-sans">+12 verified nearby</span>
              </div>
            </div>

            <!-- Action Button -->
            <div class="pt-1 border-t border-zinc-800/80">
              <div class="w-full py-0.5 text-center rounded bg-indigo-600 text-[7px] font-bold text-white shadow-md shadow-indigo-600/10">
                Verify My Location
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Action Footer Link -->
      <div class="pt-6 border-t border-zinc-200 dark:border-zinc-900/60 mt-8">
        <a 
          href="https://100m.workouse.com" 
          target="_blank" 
          rel="noopener noreferrer" 
          data-project-name="100m Social Room"
          data-project-category="SaaS & Mobile"
          class="flex items-center justify-between text-xs font-mono text-zinc-600 dark:text-zinc-500 group-hover:text-brand-blue dark:group-hover:text-brand-yellow transition duration-300"
        >
          <span>Launch 100m</span>
          <svg class="w-4 h-4 transform group-hover:translate-x-1 transition duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    </div>

    <!-- Card 2: ai-gateway.workouse.com -->
    <div class="glow-card p-6 rounded-3xl flex flex-col justify-between group">
      <div class="space-y-6">
        <!-- Header Info -->
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-[9px] font-mono font-bold uppercase tracking-wider text-brand-blue dark:text-brand-yellow px-2 rounded-full bg-brand-yellow/10 border border-brand-yellow/30">
              Enterprise AI & DLP
            </span>
            <span class="text-[9px] font-mono text-zinc-600 dark:text-zinc-500">ai-gateway.workouse.com</span>
          </div>
          <h3 class="font-display text-xl font-bold text-zinc-950 dark:text-white tracking-wide">
            Workouse AI Gateway
          </h3>
          <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed font-sans min-h-[80px]">
            Zero-trust enterprise AI gateway with real-time in-memory DLP token vault, USD budget guardrails, and unified multi-provider routing across OpenAI, Anthropic, and local LLMs.
          </p>
        </div>

        <!-- Interactive CSS Mockup: Zero-Trust AI & DLP Engine -->
        <div class="relative w-full aspect-[4/3] rounded-2xl bg-zinc-100 dark:bg-zinc-950/80 border border-zinc-200 dark:border-zinc-900 overflow-hidden flex items-center justify-center p-3">
          <!-- Ambient glowing backgrounds inside the mockup -->
          <div class="absolute -top-12 -left-12 w-20 h-20 bg-emerald-500/10 rounded-full blur-xl"></div>
          <div class="absolute -bottom-12 -right-12 w-20 h-20 bg-brand-blue/10 rounded-full blur-xl"></div>

          <!-- Gateway Engine mockup viewport -->
          <div class="w-full max-w-[170px] h-[130px] bg-zinc-900 border border-zinc-800 rounded-2xl p-2 shadow-xl flex flex-col justify-between relative text-left">
            <!-- Top bar -->
            <div class="flex items-center justify-between border-b border-zinc-800/80 pb-1 mb-1">
              <div class="flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span>
                <span class="text-[7px] font-mono text-zinc-300 font-bold">DLP Vault</span>
              </div>
              <div class="px-1 py-0.2 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-[5px] font-bold font-mono">
                ZERO-PERSIST
              </div>
            </div>

            <!-- In-Memory DLP Sanitization Flow -->
            <div class="flex-grow space-y-1 overflow-hidden">
              <div class="p-1 rounded bg-zinc-950 border border-zinc-800/60 space-y-0.5">
                <div class="flex items-center justify-between text-[5.5px] font-mono text-zinc-400">
                  <span class="text-emerald-400 font-bold">RAM Tokenizer</span>
                  <span class="text-brand-yellow font-bold">PII Filtered</span>
                </div>
                <div class="text-[6px] text-zinc-300 font-mono truncate">&lbrace;&lbrace;CREDIT_CARD_1&rbrace;&rbrace; ➔ LLM</div>
              </div>

              <div class="p-1 rounded bg-zinc-950 border border-zinc-800/60 flex items-center justify-between">
                <div class="flex items-center gap-1 min-w-0">
                  <span class="text-[6px] text-brand-blue dark:text-brand-yellow font-mono font-bold">Multi-Route</span>
                  <span class="text-[5.5px] text-zinc-400 font-mono truncate">OpenAI • Claude</span>
                </div>
                <span class="text-[5px] px-1 py-0.2 rounded bg-emerald-500/10 text-emerald-400 font-mono font-bold">$ USD Cap</span>
              </div>
            </div>

            <!-- Status bar -->
            <div class="pt-1 border-t border-zinc-800/80 flex items-center justify-between text-[5.5px] font-mono text-zinc-500">
              <span>Audit Log</span>
              <span class="text-emerald-400 font-bold">Encrypted • 0 Disk</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Action Footer Link -->
      <div class="pt-6 border-t border-zinc-200 dark:border-zinc-900/60 mt-8">
        <a 
          href="https://ai-gateway.workouse.com" 
          target="_blank" 
          rel="noopener noreferrer" 
          data-project-name="Workouse AI Gateway"
          data-project-category="Enterprise AI & DLP"
          class="flex items-center justify-between text-xs font-mono text-zinc-600 dark:text-zinc-500 group-hover:text-brand-blue dark:group-hover:text-brand-yellow transition duration-300"
        >
          <span>Launch AI Gateway</span>
          <svg class="w-4 h-4 transform group-hover:translate-x-1 transition duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    </div>

    <!-- Card 3: Bilo Bunker -->
    <div class="glow-card p-6 rounded-3xl flex flex-col justify-between group">
      <div class="space-y-6">
        <!-- Header Info -->
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-[9px] font-mono font-bold uppercase tracking-wider text-brand-blue dark:text-brand-yellow px-2 rounded-full bg-brand-yellow/10 border border-brand-yellow/30">
              Nostr Signer
            </span>
            <span class="text-[9px] font-mono text-zinc-600 dark:text-zinc-500">github.com/workouse/bilo-bunker</span>
          </div>
          <h3 class="font-display text-xl font-bold text-zinc-950 dark:text-white tracking-wide">
            Bilo Bunker
          </h3>
          <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed font-sans min-h-[80px]">
            Stateful, multi-tenant Nostr remote signing service (NIP-46). Secures Nostr private keys on server infrastructure while responding to remote RPC signing requests across Nostr relays.
          </p>
        </div>

        <!-- Interactive CSS Mockup: Remote Signer Engine -->
        <div class="relative w-full aspect-[4/3] rounded-2xl bg-zinc-100 dark:bg-zinc-950/80 border border-zinc-200 dark:border-zinc-900 overflow-hidden flex items-center justify-center p-3">
          <!-- Ambient glowing backgrounds inside the mockup -->
          <div class="absolute -top-12 -left-12 w-20 h-20 bg-purple-500/10 rounded-full blur-xl"></div>
          <div class="absolute -bottom-12 -right-12 w-20 h-20 bg-brand-yellow/10 rounded-full blur-xl"></div>

          <!-- Phone/Engine mockup viewport -->
          <div class="w-full max-w-[170px] h-[130px] bg-zinc-900 border border-zinc-800 rounded-2xl p-2 shadow-xl flex flex-col justify-between relative text-left">
            <!-- Top bar -->
            <div class="flex items-center justify-between border-b border-zinc-800/80 pb-1 mb-1">
              <div class="flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-purple-500 animate-ping"></span>
                <span class="text-[7px] font-mono text-zinc-300 font-bold">Bilo Bunker</span>
              </div>
              <div class="px-1 py-0.2 rounded bg-purple-500/10 text-purple-400 border border-purple-500/20 text-[5px] font-bold font-mono">
                NIP-46 ACTIVE
              </div>
            </div>

            <!-- Signing details -->
            <div class="flex-grow space-y-1 overflow-hidden">
              <div class="p-1 rounded bg-zinc-950 border border-zinc-800/60 space-y-0.5">
                <div class="flex items-center justify-between text-[5.5px] font-mono text-zinc-400">
                  <span class="text-purple-400 font-bold">bunker://</span>
                  <span class="text-emerald-400 font-bold">secp256k1</span>
                </div>
                <div class="text-[6px] text-zinc-300 font-mono truncate">pubkey: 3bf0c6...8a2e</div>
              </div>

              <div class="p-1 rounded bg-zinc-950 border border-zinc-800/60 flex items-center justify-between">
                <div class="flex items-center gap-1 min-w-0">
                  <span class="text-[6px] text-brand-yellow font-mono font-bold">RPC Sign Event</span>
                  <span class="text-[5.5px] text-zinc-400 font-mono truncate">Kind 27235</span>
                </div>
                <span class="text-[5px] px-1 py-0.2 rounded bg-emerald-500/10 text-emerald-400 font-mono font-bold">APPROVED</span>
              </div>
            </div>

            <!-- Status bar -->
            <div class="pt-1 border-t border-zinc-800/80 flex items-center justify-between text-[5.5px] font-mono text-zinc-500">
              <span>Relay Connection</span>
              <span class="text-purple-400 font-bold">4 Relays Synced</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Action Footer Link -->
      <div class="pt-6 border-t border-zinc-200 dark:border-zinc-900/60 mt-8">
        <a 
          href="https://github.com/workouse/bilo-bunker" 
          target="_blank" 
          rel="noopener noreferrer" 
          data-project-name="Bilo Bunker"
          data-project-category="Nostr Signer"
          class="flex items-center justify-between text-xs font-mono text-zinc-600 dark:text-zinc-500 group-hover:text-brand-blue dark:group-hover:text-brand-yellow transition duration-300"
        >
          <span>Launch Bilo Bunker</span>
          <svg class="w-4 h-4 transform group-hover:translate-x-1 transition duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    </div>

    <!-- Card 4: qr-menu.workouse.com -->
    <div class="glow-card p-6 rounded-3xl flex flex-col justify-between group">
      <div class="space-y-6">
        <!-- Header Info -->
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-[9px] font-mono font-bold uppercase tracking-wider text-brand-blue dark:text-brand-yellow px-2 rounded-full bg-brand-yellow/10 border border-brand-yellow/30">
              SaaS Edge
            </span>
            <span class="text-[9px] font-mono text-zinc-600 dark:text-zinc-500">qr-menu.workouse.com</span>
          </div>
          <h3 class="font-display text-xl font-bold text-zinc-950 dark:text-white tracking-wide">
            Zero-DB QR Menu

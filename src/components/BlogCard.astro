---
import { type BlogPost, getCleanSlug, calculateReadTime } from '../lib/blog';

interface Props {
  post: BlogPost;
  lang: 'en' | 'tr';
}

const { post, lang } = Astro.props;
const cleanSlug = getCleanSlug(post.slug);
const href = lang === 'tr' ? `/blog/tr/${cleanSlug}` : `/blog/${cleanSlug}`;

const formattedDate = new Intl.DateTimeFormat(lang === 'tr' ? 'tr-TR' : 'en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
}).format(post.data.pubDate);

const readTime = calculateReadTime(post.body || '');
const readTimeText = lang === 'tr' ? `${readTime} dk okuma` : `${readTime} min read`;
---

<article class="glow-card rounded-2xl p-6 sm:p-8 flex flex-col justify-between group h-full">
  <div>
    <!-- Metadata Bar -->
    <div class="flex items-center justify-between gap-4 text-xs font-mono text-zinc-400 mb-4">
      <div class="flex items-center gap-2">
        <span class="px-2.5 py-0.5 rounded-full bg-zinc-900 border border-zinc-800 text-brand-yellow font-medium">
          {lang.toUpperCase()}
        </span>
        <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
      </div>
      <span class="text-zinc-500">{readTimeText}</span>
    </div>

    <!-- Title -->
    <h3 class="text-xl sm:text-2xl font-bold font-display tracking-tight text-zinc-100 group-hover:text-brand-yellow transition duration-200 mb-3">
      <a href={href} class="focus:outline-none">
        {post.data.title}
      </a>
    </h3>

    <!-- Description -->
    <p class="text-zinc-400 text-sm leading-relaxed mb-6 line-clamp-3">
      {post.data.description}
    </p>
  </div>

  <!-- Footer Tags & Link -->
  <div class="pt-4 border-t border-zinc-900/80 flex items-center justify-between gap-4">
    <div class="flex flex-wrap gap-1.5">
      {post.data.tags.map((tag) => (
        <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-zinc-900 text-zinc-400 border border-zinc-800/80">
          #{tag}
        </span>
      ))}
    </div>

    <a
      href={href}
      class="inline-flex items-center gap-1.5 text-xs font-semibold text-brand-yellow hover:text-yellow-300 transition duration-200 shrink-0"
    >
      <span>{lang === 'tr' ? 'Oku' : 'Read Article'}</span>
      <svg class="w-4 h-4 transform group-hover:translate-x-1 transition duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>
    </a>
  </div>
</article>

---
---

<section class="py-24 px-4 sm:px-6 lg:px-8 relative overflow-hidden border-t border-zinc-200 dark:border-zinc-900 transition-colors duration-300">
  <!-- Glow Backdrops -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[70vw] h-[25vh] bg-brand-blue/5 blur-[100px] rounded-full pointer-events-none"></div>

  <div class="max-w-4xl mx-auto relative z-10 text-center">
    
    <!-- Code quote visual wrapper -->
    <div class="flex flex-col items-center">
      <!-- Top Quote/Bracket Mark -->
      <span class="font-mono text-zinc-300 dark:text-zinc-800 text-6xl select-none leading-none h-6">&ldquo;</span>

      <!-- Quote Content -->
      <blockquote class="mt-4 mb-8">
        <p class="font-display text-2xl sm:text-4xl md:text-5xl font-bold tracking-tight text-zinc-800 dark:text-zinc-300 leading-normal sm:leading-relaxed">
          Complexity is the enemy of <span class="bg-gradient-to-r from-brand-blue to-blue-600 dark:from-brand-yellow dark:to-yellow-300 bg-clip-text text-transparent">reliability</span>. 
          My goal is to build systems that are as simple as possible, but <span class="text-zinc-950 dark:text-white underline decoration-brand-blue dark:decoration-brand-yellow decoration-2 underline-offset-8">no simpler</span>—ensuring they remain maintainable long after the final commit.
        </p>
      </blockquote>

      <!-- Bottom Quote/Bracket Mark -->
      <span class="font-mono text-zinc-300 dark:text-zinc-800 text-6xl select-none leading-none h-6">&rdquo;</span>
    </div>

    <!-- Quote Attribution / Small Subtext -->
    <div class="mt-4 flex items-center justify-center gap-2">
      <span class="h-[1px] w-4 bg-zinc-300 dark:bg-zinc-800"></span>
      <span class="text-[10px] font-mono tracking-widest text-zinc-600 dark:text-zinc-500 uppercase">Engineering Axiom</span>
      <span class="h-[1px] w-4 bg-zinc-300 dark:bg-zinc-800"></span>
    </div>

  </div>
</section>

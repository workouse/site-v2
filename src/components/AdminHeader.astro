---
interface Props {
  activeTab?: 'overview' | 'leads' | 'logs' | 'settings';
}

const { activeTab = 'overview' } = Astro.props;
---

<header class="w-full bg-zinc-950/90 border-b border-zinc-800/80 backdrop-blur-md sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Brand / Title -->
    <div class="flex items-center gap-3">
      <a href="/" class="flex items-center gap-2 text-white font-bold tracking-tight text-lg hover:opacity-90 transition">
        <span class="w-8 h-8 rounded-lg bg-[#FEC500] text-zinc-950 font-black flex items-center justify-center text-sm shadow-md">
          W
        </span>
        <span>Workouse</span>
      </a>
      <span class="text-zinc-600 text-sm font-medium">/</span>
      <span class="bg-blue-950/80 text-blue-400 text-xs font-semibold px-2.5 py-1 rounded-full border border-blue-800/50 flex items-center gap-1.5">
        <span class="w-1.5 h-1.5 rounded-full bg-blue-400"></span>
        Admin Console
      </span>
    </div>

    <!-- Navigation Tabs -->
    <nav class="hidden md:flex items-center gap-1 bg-zinc-900/90 p-1 rounded-xl border border-zinc-800/80">
      <a
        href="#overview"
        data-tab="overview"
        class={`px-4 py-1.5 rounded-lg text-xs font-medium transition ${
          activeTab === 'overview'
            ? 'bg-zinc-800 text-white shadow-sm font-semibold'
            : 'text-zinc-400 hover:text-white hover:bg-zinc-800/50'
        }`}
      >
        Executive Overview
      </a>
      <a
        href="#leads"
        data-tab="leads"
        class={`px-4 py-1.5 rounded-lg text-xs font-medium transition ${
          activeTab === 'leads'
            ? 'bg-zinc-800 text-white shadow-sm font-semibold'
            : 'text-zinc-400 hover:text-white hover:bg-zinc-800/50'
        }`}
      >
        Audit Leads
      </a>
      <a
        href="#re-audit"
        data-tab="re-audit"
        class="px-4 py-1.5 rounded-lg text-xs font-medium text-zinc-400 hover:text-white hover:bg-zinc-800/50 transition"
      >
        Batch Re-audit
      </a>
      <a
        href="#audit-logs"
        data-tab="logs"
        class={`px-4 py-1.5 rounded-lg text-xs font-medium transition ${
          activeTab === 'logs'
            ? 'bg-zinc-800 text-white shadow-sm font-semibold'
            : 'text-zinc-400 hover:text-white hover:bg-zinc-800/50'
        }`}
      >
        Audit Logs & API Debug
      </a>
    </nav>

    <!-- Platform Telemetry & RBAC status -->
    <div class="flex items-center gap-3">
      <div class="hidden sm:flex items-center gap-2 bg-emerald-950/40 text-emerald-400 text-xs font-mono px-3 py-1 rounded-full border border-emerald-800/40">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>Systems Operational</span>
      </div>

      <div class="bg-zinc-900 border border-zinc-800 text-zinc-400 text-xs px-2.5 py-1 rounded-lg font-mono flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5 text-[#FEC500]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
        </svg>
        <span>RBAC Admin</span>
      </div>
    </div>
  </div>
</header>

---
---

<section id="competencies" class="py-24 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto border-t border-zinc-200 dark:border-zinc-900 scroll-mt-16 transition-colors duration-300">
  <!-- Section Title -->
  <div class="text-center max-w-2xl mx-auto mb-16 space-y-3">
    <div class="inline-flex items-center gap-3">
      <span class="text-xs font-mono font-bold tracking-widest text-brand-blue dark:text-brand-yellow uppercase">What I Do</span>
      <span class="h-[1px] w-8 bg-zinc-300 dark:bg-zinc-800"></span>
    </div>
    <h2 class="font-display text-3xl sm:text-4xl font-bold tracking-tight text-zinc-950 dark:text-white">
      Core Engineering Competencies
    </h2>
    <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-400">
      Engineered for robustness, built for performance, and packaged with automation from day one.
    </p>
  </div>

  <!-- Cards Grid -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
    
    <!-- Card 1: Fullstack Architecture -->
    <div class="glow-card p-8 rounded-3xl flex flex-col justify-between group">
      <div class="space-y-6">
        <!-- SVG Icon -->
        <div class="w-12 h-12 rounded-2xl bg-brand-blue/10 border border-brand-blue/20 flex items-center justify-center text-brand-blue dark:text-brand-yellow group-hover:border-brand-yellow/50 transition duration-300">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <!-- Layers stack representing fullstack -->
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 6l9-3 9 3v12l-9 3-9-3V6z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 11l9 3 9-3" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 16l9 3 9-3" />
          </svg>
        </div>

        <div class="space-y-3">
          <h3 class="font-display text-xl font-bold text-zinc-950 dark:text-white tracking-wide">
            Fullstack Architecture
          </h3>
          <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed font-sans">
            Building end-to-end applications using modern frameworks, robust APIs, and highly resilient distributed systems. Designing clear boundaries between domains to keep platforms scalable and simple to expand.
          </p>
        </div>
      </div>

      <div class="pt-6 border-t border-zinc-200 dark:border-zinc-900/60 mt-8 flex items-center justify-between text-xs font-mono text-zinc-500 dark:text-zinc-500 group-hover:text-brand-blue dark:group-hover:text-brand-yellow transition duration-300">
        <span>Clean Boundaries</span>
        <svg class="w-4 h-4 transform group-hover:translate-x-1 transition duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </div>
    </div>

    <!-- Card 2: DevOps & Automation -->
    <div class="glow-card p-8 rounded-3xl flex flex-col justify-between group">
      <div class="space-y-6">
        <!-- SVG Icon -->
        <div class="w-12 h-12 rounded-2xl bg-brand-blue/10 border border-brand-blue/20 flex items-center justify-center text-brand-blue dark:text-brand-yellow group-hover:border-brand-yellow/50 transition duration-300">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <!-- Gear / Terminal deployment represent container orchestration -->
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 17.25v1.007a3 3 0 01-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0115 18.257V17.25m6-12V15a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 15V5.25m18 0A2.25 2.25 0 0018.75 3H5.25A2.25 2.25 0 003 5.25m18 0V12a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 12V5.25" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 8.25h.008v.008H8V8.25zm4 0h.008v.008H12V8.25zm4 0h.008v.008H16V8.25z" />
          </svg>
        </div>

        <div class="space-y-3">
          <h3 class="font-display text-xl font-bold text-zinc-950 dark:text-white tracking-wide">
            DevOps & Automation
          </h3>
          <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed font-sans">
            Streamlining CI/CD pipelines, Infrastructure as Code (IaC), container orchestration, and maximizing developer velocity. Empowering projects with reproducible environments using Nix flakes, Docker, and declarative configs.
          </p>
        </div>
      </div>

      <div class="pt-6 border-t border-zinc-200 dark:border-zinc-900/60 mt-8 flex items-center justify-between text-xs font-mono text-zinc-500 dark:text-zinc-500 group-hover:text-brand-blue dark:group-hover:text-brand-yellow transition duration-300">
        <span>IaC & Speed</span>
        <svg class="w-4 h-4 transform group-hover:translate-x-1 transition duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </div>
    </div>

    <!-- Card 3: Performance Engineering -->
    <div class="glow-card p-8 rounded-3xl flex flex-col justify-between group">
      <div class="space-y-6">
        <!-- SVG Icon -->
        <div class="w-12 h-12 rounded-2xl bg-brand-blue/10 border border-brand-blue/20 flex items-center justify-center text-brand-blue dark:text-brand-yellow group-hover:border-brand-yellow/50 transition duration-300">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <!-- Bolt/Speed representing performance engineering -->
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>

        <div class="space-y-3">
          <h3 class="font-display text-xl font-bold text-zinc-950 dark:text-white tracking-wide">
            Performance Engineering
          </h3>
          <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed font-sans">
            Obsessed with algorithm optimization, database indexing, reducing latency, and squeezing every millisecond out of the critical path. Building caching layers and streaming infrastructures that keep response times sub-millisecond.
          </p>
        </div>
      </div>

      <div class="pt-6 border-t border-zinc-200 dark:border-zinc-900/60 mt-8 flex items-center justify-between text-xs font-mono text-zinc-500 dark:text-zinc-500 group-hover:text-brand-blue dark:group-hover:text-brand-yellow transition duration-300">
        <span>O(n) & Latency</span>
        <svg class="w-4 h-4 transform group-hover:translate-x-1 transition duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </div>
    </div>

  </div>
</section>

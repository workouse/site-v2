---
/**
 * Global site header: lockup, primary navigation, and booking CTA.
 *
 * Desktop (≥1024px): Services and Resources are disclosure buttons that open
 * 360px panels overlaying the page; the header height never changes.
 * Compact (<1024px): a Menu/Close toggle reveals a full-width panel below the bar.
 *
 * Without JavaScript every destination stays reachable: disclosure panels and the
 * mobile menu render as static lists. `src/scripts/nav.ts` adds the disclosure
 * behavior once `data-enhanced` is set on the header.
 *
 * Content comes from `src/data/site.ts` (`nav`, `links`). The page should render
 * `<main id="main">` for the skip link to resolve.
 */
import Button from '../ui/Button.astro';
import WorkouseLockup from '../ui/WorkouseLockup.astro';
import { nav, resolveLink } from '../../data/site';
import type { NavMobileEntry, NavMobileGroup } from '../../data/site';
import { isPathActive } from '../../scripts/nav';

export interface Props {
  currentPath?: string;
}

const MOBILE_MENU_ID = 'site-mobile-menu';
const DISCLOSURE_ID_PREFIX = 'site-nav-';
const SKIP_LINK_HREF = '#main';
const SKIP_LINK_LABEL = 'Skip to main content';

const { currentPath = Astro.url.pathname } = Astro.props;

const slugify = (value: string): string =>
  value
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');

const booking = resolveLink('booking', nav.cta.label);

const isMobileGroup = (entry: NavMobileEntry): entry is NavMobileGroup =>
  'items' in entry;
---

<header class="site-header" data-site-header>
  <a class="skip-link" href={SKIP_LINK_HREF}>{SKIP_LINK_LABEL}</a>

  <div class="site-header__bar">
    <WorkouseLockup href="/" />

    <nav class="site-nav" aria-label="Primary">
      <ul class="site-nav__list">
        {
          nav.desktop.map((item) => {
            if (item.type === 'link') {
              const resolved = resolveLink(item.ref);
              const active = isPathActive(resolved.href, currentPath);
              return (
                <li class="nav-item">
                  <a
                    class="nav-link"
                    href={resolved.href}
                    aria-current={active ? 'page' : undefined}
                  >
                    {resolved.label}
                  </a>
                </li>
              );
            }
            const panelId = `${DISCLOSURE_ID_PREFIX}${slugify(item.label)}`;
            return (
              <li class="nav-item" data-disclosure>
                <button
                  type="button"
                  class="nav-trigger"
                  aria-expanded="false"
                  aria-controls={panelId}
                  data-disclosure-trigger
                >
                  <span>{item.label}</span>
                  <span class="nav-trigger__chevron" aria-hidden="true">⌄</span>
                </button>
                <div id={panelId} class="disclosure-panel" data-disclosure-panel>
                  <p class="panel-eyebrow">{item.panelEyebrow}</p>
                  <ul class="panel-list">
                    {item.items.map((ref) => {
                      const resolved = resolveLink(ref);
                      const active = isPathActive(resolved.href, currentPath);
                      return (
                        <li>
                          <a
                            class="panel-link"
                            href={resolved.href}
                            aria-current={active ? 'page' : undefined}
                          >
                            {resolved.label}
                          </a>
                        </li>
                      );
                    })}
                  </ul>
                </div>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <Button
      kind="primary"
      href={booking.href}
      external
      label={nav.cta.label}
      class="nav-cta"
    />

    <button
      type="button"
      class="menu-toggle"
      aria-expanded="false"
      aria-controls={MOBILE_MENU_ID}
      data-menu-toggle
      data-label-closed={nav.mobileToggle.closed}
      data-label-open={nav.mobileToggle.open}
    >
      <span data-menu-label>{nav.mobileToggle.closed}</span>
      <span class="menu-toggle__icon" aria-hidden="true">{nav.mobileToggle.icon}</span>
    </button>
  </div>

  <div id={MOBILE_MENU_ID} class="mobile-menu" data-mobile-menu>
    {
      nav.mobileMenu.map((entry) => {
        if (isMobileGroup(entry)) {
          return (
            <section class="mobile-group">
              <p class="panel-eyebrow">{entry.eyebrow}</p>
              <ul class="panel-list">
                {entry.items.map((ref) => {
                  const resolved = resolveLink(ref);
                  const active = isPathActive(resolved.href, currentPath);
                  return (
                    <li>
                      <a
                        class="panel-link"
                        href={resolved.href}
                        aria-current={active ? 'page' : undefined}
                      >
                        {resolved.label}
                      </a>
                    </li>
                  );
                })}
              </ul>
            </section>
          );
        }
        return (
          <Button
            kind="primary"
            href={booking.href}
            external
            block
            label={nav.cta.label}
            class="mobile-cta"
          />
        );
      })
    }
  </div>
</header>

<script>
  import { initSiteNav } from '../../scripts/nav';
  initSiteNav();
</script>

<style>
  .site-header {
    position: relative;
    z-index: 50;
    background-color: var(--surface-page, #faf8f4);
    color: var(--text-primary, #24354f);
    font-family: var(--font-sans);
    font-variation-settings: var(--font-sans-opsz);
  }

  .site-header__bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-32, 32px);
    box-sizing: border-box;
    height: 92px;
    padding: 20px var(--space-24, 24px);
  }

  @media (min-width: 768px) {
    .site-header__bar {
      height: 108px;
      padding: var(--space-28, 28px) 40px;
    }
  }

  @media (min-width: 1024px) {
    .site-header__bar {
      height: 112px;
      padding: var(--space-28, 28px) var(--page-margin, 96px);
    }
  }

  /* Without JS the bar grows to hold the static lists; with JS it stays fixed. */
  .site-header:not([data-enhanced]) .site-header__bar {
    height: auto;
    flex-wrap: wrap;
  }

  /* Skip link: first focusable element, visible only on focus. */
  .skip-link {
    position: absolute;
    left: var(--space-16, 16px);
    top: var(--space-8, 8px);
    z-index: 100;
    min-height: 44px;
    box-sizing: border-box;
    padding: var(--space-12, 12px) var(--space-16, 16px);
    background-color: var(--surface-raised, #ffffff);
    color: var(--text-primary, #24354f);
    font-size: 14px;
    line-height: 1.55;
    text-decoration: none;
    transform: translateY(-200%);
  }

  .skip-link:focus-visible {
    transform: none;
  }

  /* Desktop navigation */
  .site-nav {
    display: none;
  }

  .site-nav__list {
    display: flex;
    align-items: center;
    gap: var(--space-28, 28px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-link,
  .nav-trigger {
    display: inline-flex;
    align-items: center;
    gap: var(--space-4, 4px);
    min-height: 44px;
    box-sizing: border-box;
    padding: var(--space-12, 12px) 0;
    border: none;
    background: none;
    color: var(--text-primary, #24354f);
    font: inherit;
    font-size: 14px;
    line-height: 1.55;
    text-decoration: none;
    cursor: pointer;
  }

  .nav-link:hover,
  .nav-trigger:hover {
    color: var(--text-link, #53658e);
  }

  .nav-link[aria-current='page'] {
    color: var(--text-link, #53658e);
    text-decoration: underline;
    text-underline-offset: var(--space-4, 4px);
  }

  .nav-trigger__chevron {
    line-height: 1;
  }

  .nav-cta {
    display: none;
  }

  /* Disclosure and mobile panels */
  .disclosure-panel,
  .mobile-menu {
    box-sizing: border-box;
    background-color: var(--surface-raised, #ffffff);
    border: 1px solid var(--border-subtle, #d7d9df);
    padding: var(--space-20, 20px) var(--space-24, 24px);
    display: flex;
    flex-direction: column;
    gap: var(--space-4, 4px);
    z-index: 60;
  }

  .disclosure-panel {
    position: absolute;
    top: 100%;
    left: 0;
    width: 360px;
  }

  .panel-eyebrow {
    margin: 0;
    font-size: 10px;
    line-height: 1.5;
    color: var(--text-link, #53658e);
  }

  .panel-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4, 4px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .panel-link {
    display: block;
    width: 100%;
    box-sizing: border-box;
    min-height: 44px;
    padding: var(--space-12, 12px) 0;
    color: var(--text-primary, #24354f);
    font-size: 14px;
    line-height: 1.5;
    text-decoration: none;
  }

  .panel-link:hover {
    color: var(--text-link, #53658e);
  }

  .panel-link[aria-current='page'] {
    color: var(--text-link, #53658e);
    text-decoration: underline;
    text-underline-offset: var(--space-4, 4px);
  }

  .mobile-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-4, 4px);
  }

  .mobile-cta {
    justify-content: flex-start;
    width: 100%;
    min-height: 44px;
    padding: var(--space-12, 12px) var(--space-16, 16px);
  }

  .mobile-menu {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    width: 100%;
  }

  /* Compact toggle */
  .menu-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--space-8, 8px);
    min-height: 44px;
    box-sizing: border-box;
    padding: var(--space-12, 12px) 0;
    border: none;
    background: none;
    color: var(--text-primary, #24354f);
    font: inherit;
    font-size: 14px;
    line-height: 1.55;
    cursor: pointer;
  }

  .menu-toggle__icon {
    font-size: 18px;
    line-height: 1;
  }

  /* Hidden until JS can drive it: without JS the mobile menu is shown statically. */
  .site-header:not([data-enhanced]) .menu-toggle {
    display: none;
  }

  /* Panels dissolve over 160ms when JS controls them; they stay in the layout. */
  .site-header[data-enhanced] .disclosure-panel,
  .site-header[data-enhanced] .mobile-menu {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--dur-disclosure, 160ms) ease-out,
      visibility var(--dur-disclosure, 160ms) ease-out;
  }

  .site-header[data-enhanced] .disclosure-panel.is-open,
  .site-header[data-enhanced] .mobile-menu.is-open {
    opacity: 1;
    visibility: visible;
  }

  /* Without JS the panels flow inside the header instead of overlaying the page. */
  .site-header:not([data-enhanced]) .nav-item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .site-header:not([data-enhanced]) .disclosure-panel {
    position: static;
    width: auto;
    border: none;
    padding: 0;
  }

  .site-header:not([data-enhanced]) .mobile-menu {
    position: static;
    border: none;
  }

  /* Compact layout: primary links and the bar CTA are replaced by the toggle. */
  @media (max-width: 1023.98px) {
    .site-header[data-enhanced] .menu-toggle {
      display: inline-flex;
    }

    .site-header[data-enhanced] .mobile-menu {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
    }
  }

  /* Desktop: disclosures and CTA replace the compact menu. */
  @media (min-width: 1024px) {
    .site-nav {
      display: block;
    }

    .nav-cta {
      display: inline-flex;
    }

    .menu-toggle,
    .mobile-menu {
      display: none;
    }

  }

  @media (prefers-reduced-motion: reduce) {
    .site-header[data-enhanced] .disclosure-panel,
    .site-header[data-enhanced] .mobile-menu {
      transition: none;
    }
  }
</style>

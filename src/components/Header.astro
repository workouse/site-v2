---
const logoURL = "https://avatars.githubusercontent.com/u/55496985?s=400&u=cf5cb2d74029d653813b39d624e44b8f74bc63c1&v=4";
---

<header class="sticky top-0 w-full z-50 border-b border-zinc-900 bg-zinc-950/70 backdrop-blur-md">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    
    <!-- Logo & Name -->
    <a href="#" class="flex items-center gap-2.5 group transition">
      <div class="relative w-8 h-8 rounded-md overflow-hidden border border-zinc-800 group-hover:border-brand-yellow/50 transition duration-300">
        <img 
          src={logoURL} 
          alt="Workouse Logo" 
          width="32"
          height="32"
          class="w-full h-full object-cover group-hover:scale-105 transition duration-300"
          loading="eager"
        />
      </div>
      <span class="font-display font-bold text-lg tracking-wider bg-gradient-to-r from-zinc-50 to-zinc-400 bg-clip-text text-transparent group-hover:from-zinc-50 group-hover:to-brand-yellow transition duration-300">
        WORKOUSE
      </span>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-8">
      <a href="#engineer" class="text-sm font-medium text-zinc-400 hover:text-zinc-50 transition duration-200">The Engineer</a>
      <a href="#competencies" class="text-sm font-medium text-zinc-400 hover:text-zinc-50 transition duration-200">Competencies</a>
      <a href="#expertise" class="text-sm font-medium text-zinc-400 hover:text-zinc-50 transition duration-200">Expertise</a>
      <a href="#contact" class="text-sm font-medium text-zinc-400 hover:text-zinc-50 transition duration-200">Contact</a>
    </nav>

    <!-- Header Action Button -->
    <div class="hidden md:block">
      <a 
        href="#contact" 
        class="inline-flex items-center justify-center px-6 py-2 rounded-full text-xs font-semibold tracking-wider uppercase bg-brand-yellow text-zinc-950 border border-brand-yellow hover:bg-transparent hover:text-brand-yellow hover:shadow-[0_0_15px_rgba(254,197,0,0.15)] transition-all duration-300"
      >
        Let's Build
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <button 
      id="mobile-menu-toggle"
      class="md:hidden p-2 text-zinc-400 hover:text-zinc-50 transition duration-200 focus:outline-none"
      aria-label="Toggle navigation menu"
    >
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
      </svg>
    </button>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <div 
    id="mobile-menu"
    class="hidden md:hidden border-b border-zinc-900 bg-zinc-950 px-4 py-4 space-y-3 shadow-lg absolute w-full left-0 transition duration-300"
  >
    <a href="#engineer" class="mobile-nav-link block px-3 py-2 rounded-md text-base font-medium text-zinc-400 hover:text-zinc-50 hover:bg-zinc-900 transition">The Engineer</a>
    <a href="#competencies" class="mobile-nav-link block px-3 py-2 rounded-md text-base font-medium text-zinc-400 hover:text-zinc-50 hover:bg-zinc-900 transition">Competencies</a>
    <a href="#expertise" class="mobile-nav-link block px-3 py-2 rounded-md text-base font-medium text-zinc-400 hover:text-zinc-50 hover:bg-zinc-900 transition">Expertise</a>
    <a href="#contact" class="mobile-nav-link block px-3 py-2 rounded-md text-base font-medium text-zinc-400 hover:text-zinc-50 hover:bg-zinc-900 transition">Contact</a>
    <div class="pt-2">
      <a 
        href="#contact" 
        class="mobile-nav-link block w-full text-center px-4 py-2.5 rounded-md text-sm font-semibold uppercase tracking-wider bg-brand-yellow text-zinc-950 transition"
      >
        Let's Build Together
      </a>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');
  const navLinks = document.querySelectorAll('.mobile-nav-link');

  if (toggleBtn && mobileMenu && menuIcon) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = mobileMenu.classList.contains('hidden');
      if (isExpanded) {
        mobileMenu.classList.remove('hidden');
        menuIcon.setAttribute('d', 'M6 18L18 6M6 6l12 12');
      } else {
        mobileMenu.classList.add('hidden');
        menuIcon.setAttribute('d', 'M4 6h16M4 12h16m-7 6h7');
      }
    });

    // Close mobile menu on clicking any link
    navLinks.forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
        menuIcon.setAttribute('d', 'M4 6h16M4 12h16m-7 6h7');
      });
    });
  }
</script>

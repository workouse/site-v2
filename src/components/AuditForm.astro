---
// Workouse Audit Tool — Interactive Audit Request Form
---

<div class="relative max-w-xl mx-auto w-full">
  <!-- Glowing subtle backdrop -->
  <div class="absolute -inset-1 bg-gradient-to-r from-brand-yellow/20 via-brand-blue/20 to-brand-yellow/10 rounded-3xl blur-xl opacity-60 transition duration-500"></div>

  <div class="relative glow-card p-6 sm:p-10 rounded-3xl bg-white/90 dark:bg-zinc-950/90 border border-zinc-200 dark:border-zinc-800 shadow-xl dark:shadow-2xl backdrop-blur-xl">
    <div class="space-y-4 text-center sm:text-left mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-yellow/10 border border-brand-yellow/30 text-amber-600 dark:text-brand-yellow text-xs font-mono font-semibold tracking-wider uppercase">
        <span class="w-2 h-2 rounded-full bg-brand-yellow animate-ping"></span>
        30-Second Website Diagnostic
      </div>
      <h2 class="font-display text-2xl sm:text-3xl font-extrabold text-zinc-950 dark:text-white tracking-tight">
        Get Your Website Health & Repair Cost Breakdown
      </h2>
      <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 font-sans leading-relaxed">
        We analyze your mobile loading speed, security vulnerabilities, and Google search visibility, calculating exact fixed-rate repair costs based on our flat <span class="text-brand-blue dark:text-brand-yellow font-mono font-bold">$35/hr</span> engineering rate.
      </p>

      <!-- 3 Key Deliverables Pills -->
      <div class="grid grid-cols-3 gap-2 pt-1 text-[10px] font-mono font-semibold text-zinc-700 dark:text-zinc-300">
        <div class="p-2 rounded-lg bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-center">
          ⚡ Speed & LCP
        </div>
        <div class="p-2 rounded-lg bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-center">
          🛡️ Security & Privacy
        </div>
        <div class="p-2 rounded-lg bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-center">
          💵 $35/hr Action Plan
        </div>
      </div>
    </div>

    <!-- Audit Form -->
    <form id="auditForm" class="space-y-4">
      <div>
        <label for="auditUrl" class="block text-xs font-mono uppercase tracking-wider text-zinc-600 dark:text-zinc-400 mb-2">
          Website URL
        </label>
        <div class="relative">
          <input
            type="text"
            id="auditUrl"
            name="url"
            placeholder="example.com"
            required
            class="w-full px-4 py-3.5 bg-zinc-50 dark:bg-zinc-900/90 border border-zinc-300 dark:border-zinc-800 rounded-xl text-zinc-950 dark:text-white placeholder-zinc-400 dark:placeholder-zinc-500 text-sm font-mono focus:outline-none focus:border-brand-yellow focus:ring-1 focus:ring-brand-yellow transition duration-200"
          />
        </div>
      </div>

      <div>
        <div class="flex items-center justify-between mb-2">
          <label for="auditEmail" class="block text-xs font-mono uppercase tracking-wider text-zinc-600 dark:text-zinc-400">
            Work Email
          </label>
          <span class="text-[10px] font-mono text-zinc-500">For 1-click verification link</span>
        </div>
        <input
          type="email"
          id="auditEmail"
          name="email"
          placeholder="you@company.com"
          required
          class="w-full px-4 py-3.5 bg-zinc-50 dark:bg-zinc-900/90 border border-zinc-300 dark:border-zinc-800 rounded-xl text-zinc-950 dark:text-white placeholder-zinc-400 dark:placeholder-zinc-500 text-sm font-mono focus:outline-none focus:border-brand-yellow focus:ring-1 focus:ring-brand-yellow transition duration-200"
        />
      </div>

      <!-- Feedback Banner -->
      <div id="formFeedback" class="hidden p-4 rounded-xl text-xs font-mono"></div>

      <!-- Submit Button -->
      <button
        type="submit"
        id="submitBtn"
        class="w-full py-4 px-6 rounded-xl font-mono font-bold text-xs uppercase tracking-wider bg-brand-yellow text-zinc-950 hover:bg-yellow-400 active:scale-[0.99] transition duration-200 flex items-center justify-center gap-2 shadow-lg shadow-brand-yellow/10"
      >
        <span id="btnText">Run Free Website Audit →</span>
        <svg id="btnSpinner" class="hidden animate-spin h-4 w-4 text-zinc-950" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
      </button>

      <div class="pt-2 text-center space-y-1">
        <p class="text-[11px] text-zinc-500 font-mono flex items-center justify-center gap-1.5">
          <span>🔒 Spam Protection: 1-click verification link sent to prevent automated bots.</span>
        </p>
      </div>
    </form>
  </div>
</div>

<script>
  import { trackEvent, trackAuditRequested } from '../lib/analytics';
  import { validateAuditUrl } from '../lib/url-validator';

  const form = document.getElementById('auditForm') as HTMLFormElement | null;
  const feedback = document.getElementById('formFeedback');
  const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement | null;
  const btnText = document.getElementById('btnText');
  const btnSpinner = document.getElementById('btnSpinner');

  if (form && feedback && submitBtn && btnText && btnSpinner) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      feedback.classList.add('hidden');
      feedback.className = 'hidden p-4 rounded-xl text-xs font-mono';

      const formData = new FormData(form);
      const url = formData.get('url')?.toString() || '';
      const email = formData.get('email')?.toString() || '';

      // Instant client-side URL validation
      const localCheck = await validateAuditUrl(url, { checkDns: false });
      if (!localCheck.isValid) {
        feedback.textContent = `⚠️ ${localCheck.error || 'Please provide a valid website URL.'}`;
        feedback.classList.remove('hidden');
        feedback.classList.add('bg-red-500/10', 'border', 'border-red-500/30', 'text-red-400');
        return;
      }

      submitBtn.disabled = true;
      btnText.textContent = 'Verifying domain...';
      btnSpinner.classList.remove('hidden');

      // Track audit request event
      trackAuditRequested({
        targetUrl: url,
        hasEmail: Boolean(email),
        source: 'hero_form',
      });

      try {
        const res = await fetch('/api/audit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ url, email }),
        });

        const data: any = await res.json();

        if (!res.ok) {
          throw new Error(data.error || 'Failed to initiate audit.');
        }

        if (data.redirectUrl) {
          feedback.textContent = data.cached
            ? `⚡ ${data.message} Opening report...`
            : `✅ ${data.message}`;
          feedback.classList.remove('hidden');
          feedback.classList.add('bg-emerald-500/10', 'border', 'border-emerald-500/30', 'text-emerald-400');
          form.reset();

          setTimeout(() => {
            window.location.href = data.redirectUrl;
          }, 1200);
          return;
        }

        feedback.textContent = `✅ ${data.message}`;
        feedback.classList.remove('hidden');
        feedback.classList.add('bg-emerald-500/10', 'border', 'border-emerald-500/30', 'text-emerald-400');
        form.reset();

        if (data.verifyUrlDev) {
          console.log('[DEV ONLY] Verification link:', data.verifyUrlDev);
        }
      } catch (err: any) {
        feedback.textContent = `⚠️ ${err.message}`;
        feedback.classList.remove('hidden');
        feedback.classList.add('bg-red-500/10', 'border', 'border-red-500/30', 'text-red-400');
      } finally {
        submitBtn.disabled = false;
        btnText.textContent = 'Initiate Free Audit →';
        btnSpinner.classList.add('hidden');
      }
    });
  }
</script>

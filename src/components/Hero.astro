---
---

<section class="relative min-h-[85vh] flex items-center justify-center overflow-hidden py-20 px-4 sm:px-6 lg:px-8">
  <!-- Glowing decorative orbs -->
  <div class="absolute top-1/4 left-1/4 w-[300px] h-[300px] bg-brand-blue/10 blur-[80px] rounded-full animate-pulse-slow"></div>
  <div class="absolute bottom-1/4 right-1/4 w-[250px] h-[250px] bg-brand-yellow/5 blur-[80px] rounded-full animate-pulse-slow" style="animation-delay: 2s;"></div>

  <div class="max-w-4xl mx-auto text-center relative z-10">
    <!-- Premium Badge -->
    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-zinc-800 bg-zinc-900/40 backdrop-blur-md mb-8 animate-fade-in">
      <span class="w-1.5 h-1.5 rounded-full bg-brand-yellow animate-pulse"></span>
      <span class="text-[10px] font-mono font-semibold tracking-wider text-zinc-400 uppercase">
        Boutique Solo Development House
      </span>
    </div>

    <!-- Main Title -->
    <h1 class="font-display text-4xl sm:text-6xl md:text-7xl font-bold tracking-tight text-white leading-[1.08] mb-8">
      Elite Fullstack Engineering <br class="hidden sm:inline" />
      <span class="bg-gradient-to-r from-brand-yellow via-zinc-100 to-zinc-400 bg-clip-text text-transparent">
        for Scale.
      </span>
    </h1>

    <!-- Subheadline -->
    <p class="font-sans text-lg sm:text-xl text-zinc-400 leading-relaxed max-w-2xl mx-auto mb-12">
      Workouse is a boutique, solo software development house building resilient, high-scale web applications for forward-thinking companies in Europe and the US. <span class="text-zinc-100 font-medium">Engineered by a 15+ year veteran.</span>
    </p>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <!-- Primary CTA -->
      <a 
        href="#contact" 
        class="group relative w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 rounded-full text-sm font-semibold uppercase tracking-wider bg-brand-yellow text-zinc-950 hover:bg-zinc-950 hover:text-brand-yellow border-2 border-brand-yellow transition-all duration-300 hover:shadow-[0_0_25px_rgba(254,197,0,0.25)]"
      >
        <span>Let's Build Together</span>
        <svg 
          class="w-4 h-4 ml-2 transition-transform duration-300 group-hover:translate-x-1" 
          fill="none" 
          viewBox="0 0 24 24" 
          stroke="currentColor"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>

      <!-- Secondary CTA -->
      <a 
        href="https://github.com/workouse" 
        target="_blank" 
        rel="noopener noreferrer"
        class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 rounded-full text-sm font-semibold uppercase tracking-wider text-zinc-300 hover:text-white border border-zinc-800 hover:border-zinc-700 bg-zinc-900/30 hover:bg-zinc-900/70 backdrop-blur-sm transition-all duration-300"
      >
        <span>Explore Open Source</span>
        <svg 
          class="w-4.5 h-4.5 ml-2.5 opacity-60 hover:opacity-100" 
          viewBox="0 0 24 24" 
          fill="currentColor"
        >
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482C19.138 20.193 22 16.44 22 12.017 22 6.484 17.522 2 12 2z" />
        </svg>
      </a>
    </div>
  </div>

  <!-- Decorative bottom arrow scroll-indicator -->
  <div class="absolute bottom-6 left-1/2 -translate-x-1/2 flex flex-col items-center gap-1.5 opacity-40 hover:opacity-100 transition duration-300">
    <span class="text-[9px] font-mono tracking-widest uppercase text-zinc-500">Scroll</span>
    <svg class="w-4 h-4 text-zinc-400 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
    </svg>
  </div>
</section>

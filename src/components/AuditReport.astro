</div>

<script>
  import { trackEvent } from '../lib/analytics';

  const reportContainer = document.getElementById('auditReportContainer');
  if (reportContainer) {
    const ds = reportContainer.dataset;
    trackEvent('audit-viewed', {
      audit_id: ds.auditId,
      target_url: ds.url,
      score: ds.score ? Number(ds.score) : undefined,
      performance_score: ds.perf ? Number(ds.perf) : undefined,
      security_score: ds.security ? Number(ds.security) : undefined,
      seo_score: ds.seo ? Number(ds.seo) : undefined,
      standards_score: ds.standards ? Number(ds.standards) : undefined,
      recommendation: ds.rec,
    });
  }

  const bottomQuoteBtn = document.getElementById('report-bottom-quote-btn');
  const leadModal = document.getElementById('lead-modal') as HTMLDialogElement | null;
  bottomQuoteBtn?.addEventListener('click', () => {
    trackEvent('request-quote-form-opened', { source: 'report_bottom' });
    leadModal?.showModal();
  });

  // Dual View Mode Controller
  const btnExecutive = document.getElementById('btn-view-executive') as HTMLButtonElement | null;
  const btnTechnical = document.getElementById('btn-view-technical') as HTMLButtonElement | null;
  const btnJumpTech = document.getElementById('btn-jump-to-technical') as HTMLButtonElement | null;
  const techAccordion = document.getElementById('detailed-diagnostics-accordion') as HTMLDetailsElement | null;
  const executiveSection = document.getElementById('section-executive-view');

  function setExecutiveView() {
    if (btnExecutive && btnTechnical) {
      btnExecutive.className = 'flex-1 sm:flex-initial px-4 py-2 rounded-lg font-bold transition flex items-center justify-center gap-2 bg-brand-blue text-white dark:bg-brand-yellow dark:text-zinc-950 shadow-sm';
      btnTechnical.className = 'flex-1 sm:flex-initial px-4 py-2 rounded-lg font-bold transition flex items-center justify-center gap-2 text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-white';
    }
    if (techAccordion) {
      techAccordion.open = false;
    }
    executiveSection?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    trackEvent('audit-view-switched', { view: 'executive' });
  }

  function setTechnicalView() {
    if (btnExecutive && btnTechnical) {
      btnTechnical.className = 'flex-1 sm:flex-initial px-4 py-2 rounded-lg font-bold transition flex items-center justify-center gap-2 bg-brand-blue text-white dark:bg-brand-yellow dark:text-zinc-950 shadow-sm';
      btnExecutive.className = 'flex-1 sm:flex-initial px-4 py-2 rounded-lg font-bold transition flex items-center justify-center gap-2 text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-white';
    }
    if (techAccordion) {
      techAccordion.open = true;
      setTimeout(() => {
        techAccordion.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }, 50);
    }
    trackEvent('audit-view-switched', { view: 'technical' });
  }

  btnExecutive?.addEventListener('click', setExecutiveView);
  btnTechnical?.addEventListener('click', setTechnicalView);
  btnJumpTech?.addEventListener('click', setTechnicalView);

  // Sync tab styles if user opens the accordion manually
  techAccordion?.addEventListener('toggle', () => {
    if (techAccordion.open) {
      if (btnExecutive && btnTechnical) {
        btnTechnical.className = 'flex-1 sm:flex-initial px-4 py-2 rounded-lg font-bold transition flex items-center justify-center gap-2 bg-brand-blue text-white dark:bg-brand-yellow dark:text-zinc-950 shadow-sm';
        btnExecutive.className = 'flex-1 sm:flex-initial px-4 py-2 rounded-lg font-bold transition flex items-center justify-center gap-2 text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-white';
      }
    }
  });
</script>

---
import type { AuditIssue, ModernizationReport, ExecutiveBriefing, DataRegulationDiagnostics } from '../lib/types';
import { parseStoryToBriefing } from '../lib/story-engine';
import { detectSiteJurisdiction, type DetectedJurisdiction } from '../lib/jurisdiction-engine';
import AuditReportActions from './AuditReportActions.astro';
import AuditLeadModal from './AuditLeadModal.astro';
import ModernizationChecklist from './ModernizationChecklist.astro';
import DistributedWebReport from './DistributedWebReport.astro';

const logoURL = "https://avatars.githubusercontent.com/u/55496985?s=400&u=cf5cb2d74029d653813b39d624e44b8f74bc63c1&v=4";

interface Props {
  audit: {
    id: string;
    url: string;
    status: string;
    createdAt: number;
    completedAt: number | null;
  };
  aiOutput: {
    score: number;
    performanceScore: number;
    securityScore: number;
    seoScore: number;
    standardsScore: number;
    issues: AuditIssue[];
    recommendation: 'fix' | 'rebuild';
    recommendationReason: string;
    summary: string;
    story?: string;
    executiveBriefing?: ExecutiveBriefing;
    processedAt: number;
    modernizationReport?: ModernizationReport;
    regulation?: DataRegulationDiagnostics;
  };
}

const { audit, aiOutput } = Astro.props;

const totalFixMinutes = aiOutput.issues.reduce((sum, item) => sum + item.estimatedMinutes, 0);
const totalFixHours = Math.round((totalFixMinutes / 60) * 10) / 10;
const totalPrice = Math.ceil(aiOutput.issues.reduce((sum, item) => sum + (item.price || 0), 0));

const criticalIssues = aiOutput.issues.filter(i => i.severity === 'critical');
const warningIssues = aiOutput.issues.filter(i => i.severity === 'warning');
const infoIssues = aiOutput.issues.filter(i => i.severity === 'info');

// Parse structured 3-card executive briefing
const briefing: ExecutiveBriefing = aiOutput.executiveBriefing || parseStoryToBriefing(aiOutput.story || aiOutput.summary, {
  url: audit.url,
  scores: {
    overall: aiOutput.score,
    performance: aiOutput.performanceScore,
    security: aiOutput.securityScore,
    seo: aiOutput.seoScore,
    standards: aiOutput.standardsScore,
  },
  issues: aiOutput.issues,
  recommendation: aiOutput.recommendation,
  platform: aiOutput.modernizationReport?.techStack?.platform,
  platformVersion: aiOutput.modernizationReport?.techStack?.platformVersion,
  detectedExtensionsCount: aiOutput.modernizationReport?.techStack?.detectedExtensions?.length,
  isWafBlocked: aiOutput.modernizationReport?.isWafBlocked,
});

// Top 3 highest impact priorities to fix first
const topPriorities = [...aiOutput.issues]
  .sort((a, b) => {
    const sevOrder: Record<string, number> = { critical: 0, warning: 1, info: 2 };
    const sevDiff = (sevOrder[a.severity] ?? 2) - (sevOrder[b.severity] ?? 2);
    if (sevDiff !== 0) return sevDiff;
    return (b.price || 0) - (a.price || 0);
  })
  .slice(0, 3);

const scoreColor = aiOutput.score >= 80 ? 'text-emerald-400 border-emerald-500/30 bg-emerald-500/10'
  : aiOutput.score >= 60 ? 'text-amber-400 border-amber-500/30 bg-amber-500/10'
  : 'text-red-400 border-red-500/30 bg-red-500/10';

function subScoreColor(score: number): string {
  if (score >= 80) return 'text-emerald-400 bg-emerald-500/10 border-emerald-500/20';
  if (score >= 60) return 'text-amber-400 bg-amber-500/10 border-amber-500/20';
  return 'text-red-400 bg-red-500/10 border-red-500/20';
}

function getIssueProof(issue: AuditIssue): string {
  if (issue.proof) return issue.proof;
  const fallbacks: Record<string, string> = {
    'slow-lcp': 'PageSpeed Insights Core Web Vital: LCP measured in field or lab data',
    'poor-fid': 'PageSpeed Insights Core Web Vital: Total Blocking Time (TBT) / INP',
    'poor-cls': 'PageSpeed Insights Core Web Vital: Cumulative Layout Shift (CLS)',
    'large-images': 'Asset Audit: Unoptimized image payloads exceeding 100KB',
    'render-blocking-js': 'Asset Audit: Synchronous \u003Cscript\u003E tags delaying first paint',
    'no-gzip': 'Network Audit: Static assets delivered without gzip or brotli compression',
    'no-robots-txt': 'Crawlability Audit: robots.txt file returned 404 or was empty',
    'missing-schema-org': 'Structured Data Audit: No schema.org JSON-LD found in DOM',
    'invalid-title-length': 'SEO Audit: <title> tag is missing or exceeds 60 characters',
    'invalid-meta-description-length': 'SEO Audit: <meta name="description"> tag is missing or exceeds 160 characters',
    'multiple-h1': 'DOM Audit: Page contains multiple or zero <h1> headings',
    'missing-og-image': 'Social Audit: <meta property="og:image"> tag missing',
    'missing-csp': 'Security Audit: Content-Security-Policy header not provided by origin',
    'missing-hsts': 'Security Audit: Strict-Transport-Security header missing on HTTPS host',
    'missing-x-frame-options': 'Security Audit: X-Frame-Options header missing (clickjacking risk)',
    'missing-referrer-policy': 'Security Audit: Referrer-Policy header not set to safe default',
    'missing-nosniff': 'Security Audit: X-Content-Type-Options: nosniff header missing',
    'missing-permissions-policy': 'Security Audit: Permissions-Policy header missing',
    'legacy-stack-migration': 'Tech Stack Audit: End-of-life monolithic CMS or backend detected',
    'edge-serverless-migration': 'Infrastructure Audit: Monolithic server infrastructure without edge SSR caching',
    'css-modernization': 'Styling Audit: Legacy CSS framework detected (e.g. Bootstrap 3/4, jQuery UI)',
    'missing-image-alt': 'Accessibility Audit: Image elements missing alt text',
    'missing-charset': 'DOM Audit: <meta charset> tag missing in head',
    'missing-lang': 'DOM Audit: <html lang="..."> attribute missing',
    'missing-viewport': 'Mobile Audit: Viewport meta tag missing',
    'observatory-low-grade': 'Mozilla HTTP Observatory: Host received grade F/D/C',
    'pa11y-wcag-violations': 'Pa11y WCAG 2.1 AA Audit: Found accessibility rule violations',
    'mobile-layout-overflow': 'Mobile Viewport Audit: Content horizontally overflows 375px viewport',
    'tiny-touch-targets': 'Mobile UX Audit: Touch target bounding rects smaller than 44x44px',
    'illegible-mobile-text': 'Mobile UX Audit: Text element computed font size less than 12px',
    'disabled-viewport-zoom': 'Mobile Viewport Audit: Meta tag user-scalable=no or maximum-scale=1',
    'broken-heading-hierarchy': 'Heading Hierarchy Audit: Skipped heading levels (e.g. H1 to H3) detected in DOM outline',
    'missing-semantic-landmarks': 'Semantic Structure Audit: Document missing standard <header>, <nav>, <main>, or <footer> tags',
    'poor-url-structure': 'URL Quality Audit: Permalink exceeds 75 chars or contains non-standard casing/underscores',
    'poor-image-alt-text': 'Alt Text Quality Audit: Image descriptions contain generic filenames or redundant "image of" phrases',
    'missing-breadcrumbs-schema': 'Structured Data Audit: Missing BreadcrumbList JSON-LD for rich search engine result snippets',
    'accidental-noindex': 'Robots & Crawlability Audit: <meta name="robots" content="noindex"> tag or header is blocking search indexing',
    'au-missing-privacy-policy': 'Australian Privacy Act Audit: No Privacy Policy or APP disclosure found in footer/header',
    'au-missing-terms-acl': 'Australian Consumer Law (ACL) Audit: Missing commercial terms & consumer guarantee terms',
    'au-missing-abn-disclosure': 'Corporations Act Audit: Missing Australian Business Number (ABN/ACN) in footer',
    'au-unconsented-trackers': 'APPs Privacy Audit: Analytics & marketing trackers loaded without consent transparency',
    'tr-missing-kvkk-notice': 'KVKK Denetimi: Sitede KVKK Aydınlatma Metni veya Gizlilik Politikası tespit edilemedi',
    'tr-missing-mersis-kunye': 'TTK & ETBİS Denetimi: MERSİS numarası veya Şirket Künyesi bilgisi bulunamadı',
    'tr-missing-ecommerce-terms': 'E-Ticaret Denetimi: Kullanım Koşulları veya Mesafeli Satış Sözleşmesi eksik',
    'tr-missing-cookie-policy': 'KVKK Çerez Denetimi: Açık Çerez Politikası veya bilgilendirme metni bulunamadı',
    'tr-unconsented-trackers': 'KVKK Veri Güvenliği: Açık rıza alınmadan çalışan üçüncü taraf izleyiciler',
    'eu-missing-privacy-policy': 'GDPR Audit: No Privacy Policy link found in footer/header',
    'eu-unconsented-trackers': 'ePrivacy Audit: Third-party scripts executed without consent banner',
    'eu-missing-impressum': 'E-Commerce Audit: Missing Impressum / Legal Notice link',
    'eu-external-font-transfer': 'Privacy Audit: Remote Google Fonts asset request detected',
    'gb-missing-privacy-notice': 'UK GDPR Audit: Missing UK Privacy Notice in page navigation',
    'gb-missing-company-number': 'Companies Act 2006 Audit: Missing UK Company Registration Number',
    'us-ccpa-missing-optout': 'CCPA/CPRA Audit: Missing Do Not Sell / Your Privacy Choices link',
    'us-missing-terms': 'Commercial Audit: Missing Terms of Service link',
    'ca-missing-privacy-policy': 'PIPEDA Audit: Missing Canadian Privacy Policy disclosure',
    'ca-missing-terms': 'Canadian Consumer Audit: Missing Terms of Service',
    'global-missing-privacy-policy': 'Privacy Standard: Missing standard Privacy Policy link',
    'global-missing-terms': 'Commercial Standard: Missing standard Terms of Service',
    'missing-ucp': 'Universal Commerce Protocol Audit: Online storefront detected, but /.well-known/ucp discovery manifest was not found or is missing',
  };
  return fallbacks[issue.id] || `Automated audit rule trigger (${issue.category} check by PageSpeed/DOM analyzer)`;
}

const categoryDisplayNames: Record<string, string> = {
  Performance: 'Speed & Smoothness',
  Security: 'Safety & Protection',
  SEO: 'Google Visibility',
  Standards: 'Mobile Best Practices',
};

const subScores = [
  { label: categoryDisplayNames['Performance'], value: aiOutput.performanceScore },
  { label: categoryDisplayNames['Security'],    value: aiOutput.securityScore },
  { label: categoryDisplayNames['SEO'],         value: aiOutput.seoScore },
  { label: categoryDisplayNames['Standards'],   value: aiOutput.standardsScore },
];

const jurisdiction: DetectedJurisdiction =
  aiOutput.regulation?.jurisdiction ||
  aiOutput.modernizationReport?.regulation?.jurisdiction ||
  detectSiteJurisdiction('', audit.url);

const regionalIssues = aiOutput.issues.filter((i) =>
  i.id.startsWith('au-') ||
  i.id.startsWith('tr-') ||
  i.id.startsWith('eu-') ||
  i.id.startsWith('us-') ||
  i.id.startsWith('gb-') ||
  i.id.startsWith('ca-') ||
  i.id.startsWith('global-')
);
---

<div
  id="auditReportContainer"
  class="max-w-5xl mx-auto space-y-8"
  data-audit-id={audit.id}
  data-url={audit.url}
  data-score={aiOutput.score}
  data-perf={aiOutput.performanceScore}
  data-security={aiOutput.securityScore}
  data-seo={aiOutput.seoScore}
  data-standards={aiOutput.standardsScore}
  data-rec={aiOutput.recommendation}
>

  <!-- Action Toolbar (PDF Export, Share Link, Request Quote) -->
  <AuditReportActions auditId={audit.id} />

  <!-- Dual-View Switcher (Executive Briefing vs Deep Diagnostics) -->
  <div class="flex flex-col sm:flex-row items-center justify-between gap-3 p-2 bg-zinc-100/90 dark:bg-zinc-900/90 rounded-2xl border border-zinc-200 dark:border-zinc-800 shadow-sm backdrop-blur-xl">
    <div class="flex items-center gap-1.5 w-full sm:w-auto p-1 bg-white dark:bg-zinc-950 rounded-xl border border-zinc-200 dark:border-zinc-800 text-xs font-mono">
      <button
        type="button"
        id="btn-view-executive"
        class="flex-1 sm:flex-initial px-4 py-2 rounded-lg font-bold transition flex items-center justify-center gap-2 bg-brand-blue text-white dark:bg-brand-yellow dark:text-zinc-950 shadow-sm"
      >
        <span>👔</span>
        <span>Executive Briefing</span>
      </button>
      <button
        type="button"
        id="btn-view-technical"
        class="flex-1 sm:flex-initial px-4 py-2 rounded-lg font-bold transition flex items-center justify-center gap-2 text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-white"
      >
        <span>🛠️</span>
        <span>Deep Diagnostics</span>
        <span class="px-1.5 py-0.5 rounded text-[10px] bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 font-normal">5 Modules</span>
      </button>
    </div>

    <div class="text-[11px] font-mono text-zinc-500 dark:text-zinc-400 flex items-center gap-2 px-3 py-1">
      <span>Flat Repair Rate:</span>
      <span class="font-bold text-brand-blue dark:text-brand-yellow">$35.00/hr</span>
    </div>
  </div>

  <!-- Website Screenshot & Browser Preview -->
  <div class="glow-card rounded-3xl bg-white/90 dark:bg-zinc-950/90 border border-zinc-200 dark:border-zinc-800 shadow-xl dark:shadow-2xl overflow-hidden transition-colors duration-300">
    <!-- Browser Window Titlebar with Viewport Switcher -->
    <div class="flex flex-col sm:flex-row items-center justify-between px-4 py-3 bg-zinc-100 dark:bg-zinc-900/90 border-b border-zinc-200 dark:border-zinc-800 text-xs font-mono text-zinc-600 dark:text-zinc-400 gap-2">
      <div class="flex items-center gap-2">
        <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
        <div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
        <div class="w-3 h-3 rounded-full bg-green-500/80"></div>
      </div>
      <div class="flex-1 mx-2 sm:mx-4 bg-white dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 rounded-full px-3 py-1 text-center truncate text-[11px] text-zinc-700 dark:text-zinc-400 font-sans flex items-center justify-center gap-1.5 w-full sm:w-auto">
        <svg class="w-3.5 h-3.5 text-emerald-500 dark:text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
        <span class="truncate">{audit.url}</span>
      </div>
      <!-- Dual Viewport Switcher -->
      <div class="flex items-center gap-1 bg-white dark:bg-zinc-950 p-1 rounded-lg border border-zinc-200 dark:border-zinc-800 shrink-0 text-[10px]">
        <button
          type="button"
          id="btn-viewport-desktop"
          onclick="document.getElementById('img-screenshot-desktop').classList.remove('hidden'); document.getElementById('img-screenshot-mobile').classList.add('hidden'); this.classList.add('bg-zinc-800', 'text-white'); document.getElementById('btn-viewport-mobile').classList.remove('bg-zinc-800', 'text-white');"
          class="px-2.5 py-1 rounded font-mono font-bold bg-zinc-800 text-white transition flex items-center gap-1"
        >
          🖥️ Desktop (1280px)
        </button>
        <button
          type="button"
          id="btn-viewport-mobile"
          onclick="document.getElementById('img-screenshot-mobile').classList.remove('hidden'); document.getElementById('img-screenshot-desktop').classList.add('hidden'); this.classList.add('bg-zinc-800', 'text-white'); document.getElementById('btn-viewport-desktop').classList.remove('bg-zinc-800', 'text-white');"
          class="px-2.5 py-1 rounded font-mono font-bold text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-white transition flex items-center gap-1"
        >
          📱 Mobile (375px)
        </button>
      </div>
    </div>

    <!-- Screenshot Image Container -->
    <div class="relative bg-zinc-900 aspect-video max-h-[440px] w-full overflow-hidden flex items-center justify-center p-2">
      <img
        id="img-screenshot-desktop"
        src={`/api/audit/${audit.id}/screenshot?type=desktop`}
        alt={`Desktop website screenshot preview for ${audit.url}`}
        class="w-full h-full object-cover object-top rounded"
        onerror="this.onerror=null; this.style.display='none'; this.nextElementSibling?.classList.remove('hidden');"
      />
      <img
        id="img-screenshot-mobile"
        src={`/api/audit/${audit.id}/screenshot?type=mobile`}
        alt={`Mobile website screenshot preview for ${audit.url}`}
        class="hidden h-full max-h-[420px] w-auto object-contain object-top rounded shadow-2xl border border-zinc-700"
        onerror="this.onerror=null; this.style.display='none';"
      />
      <div class="hidden p-8 text-center text-zinc-500 text-sm font-mono">
        Screenshot preview unavailable
      </div>
    </div>
  </div>

  <!-- Header Overview Card -->
  <div class="glow-card p-6 sm:p-10 rounded-3xl bg-white/90 dark:bg-zinc-950/90 border border-zinc-200 dark:border-zinc-800 shadow-xl dark:shadow-2xl backdrop-blur-xl relative overflow-hidden transition-colors duration-300">
    <!-- Ambient glow -->
    <div class="absolute -top-12 -right-12 sm:-top-24 sm:-right-24 w-48 h-48 sm:w-72 sm:h-72 bg-brand-yellow/10 rounded-full blur-2xl sm:blur-3xl pointer-events-none"></div>

    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6 relative z-10">
      <div class="space-y-3 min-w-0 flex-1">
        <div class="flex items-center gap-3 flex-wrap">
          <a href="/" class="inline-flex items-center gap-2 group transition shrink-0">
            <div class="w-7 h-7 rounded-md overflow-hidden border border-zinc-300 dark:border-zinc-800 group-hover:border-brand-blue dark:group-hover:border-brand-yellow/50 transition">
              <img src={logoURL} alt="Workouse Logo" width="28" height="28" class="w-full h-full object-cover" />
            </div>
            <span class="font-display font-bold text-sm tracking-wider text-zinc-950 dark:text-white group-hover:text-brand-blue dark:group-hover:text-brand-yellow transition">WORKOUSE</span>
          </a>
          <span class="text-zinc-300 dark:text-zinc-700">|</span>
          <span class="text-xs font-mono font-semibold uppercase tracking-wider text-brand-blue dark:text-brand-yellow px-2.5 py-0.5 rounded-full bg-brand-yellow/10 border border-brand-yellow/30">
            WEBSITE HEALTH REPORT
          </span>
          <span class="text-xs font-mono text-zinc-600 dark:text-zinc-500">ID: {audit.id}</span>
        </div>
        <h1 class="font-display text-2xl sm:text-4xl font-extrabold text-zinc-950 dark:text-white tracking-tight break-all sm:break-words">
          {audit.url}
        </h1>
        <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 font-sans">
          Simple English breakdown of your site's speed, search visibility, mobile readiness, and visitor experience.
        </p>
      </div>

      <!-- Score Gauge + Sub-Scores -->
      <div class="flex flex-col items-center gap-3 shrink-0 w-full sm:w-auto">
        <!-- Overall Score -->
        <div class={`w-28 h-28 rounded-2xl border-2 flex flex-col items-center justify-center p-2 ${scoreColor}`}>
          <span class="text-3xl font-extrabold font-mono tracking-tight">{aiOutput.score}</span>
          <span class="text-[10px] font-mono uppercase tracking-widest text-zinc-600 dark:text-zinc-400 mt-0.5">Overall Grade</span>
        </div>

        <!-- 4 Sub-score Pills -->
        <div class="grid grid-cols-2 gap-1.5 w-full">
          {subScores.map(({ label, value }) => (
            <div class={`flex items-center justify-between px-2 py-1 rounded-lg border text-[10px] font-mono font-bold ${subScoreColor(value)}`}>
              <span class="text-zinc-600 dark:text-zinc-400 font-normal">{label}</span>
              <span>{value}</span>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Recommendation Banner -->
    <div class="mt-8 p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-900/90 border border-zinc-200 dark:border-zinc-800 space-y-2">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
        <span class="text-xs font-mono font-bold uppercase tracking-wider text-zinc-600 dark:text-zinc-400">Recommended Next Step</span>
        {aiOutput.recommendation === 'rebuild' ? (
          <span class="px-3 py-1 rounded-full bg-red-500/10 border border-red-500/30 text-red-500 dark:text-red-400 font-mono font-bold text-xs self-start sm:self-auto">
            {aiOutput.modernizationReport?.platformContext === 'wordpress' ? '⚡ WordPress Modernization Recommended'
              : aiOutput.modernizationReport?.platformContext === 'shopify' ? '⚡ Shopify Optimization Recommended'
              : aiOutput.modernizationReport?.platformContext === 'wix' ? '⚡ Wix Studio / Webflow Upgrade'
              : aiOutput.modernizationReport?.platformContext === 'webflow' ? '⚡ Webflow Edge Tuning Recommended'
              : aiOutput.modernizationReport?.platformContext === 'magento' ? '⚡ Magento Hyvä Modernization'
              : '🚀 Architecture Modernization Recommended'}
          </span>
        ) : (
          <span class="px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-600 dark:text-emerald-400 font-mono font-bold text-xs self-start sm:self-auto">
            🛠️ Quick Fixes & Tune-Up Recommended
          </span>
        )}
      </div>
      <p class="text-xs sm:text-sm text-zinc-800 dark:text-zinc-300 font-sans leading-relaxed">
        {aiOutput.recommendationReason}
      </p>
    </div>
  </div>

  <!-- EXECUTIVE VIEW SECTION (Active by default) -->
  <div id="section-executive-view" class="space-y-8">

    <!-- Executive Briefing Hero Card (Verdict & 3-Card Grid) -->
    <div class="glow-card p-6 sm:p-10 rounded-3xl bg-white/95 dark:bg-zinc-950/95 border border-zinc-200 dark:border-zinc-800 shadow-xl dark:shadow-2xl relative overflow-hidden transition-colors duration-300 space-y-8">
      <div class="absolute -top-12 -right-12 w-64 h-64 bg-brand-blue/5 dark:bg-brand-yellow/5 rounded-full blur-3xl pointer-events-none"></div>

      <!-- Top Header & Verdict -->
      <div class="relative z-10 space-y-4 border-b border-zinc-200 dark:border-zinc-800/80 pb-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div class="flex items-center gap-2.5">
            <span class="w-2.5 h-2.5 rounded-full bg-brand-blue dark:bg-brand-yellow animate-pulse"></span>
            <span class="text-xs font-mono font-bold uppercase tracking-wider text-brand-blue dark:text-brand-yellow">
              Executive Briefing & Strategic Assessment
            </span>
          </div>
          <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400">
            Automated Consulting Vector
          </span>
        </div>

        <!-- 1-Sentence Executive Verdict Headline -->
        <h2 class="font-display text-lg sm:text-2xl font-bold text-zinc-950 dark:text-white leading-snug">
          "{briefing.headline}"
        </h2>
      </div>

      <!-- 3-Card Executive Grid (Bottlenecks, Opportunities, Resolution Roadmap) -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 relative z-10">

        <!-- Card 1: The Bottlenecks -->
        <div class="p-6 rounded-2xl bg-red-50/50 dark:bg-red-950/10 border border-red-200/80 dark:border-red-900/30 space-y-4 flex flex-col justify-between">
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="px-2.5 py-0.5 rounded text-[10px] font-mono font-bold uppercase tracking-wider bg-red-500/10 border border-red-500/30 text-red-600 dark:text-red-400">
                1. The Friction Points
              </span>
              <span class="text-lg">⚠️</span>
            </div>
            <h3 class="font-display text-base font-bold text-zinc-950 dark:text-white">
              Where You Lose Visitors
            </h3>
            <ul class="space-y-2.5 font-sans text-xs text-zinc-700 dark:text-zinc-300 leading-relaxed">
              {briefing.bottlenecks.map((item) => (
                <li class="flex items-start gap-2">
                  <span class="text-red-500 dark:text-red-400 font-bold shrink-0 mt-0.5">•</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="pt-3 border-t border-red-200/50 dark:border-red-900/20 text-[11px] font-mono text-red-700 dark:text-red-300 font-semibold">
            {criticalIssues.length} Critical Bottlenecks Flagged

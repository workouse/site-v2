---
const clients = [
  {
    domain: "eresbiotech.com",
    url: "https://eresbiotech.com",
    period: "2016 – 2021",
    services: "Web development, e-commerce, custom in-house app development",
    tags: ["Web Dev", "E-Commerce", "Custom In-House App"],
  },
  {
    domain: "7cups.com",
    url: "https://7cups.com",
    period: "Past Client",
    services: "Modernising web & core app architecture with Symfony and ReactJS",
    tags: ["Symfony", "ReactJS", "App Modernization"],
  },
  {
    domain: "hellocake.com",
    url: "https://hellocake.com",
    period: "Past Client",
    services: "Shopify store & custom platform development (theme engineering, custom extensions)",
    tags: ["Shopify", "Theme Dev", "Custom Extension"],
  },
  {
    domain: "jetfresh.de",
    url: "https://jetfresh.de",
    period: "Past Client",
    services: "Shopify development (custom theme customization & app extensions)",
    tags: ["Shopify", "Theme Dev", "Extensions"],
  },
  {
    domain: "theshakerdoorstore.com",
    url: "https://www.theshakerdoorstore.com",
    period: "Past Client",
    services: "Shopify development (bespoke theme architecture & custom extensions)",
    tags: ["Shopify", "Theme Dev", "Extensions"],
  },
  {
    domain: "carreb.com.au",
    url: "https://www.carreb.com.au/",
    period: "Past Client",
    services: "SaaS platform development utilizing Symfony backends and ReactJS frontends",
    tags: ["SaaS Dev", "Symfony", "ReactJS"],
  },
  {
    domain: "expertshare.live",
    url: "https://www.expertshare.live/",
    period: "Past Client",
    services: "SaaS development, full-stack architecture (Symfony, ReactJS) with NixOps & DevOps automation",
    tags: ["SaaS Dev", "Symfony", "ReactJS", "NixOps", "DevOps"],
  },
  {
    domain: "routr.com",
    url: "https://routr.com",
    period: "Past Client",
    services: "High-performance backend system engineering & Haskell development",
    tags: ["Haskell", "Backend Engineering"],
  },
];
---

<section id="clients" class="py-24 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto border-t border-zinc-900 scroll-mt-16">
  <!-- Section Header -->
  <div class="text-center max-w-2xl mx-auto mb-16 space-y-3">
    <div class="inline-flex items-center gap-3">
      <span class="text-xs font-mono font-bold tracking-widest text-brand-yellow uppercase">Track Record</span>
      <span class="h-[1px] w-8 bg-zinc-800"></span>
    </div>
    <h2 class="font-display text-3xl sm:text-4xl font-bold tracking-tight text-white">
      Previous Clients & Past Work
    </h2>
    <p class="text-sm sm:text-base text-zinc-400">
      Selected client engagements and engineering projects. All listed contracts have been successfully completed.
    </p>
  </div>

  <!-- Clients Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
    {clients.map((client) => (
      <div class="glow-card p-5 rounded-2xl flex flex-col justify-between group border border-zinc-900 bg-zinc-950/60 hover:border-brand-yellow/30 transition duration-300">
        <div class="space-y-4">
          <!-- Top Row: Domain & External Link Icon -->
          <div class="flex items-start justify-between gap-2">
            <a 
              href={client.url} 
              target="_blank" 
              rel="noopener noreferrer"
              class="font-display font-bold text-base text-white group-hover:text-brand-yellow transition duration-200 truncate flex items-center gap-1.5"
            >
              <span class="truncate">{client.domain}</span>
              <svg class="w-3.5 h-3.5 shrink-0 opacity-40 group-hover:opacity-100 transition duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>

          <!-- Period / Status Badge -->
          <div class="flex flex-wrap items-center gap-2">
            <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-zinc-900 border border-zinc-800 text-zinc-400">
              {client.period}
            </span>
            <span class="text-[9px] font-mono px-2 py-0.5 rounded-full bg-emerald-950/50 text-emerald-400 border border-emerald-800/40">
              Contract Concluded
            </span>
          </div>

          <!-- Description -->
          <p class="text-xs text-zinc-400 leading-relaxed font-sans min-h-[48px]">
            {client.services}
          </p>
        </div>

        <!-- Tech Stack Tags -->
        <div class="pt-4 border-t border-zinc-900/60 mt-4 flex flex-wrap gap-1.5">
          {client.tags.map((tag) => (
            <span class="text-[9px] font-mono px-2 py-0.5 rounded bg-zinc-900/80 border border-zinc-800/80 text-zinc-300">
              {tag}
            </span>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

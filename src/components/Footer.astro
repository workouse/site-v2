---
const currentYear = new Date().getFullYear();
---

<footer id="contact" class="py-24 px-4 sm:px-6 lg:px-8 bg-zinc-950 border-t border-zinc-900 mt-20 relative overflow-hidden scroll-mt-16">
  <!-- Grid Accent Glow -->
  <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[90vw] h-[25vh] bg-brand-blue/5 blur-[120px] rounded-full pointer-events-none"></div>

  <div class="max-w-4xl mx-auto text-center space-y-12 relative z-10">
    
    <!-- Heading & Text -->
    <div class="space-y-4 max-w-2xl mx-auto">
      <div class="inline-flex items-center gap-3">
        <span class="text-xs font-mono font-bold tracking-widest text-brand-yellow uppercase">Connect</span>
        <span class="h-[1px] w-8 bg-zinc-800"></span>
      </div>
      <h2 class="font-display text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-white leading-tight">
        Ready to launch your next application?
      </h2>
      <p class="text-zinc-400 font-sans text-sm sm:text-base leading-relaxed">
        Whether you need a full-scale web app, system optimization, or a fractional CTO to design your architecture, let's connect and build a reliable system together.
      </p>
    </div>

    <!-- Email CTA Callout -->
    <div class="inline-block">
      <a 
        href="mailto:z@emre.xyz" 
        class="group inline-flex flex-col items-center justify-center p-6 sm:p-8 rounded-3xl border border-zinc-900 bg-zinc-950 hover:border-brand-yellow/30 hover:bg-zinc-900/10 transition duration-300 relative"
      >
        <span class="text-[10px] font-mono tracking-widest uppercase text-zinc-500 group-hover:text-brand-yellow transition duration-300">Primary Channel</span>
        <span class="font-display text-xl sm:text-3xl font-bold text-white mt-1.5 group-hover:scale-[1.02] transition duration-300">
          z@emre.xyz
        </span>
        <!-- Glow indicator -->
        <span class="absolute top-3 right-3 flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-yellow/60 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-brand-yellow"></span>
        </span>
      </a>
    </div>

    <!-- Social / Agency Profiles Grid -->
    <div class="flex flex-wrap justify-center items-center gap-4 sm:gap-6 pt-4">
      <!-- Upwork -->
      <a 
        href="https://www.upwork.com/agencies/workouse" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="flex items-center gap-2 px-5 py-2.5 rounded-full border border-zinc-900 bg-zinc-900/20 hover:border-zinc-800 hover:bg-zinc-900/60 hover:text-white text-zinc-400 text-xs font-semibold tracking-wide uppercase transition duration-300"
      >
        <!-- Custom Upwork Logo SVG -->
        <svg class="w-4 h-4 fill-current text-[#14a800]" viewBox="0 0 24 24">
          <path d="M18.561 3.281c-2.477 0-4.492 2.015-4.492 4.492v4.062H12v-6.3c0-2.477-2.015-4.492-4.492-4.492C5.031 1.043 3.016 3.058 3.016 5.535v12.923H7.51v-6.353c0-1.42.825-2.58 2.023-2.58 1.197 0 2.023 1.16 2.023 2.58v6.353h4.493v-6.079c0-1.258.988-2.279 2.222-2.279 1.233 0 2.223 1.021 2.223 2.279v6.079H25v-6.079c0-3.738-3.036-6.772-6.439-6.772zM7.508 1.043v4.492c0 .825-.67 1.496-1.496 1.496S4.516 6.36 4.516 5.535V1.043H7.51z"/>
        </svg>
        <span>Upwork Agency</span>
      </a>

      <!-- GitHub -->
      <a 
        href="https://github.com/workouse" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="flex items-center gap-2 px-5 py-2.5 rounded-full border border-zinc-900 bg-zinc-900/20 hover:border-zinc-800 hover:bg-zinc-900/60 hover:text-white text-zinc-400 text-xs font-semibold tracking-wide uppercase transition duration-300"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
          <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482C19.138 20.193 22 16.44 22 12.017 22 6.484 17.522 2 12 2z"/>
        </svg>
        <span>GitHub</span>
      </a>

      <!-- X / Twitter -->
      <a 
        href="https://x.com/workousecom" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="flex items-center gap-2 px-5 py-2.5 rounded-full border border-zinc-900 bg-zinc-900/20 hover:border-zinc-800 hover:bg-zinc-900/60 hover:text-white text-zinc-400 text-xs font-semibold tracking-wide uppercase transition duration-300"
      >
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
        </svg>
        <span>Twitter / X</span>
      </a>

      <!-- Personal Hub -->
      <a 
        href="https://emre.xyz" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="flex items-center gap-2 px-5 py-2.5 rounded-full border border-zinc-900 bg-zinc-900/20 hover:border-zinc-800 hover:bg-zinc-900/60 hover:text-white text-zinc-400 text-xs font-semibold tracking-wide uppercase transition duration-300"
      >
        <svg class="w-4 h-4 fill-none stroke-current" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
        </svg>
        <span>emre.xyz</span>
      </a>
    </div>

    <!-- Copyright and Credits -->
    <div class="pt-16 border-t border-zinc-900 text-center text-[10px] font-mono text-zinc-500 space-y-2">
      <div class="flex justify-center gap-4 text-xs font-sans text-zinc-400 mb-3">
        <a href="/blog" class="hover:text-brand-yellow transition">Blog (EN)</a>
        <span>•</span>
        <a href="/blog/tr" class="hover:text-brand-yellow transition">Blog (TR)</a>
      </div>
      <p>&copy; {currentYear} WORKOUSE. All rights reserved.</p>
      <p>Boutique, solo engineering and architecture house. Handcrafted by Emre Yılmaz.</p>
    </div>

  </div>
</footer>

---
import CookieBanner from '../components/CookieBanner.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import { hero } from '../data/site';
import '../styles/global.css';
import instrumentSerifUrl from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import dmSansUrl from '@fontsource-variable/dm-sans/files/dm-sans-latin-opsz-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  canonical?: string;
  lang?: string;
  currentPath?: string;
}

const SITE_ORIGIN = 'https://workouse.com';
const SITE_NAME = 'Workouse';
const DEFAULT_TITLE = 'Workouse — PHP & Symfony and Shopify engineering';
const DEFAULT_OG_IMAGE_PATH = '/brand/workouse-symbol.png';
const TWITTER_HANDLE = '@workousecom';
const FOUNDER_NAME = 'Emre Yılmaz';

const {
  title = DEFAULT_TITLE,
  description = hero.body,
  image,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  author = FOUNDER_NAME,
  canonical,
  lang = 'en',
  currentPath,
} = Astro.props;

const canonicalURL = canonical
  ? new URL(canonical, SITE_ORIGIN)
  : new URL(Astro.url.pathname, SITE_ORIGIN);

const defaultImageURL = new URL(DEFAULT_OG_IMAGE_PATH, SITE_ORIGIN).href;
const ogImage = image || defaultImageURL;

// Schema.org data. Claims must match the specialist-team positioning: no
// "solo" or years-of-experience statements.
const professionalServiceSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": `${SITE_ORIGIN}/#organization`,
  "name": SITE_NAME,
  "url": SITE_ORIGIN,
  "logo": defaultImageURL,
  "image": defaultImageURL,
  "description": description,
  "founder": {
    "@type": "Person",
    "name": FOUNDER_NAME,
    "jobTitle": "Senior Software Architect & Founder"
  },
  "knowsAbout": [
    "PHP",
    "Symfony",
    "Shopify",
    "software modernization"
  ],
  "sameAs": [
    "https://github.com/workouse",
    "https://x.com/workousecom"
  ]
};

const webSiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${SITE_ORIGIN}/#website`,
  "url": SITE_ORIGIN,
  "name": SITE_NAME,
  "description": "PHP & Symfony modernization and Shopify engineering",
  "publisher": {
    "@id": `${SITE_ORIGIN}/#organization`
  },
  "inLanguage": lang === "tr" ? "tr-TR" : "en-US"
};
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />

    <!-- Favicons -->
    <link rel="icon" type="image/png" href={DEFAULT_OG_IMAGE_PATH} />
    <link rel="apple-touch-icon" href={DEFAULT_OG_IMAGE_PATH} />

    <!-- RSS Feed Link -->
    <link rel="alternate" type="application/rss+xml" title="Workouse Blog RSS Feed" href="https://workouse.com/rss.xml" />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />

    <!-- Theme & Color Scheme (light only) -->
    <meta name="theme-color" content="#FAF8F4" />
    <meta name="color-scheme" content="light" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={lang === "tr" ? "tr_TR" : "en_US"} />
    {ogType === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {ogType === 'article' && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}
    {ogType === 'article' && author && (
      <meta property="article:author" content={author} />
    )}

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:site" content={TWITTER_HANDLE} />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />

    <!-- Self-hosted font preloads: the hero uses Instrument Serif 400 and DM Sans, both above the fold -->
    <link rel="preload" href={instrumentSerifUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={dmSansUrl} as="font" type="font/woff2" crossorigin />

    <!-- Structured Data -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(professionalServiceSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webSiteSchema)} />

    <!-- Google Analytics (GA4) with Consent Mode v2 -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-NEW2M4VEX1"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      window.gtag = gtag;

      // Read saved cookie consent from localStorage
      var savedConsent = null;
      try {
        var rawConsent = localStorage.getItem('workouse_cookie_consent');
        if (rawConsent) savedConsent = JSON.parse(rawConsent);
      } catch (e) {}

      var analyticsGranted = savedConsent ? Boolean(savedConsent.analytics) : false;

      // Set default consent state
      gtag('consent', 'default', {
        'analytics_storage': analyticsGranted ? 'granted' : 'denied',
        'ad_storage': 'denied',
        'ad_user_data': 'denied',
        'ad_personalization': 'denied'
      });

      gtag('js', new Date());
      gtag('config', 'G-NEW2M4VEX1', {
        send_page_view: true
      });
    </script>

    <!-- Custom Head Slot for Page-Specific Meta / Hreflang Tags -->
    <slot name="head" />
  </head>
  <body class="min-h-screen antialiased overflow-x-hidden w-full max-w-full">
    <div class="site-shell flex min-h-screen flex-col overflow-x-hidden w-full max-w-full">
      <!-- SiteHeader renders the skip link ("#main") as its first element -->
      <SiteHeader currentPath={currentPath} />

      <main id="main" class="flex-grow">
        <slot />
      </main>

      <!-- Page-specific closing CTA: pages pass a FinalContactCTA with slot="cta" -->
      <slot name="cta" />

      <SiteFooter />
    </div>

    <!-- Cookie Consent Banner & Preferences Modal -->
    <CookieBanner />

    <style is:global>
      html {
        background: var(--surface-page);
        color: var(--text-primary);
        color-scheme: light;
        scrollbar-gutter: stable;
      }

      body {
        background: var(--surface-page);
        color: var(--text-primary);
      }

      ::selection {
        background: var(--accent-sparing);
        color: var(--text-primary);
      }

      /* Smooth custom scrollbars */
      ::-webkit-scrollbar {
        width: 8px;
        height: 8px;
      }
      ::-webkit-scrollbar-track {
        background: var(--surface-subtle);
      }
      ::-webkit-scrollbar-thumb {
        background: var(--border-subtle);
        border-radius: 4px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: var(--text-secondary);
      }

      /* Respect prefers-reduced-motion for all animations */
      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
          scroll-behavior: auto !important;
        }
      }

      /* Card surface used by the cookie banner */
      .glow-card {
        position: relative;
        background: var(--surface-raised);
        border: 1px solid var(--border-subtle);
        transition: border-color 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      }
    </style>

    <!-- Global Outbound Click Tracking -->
    <script>
      import { trackEvent } from '../lib/analytics';

      document.addEventListener('click', (e) => {
        const target = (e.target as HTMLElement)?.closest('a');
        if (!target) return;
        const href = target.getAttribute('href');
        if (!href) return;

        if (href.startsWith('http://') || href.startsWith('https://')) {
          try {
            const url = new URL(href, window.location.origin);
            if (url.origin !== window.location.origin) {
              trackEvent('outbound_click', {
                destination: href,
                link_text: target.innerText?.trim() || target.getAttribute('aria-label') || 'outbound_link',
              });
            }
          } catch {}
        }
      });
    </script>
  </body>
</html>

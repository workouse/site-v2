---
import CookieBanner from '../components/CookieBanner.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  canonical?: string;
  lang?: string;
}

const {
  title = "Workouse | Elite Fullstack Engineering for Scale",
  description = "Workouse is a boutique, solo software development house building resilient, high-scale web applications for forward-thinking companies. Engineered by Emre Yılmaz (15+ years experience).",
  image = "https://avatars.githubusercontent.com/u/55496985?s=400&u=cf5cb2d74029d653813b39d624e44b8f74bc63c1&v=4",
  ogType = "website",
  publishedTime,
  modifiedTime,
  author = "Emre Yılmaz",
  canonical,
  lang = "en",
} = Astro.props;

const canonicalURL = canonical
  ? new URL(canonical, "https://workouse.com")
  : new URL(Astro.url.pathname, "https://workouse.com");

const defaultLogo = "https://avatars.githubusercontent.com/u/55496985?s=400&u=cf5cb2d74029d653813b39d624e44b8f74bc63c1&v=4";
const ogImage = image || defaultLogo;

const professionalServiceSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": "https://workouse.com/#organization",
  "name": "Workouse",
  "url": "https://workouse.com",
  "logo": defaultLogo,
  "image": defaultLogo,
  "description": description,
  "founder": {
    "@type": "Person",
    "name": "Emre Yılmaz",
    "jobTitle": "Senior Software Architect & Founder"
  },
  "knowsAbout": [
    "Software Architecture",
    "PHP & Symfony development",
    "TypeScript & AstroJS fullstack development",
    "Haskell & functional programming",
    "Nix & reproducible builds",
    "Rust, Go, & Python engineering",
    "DevOps, Security & Cloud Deployment",
    "AWS & Cloudflare Edge Services"
  ],
  "sameAs": [
    "https://github.com/workouse",
    "https://x.com/workousecom"
  ]
};

const webSiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "https://workouse.com/#website",
  "url": "https://workouse.com",
  "name": "Workouse",
  "description": "Boutique Software Engineering & Automated Site Audits",
  "publisher": {
    "@id": "https://workouse.com/#organization"
  },
  "inLanguage": lang === "tr" ? "tr-TR" : "en-US"
};
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />

    <!-- Favicons -->
    <link rel="icon" type="image/png" href={defaultLogo} />
    <link rel="apple-touch-icon" href={defaultLogo} />

    <!-- RSS Feed Link -->
    <link rel="alternate" type="application/rss+xml" title="Workouse Blog RSS Feed" href="https://workouse.com/rss.xml" />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />

    <!-- Theme & Color Scheme -->
    <meta name="theme-color" content="#003087" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#003087" media="(prefers-color-scheme: light)" />
    <meta name="color-scheme" content="dark" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:site_name" content="Workouse" />
    <meta property="og:locale" content={lang === "tr" ? "tr_TR" : "en_US"} />
    {ogType === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {ogType === 'article' && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}
    {ogType === 'article' && author && (
      <meta property="article:author" content={author} />
    )}

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:site" content="@workousecom" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />

    <!-- Resource Hints: Preconnect to Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&family=Geist+Mono:wght@400;500;600&display=swap" rel="stylesheet" />

    <!-- Structured Data -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(professionalServiceSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webSiteSchema)} />

    <!-- Inline Theme Initialization Script (FOUC Prevention) -->
    <script is:inline>
      (function() {
        const storedTheme = localStorage.getItem('theme');
        if (storedTheme === 'dark' || (!storedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        } else if (storedTheme === 'light') {
          document.documentElement.classList.remove('dark');
        } else {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>

    <!-- Google Analytics (GA4) with Consent Mode v2 -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-NEW2M4VEX1"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      window.gtag = gtag;

      // Read saved cookie consent from localStorage
      var savedConsent = null;
      try {
        var rawConsent = localStorage.getItem('workouse_cookie_consent');
        if (rawConsent) savedConsent = JSON.parse(rawConsent);
      } catch (e) {}

      var analyticsGranted = savedConsent ? Boolean(savedConsent.analytics) : false;

      // Set default consent state
      gtag('consent', 'default', {
        'analytics_storage': analyticsGranted ? 'granted' : 'denied',
        'ad_storage': 'denied',
        'ad_user_data': 'denied',
        'ad_personalization': 'denied'
      });

      gtag('js', new Date());
      gtag('config', 'G-NEW2M4VEX1', {
        send_page_view: true
      });
    </script>

    <!-- Custom Head Slot for Page-Specific Meta / Hreflang Tags -->
    <slot name="head" />
  </head>
  <body class="bg-zinc-50 text-zinc-900 dark:bg-zinc-950 dark:text-zinc-50 font-sans selection:bg-brand-blue selection:text-brand-yellow min-h-screen antialiased overflow-x-hidden w-full max-w-full relative transition-colors duration-300">
    <!-- Skip to main content (Accessibility) -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[999] focus:px-4 focus:py-2 focus:rounded-md focus:bg-brand-yellow focus:text-zinc-950 focus:font-semibold focus:text-sm focus:outline-none"
    >
      Skip to main content
    </a>

    <!-- Mouse-follow cursor glow -->
    <div
      id="cursor-glow"
      aria-hidden="true"
      class="pointer-events-none fixed z-0 transition-opacity duration-500"
      style="top:0;left:0;width:600px;height:600px;transform:translate(-50%,-50%);background:radial-gradient(circle at center, rgba(254,197,0,0.08) 0%, rgba(0,48,135,0.05) 40%, transparent 70%);border-radius:50%;opacity:0;"
    ></div>

    <!-- Grid Overlay Background -->
    <div aria-hidden="true" class="fixed inset-0 bg-[linear-gradient(to_right,#e4e4e7_1px,transparent_1px),linear-gradient(to_bottom,#e4e4e7_1px,transparent_1px)] dark:bg-[linear-gradient(to_right,#09090b_1px,transparent_1px),linear-gradient(to_bottom,#09090b_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] pointer-events-none z-0 opacity-70 dark:opacity-80"></div>

    <!-- Deep Ambient Glow Accent -->
    <div aria-hidden="true" class="fixed top-0 left-1/2 -translate-x-1/2 w-[80vw] h-[50vh] bg-brand-blue/5 dark:bg-brand-blue/10 blur-[120px] rounded-full pointer-events-none z-0"></div>

    <div class="relative z-10 flex flex-col min-h-screen justify-between overflow-x-hidden w-full max-w-full">
      <slot />
    </div>

    <!-- Cookie Consent Banner & Preferences Modal -->
    <CookieBanner />

    <style is:global>
      /* Prevent layout shift from scrollbar appearance */
      html {
        scrollbar-gutter: stable;
      }

      /* Smooth custom scrollbars */
      ::-webkit-scrollbar {
        width: 8px;
        height: 8px;
      }
      ::-webkit-scrollbar-track {
        background: #f4f4f5;
      }
      .dark ::-webkit-scrollbar-track {
        background: #09090b;
      }
      ::-webkit-scrollbar-thumb {
        background: #d4d4d8;
        border-radius: 4px;
      }
      .dark ::-webkit-scrollbar-thumb {
        background: #27272a;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: #a1a1aa;
      }
      .dark ::-webkit-scrollbar-thumb:hover {
        background: #3f3f46;
      }

      /* Visible focus indicators for keyboard navigation */
      :focus-visible {
        outline: 2px solid #FEC500;
        outline-offset: 3px;
        border-radius: 4px;
      }

      /* Respect prefers-reduced-motion for all animations */
      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
          scroll-behavior: auto !important;
        }
      }

      /* Glow card transitions */
      .glow-card {
        position: relative;
        background: rgba(255, 255, 255, 0.85);
        border: 1px solid rgba(228, 228, 231, 0.8);
        backdrop-filter: blur(12px);
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.03);
      }

      .dark .glow-card {
        background: rgba(18, 18, 24, 0.65);
        border: 1px solid rgba(39, 39, 42, 0.6);
        box-shadow: none;
      }

      .glow-card:hover {
        border-color: rgba(254, 197, 0, 0.5);
        box-shadow: 0 0 25px rgba(254, 197, 0, 0.08);
        transform: translateY(-2px);
      }

      .dark .glow-card:hover {
        border-color: rgba(254, 197, 0, 0.4);
        box-shadow: 0 0 25px rgba(254, 197, 0, 0.05), inset 0 0 12px rgba(254, 197, 0, 0.02);
      }
    </style>

    <!-- Cursor glow follow script -->
    <script>
      (function () {
        // Respect prefers-reduced-motion
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        // Desktop only — skip on touch-primary devices
        if (window.matchMedia('(hover: none)').matches) return;

        const glow = document.getElementById('cursor-glow');
        if (!glow) return;

        let raf;
        let targetX = window.innerWidth / 2;
        let targetY = window.innerHeight / 2;
        let currentX = targetX;
        let currentY = targetY;
        let visible = false;

        document.addEventListener('mousemove', (e) => {
          targetX = e.clientX;
          targetY = e.clientY;
          if (!visible) {
            visible = true;
            glow.style.opacity = '1';
          }
        });

        document.addEventListener('mouseleave', () => {
          visible = false;
          glow.style.opacity = '0';
        });

        function lerp(a: number, b: number, t: number): number { return a + (b - a) * t; }

        function animate() {
          // Smooth lag — 0.08 gives a nice buttery trail
          currentX = lerp(currentX, targetX, 0.08);
          currentY = lerp(currentY, targetY, 0.08);
          (glow as HTMLElement).style.left = currentX + 'px';
          (glow as HTMLElement).style.top  = currentY + 'px';
          raf = requestAnimationFrame(animate);
        }

        animate();
      })();
    </script>
    <!-- Global Outbound Click Tracking -->
    <script>
      import { trackEvent } from '../lib/analytics';

      document.addEventListener('click', (e) => {
        const target = (e.target as HTMLElement)?.closest('a');
        if (!target) return;
        const href = target.getAttribute('href');
        if (!href) return;

        if (href.startsWith('http://') || href.startsWith('https://')) {
          try {
            const url = new URL(href, window.location.origin);
            if (url.origin !== window.location.origin) {
              trackEvent('outbound_click', {
                destination: href,
                link_text: target.innerText?.trim() || target.getAttribute('aria-label') || 'outbound_link',
              });
            }
          } catch {}
        }
      });
    </script>
  </body>
</html>

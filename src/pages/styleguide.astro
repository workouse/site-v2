---
/*
 * Throwaway design-foundation reference page (WOR-1). Not linked from the
 * site; safe to delete once the component library replaces it.
 */
import '../styles/global.css';
import Button from '../components/ui/Button.astro';
import DirectionalLink from '../components/ui/DirectionalLink.astro';
import EngagementFilter from '../components/ui/EngagementFilter.astro';
import EngagementFilterGroup from '../components/ui/EngagementFilterGroup.astro';
import MediaFrame from '../components/ui/MediaFrame.astro';
import MushroomNebula from '../components/ui/MushroomNebula.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import TextLink from '../components/ui/TextLink.astro';
import WorkouseLockup from '../components/ui/WorkouseLockup.astro';
import emrePhoto from '../assets/team/emre.jpg';
import { cta, engagements, hero, links, products, services, team, workPage } from '../data/site';

const colorTokens = [
  { name: 'text/primary', hex: '#24354F', className: 'bg-ink' },
  { name: 'text/secondary', hex: '#5B6574', className: 'bg-secondary' },
  { name: 'text/link', hex: '#53658E', className: 'bg-indigo' },
  { name: 'surface/page', hex: '#FAF8F4', className: 'bg-ivory' },
  { name: 'surface/raised', hex: '#FFFFFF', className: 'bg-raised' },
  { name: 'surface/subtle', hex: '#F0EEF2', className: 'bg-subtle' },
  { name: 'border/subtle', hex: '#D7D9DF', className: 'bg-line' },
  { name: 'action/primary', hex: '#24354F', className: 'bg-ink' },
  { name: 'accent/sparing', hex: '#E8BC57', className: 'bg-amber' },
  { name: 'decor/lilac', hex: '#C2A4C7', className: 'bg-lilac' },
];

const typeStyles = [
  { name: 'Display/Desktop', spec: 'Instrument Serif 112 / 0.98 / -2.24px', className: 'font-serif text-display-desktop', sample: 'Studio' },
  { name: 'Display/Tablet', spec: 'Instrument Serif 80 / 0.98 / -1.6px', className: 'font-serif text-display-tablet', sample: 'Studio' },
  { name: 'Display/Mobile', spec: 'Instrument Serif 60 / 0.98 / -1.2px', className: 'font-serif text-display-mobile', sample: 'Studio' },
  { name: 'Heading/Section', spec: 'Instrument Serif 64 / 66px', className: 'font-serif text-heading-section', sample: 'Engagements' },
  { name: 'Heading/Compact', spec: 'Instrument Serif 40 / 44px', className: 'font-serif text-heading-compact', sample: 'Selected work' },
  { name: 'Body/Large', spec: 'DM Sans 20 / 32px / 400', className: 'font-sans text-body-large', sample: 'Large body copy for lead paragraphs.' },
  { name: 'Body/Regular', spec: 'DM Sans 16 / 26px / 400', className: 'font-sans text-body', sample: 'Regular body copy for supporting text.' },
  { name: 'UI/Medium', spec: 'DM Sans 14 / 20px / 500', className: 'font-sans text-ui', sample: 'Button and navigation label' },
  { name: 'Label/Small', spec: 'DM Sans 12 / 18px / 500', className: 'font-sans text-label', sample: 'Small label' },
];

const spacingTokens = [0, 4, 8, 12, 16, 24, 32, 40, 48, 64, 80, 96, 120];
const radiusTokens = [
  { name: 'radius-0', className: 'rounded-none', px: 0 },
  { name: 'radius-2', className: 'rounded-sm', px: 2 },
  { name: 'radius-4', className: 'rounded-md', px: 4 },
  { name: 'radius-8', className: 'rounded-lg', px: 8 },
];

const buttonKinds = [
  { kind: 'primary' as const, label: 'Primary', darkBg: false, spec: '14px 24px · gap 12 · 500 · 211×56' },
  { kind: 'secondary' as const, label: 'Secondary', darkBg: false, spec: '14px 24px · gap 12 · 500 · 1px #D7D9DF · 213×58' },
  { kind: 'inverse' as const, label: 'Inverse (on ink)', darkBg: true, spec: '16px 24px · gap 16 · 400 · 212×60' },
];

const buttonStates = [
  { key: 'default', label: 'Default' },
  { key: 'hover', label: 'Hover' },
  { key: 'focus', label: 'Focus-visible' },
  { key: 'active', label: 'Active' },
  { key: 'disabled', label: 'Disabled' },
];

const directionalLinkVariants = [
  {
    title: 'Internal (→ · tone="ink")',
    spec: 'padding 12px 4px · gap 12px · label 14px + arrow 18px · ~143×52',
    href: links.work.href,
    label: hero.secondaryCta.label,
    arrow: '→' as const,
    external: false,
    tone: 'ink' as const,
    darkBg: false,
    ariaLabel: undefined,
  },
  {
    title: 'External (↗ · tone="ink")',
    spec: 'target="_blank" rel="noopener noreferrer" · announces new tab',
    href: links.sevenCups.href,
    label: 'Visit 7cups',
    arrow: '↗' as const,
    external: true,
    tone: 'ink' as const,
    darkBg: false,
    ariaLabel: 'Visit 7cups website',
  },
  {
    title: 'On ink surface (→ · tone="ivory")',
    spec: '#FAF8F4 text and focus-visible outline on #24354F surface',
    href: links.work.href,
    label: hero.secondaryCta.label,
    arrow: '→' as const,
    external: false,
    tone: 'ivory' as const,
    darkBg: true,
    ariaLabel: undefined,
  },
];

const textLinkTones = [
  {
    tone: 'ink' as const,
    title: 'Tone: ink (#24354F)',
    spec: 'padding 12px 0 · min-height 44px · gap 8px · DM Sans 400',
    darkBg: false,
    href: engagements.home.items[1].href,
    label: engagements.home.items[1].linkLabel,
    external: true,
  },
  {
    tone: 'link' as const,
    title: 'Tone: link (#53658E)',
    spec: 'Muted indigo text · #53658E focus-visible outline',
    darkBg: false,
    href: products.featured.href,
    label: products.featured.linkLabel,
    external: true,
  },
  {
    tone: 'ivory' as const,
    title: 'Tone: ivory (#FAF8F4 on ink)',
    spec: 'Ivory text & #FAF8F4 focus-visible outline on #24354F surface',
    darkBg: true,
    href: links.email.href,
    label: cta.secondary.label,
    external: false,
  },
];

const textLinkSizes = [14, 13, 12, 11] as const;

const sectionHeadingWidths = [
  { viewport: 1440 as const, label: 'Desktop · 1440px viewport', frameWidth: '100%' },
  { viewport: 768 as const, label: 'Tablet · 768px viewport (688px content)', frameWidth: '688px' },
  { viewport: 390 as const, label: 'Mobile · 390px viewport (342px content)', frameWidth: '342px' },
];

const sectionHeadingSizes = [
  {
    size: 'section' as const,
    title: 'Size: section',
    spec: '64px @ 1440 · 64px @ 768 · 48px @ 390 · lh 1.05 · clamp()',
    eyebrow: engagements.home.eyebrow,
    eyebrowSize: 11 as const,
    heading: engagements.home.headingLines,
    as: 'h3' as const,
    tone: 'ink' as const,
    darkBg: false,
  },
  {
    size: 'compact' as const,
    title: 'Size: compact',
    spec: '40px @ 1440 · 40px @ 768 · 36px @ 390 · lh 1.05 · clamp()',
    eyebrow: services.php.eyebrow,
    eyebrowSize: 12 as const,
    heading: 'Keep your software moving forward.',
    as: 'h3' as const,
    tone: 'ink' as const,
    darkBg: false,
  },
  {
    size: 'display' as const,
    title: 'Size: display (CTA)',
    spec: '104px @ 1440 · 80px @ 768 · 58px @ 390 · lh 1.04 · clamp()',
    eyebrow: cta.home.eyebrow,
    eyebrowSize: 11 as const,
    heading: cta.home.heading,
    as: 'h3' as const,
    tone: 'ivory' as const,
    darkBg: true,
  },
];

const mediaFrameVariants = [
  {
    key: 'generic',
    title: 'Variant: generic (480×280)',
    spec: 'border 1px #D7D9DF · gap 12 · 11px #53658E / 14px #5B6574 · center',
    variant: 'generic' as const,
    gap: 12 as const,
    lines: ['SCREENSHOT PLACEHOLDER', 'Approved capture to be supplied'],
    frames: [
      { viewport: 1440 as const, label: 'Desktop · 480×280', width: '480px', ratio: '480/280' },
      { viewport: 768 as const, label: 'Tablet · 688px container (480/280)', width: '688px', ratio: '480/280' },
      { viewport: 390 as const, label: 'Mobile · 342px container (480/280)', width: '342px', ratio: '480/280' },
    ],
  },
  {
    key: 'card-engagement',
    title: 'Variant: card — Homepage Engagements',
    spec: 'border none · gap 12 · 10px #53658E / 12px #5B6574 · center · padding-inline 16px',
    variant: 'card' as const,
    gap: 12 as const,
    lines: ['SCREENSHOT PLACEHOLDER', engagements.home.items[0].screenshotLabel],
    frames: [
      { viewport: 1440 as const, label: 'Desktop · 368×200', width: '368px', ratio: '368/200' },
      { viewport: 768 as const, label: 'Tablet · 688×240', width: '688px', ratio: '688/240' },
      { viewport: 390 as const, label: 'Mobile · 342×192', width: '342px', ratio: '342/192' },
    ],
  },
  {
    key: 'card-product',
    title: 'Variant: card — Supporting Products (GroundBox & Ula)',
    spec: 'border none · gap 8 · 10px #53658E / 12px #5B6574 · center',
    variant: 'card' as const,
    gap: 8 as const,
    lines: ['SCREENSHOT PLACEHOLDER', products.supporting[0].placeholder],
    frames: [
      { viewport: 1440 as const, label: 'Desktop · 600×172', width: '600px', ratio: '600/172' },
      { viewport: 768 as const, label: 'Tablet · 688×180', width: '688px', ratio: '688/180' },
      { viewport: 390 as const, label: 'Mobile · 342×180', width: '342px', ratio: '342/180' },
    ],
  },
  {
    key: 'feature',
    title: 'Variant: feature — Bitig',
    spec: 'border none · gap 12 · 11px #53658E / 13px #5B6574 · center · textInset 20px',
    variant: 'feature' as const,
    gap: 12 as const,
    lines: products.featured.placeholder,
    frames: [
      { viewport: 1440 as const, label: 'Desktop · 760×360', width: '760px', ratio: '760/360' },
      { viewport: 768 as const, label: 'Tablet · 688×300', width: '688px', ratio: '688/300' },
      { viewport: 390 as const, label: 'Mobile · 342×224', width: '342px', ratio: '342/224' },
    ],
  },
  {
    key: 'portrait',
    title: 'Variant: portrait — Sarp (placeholder)',
    spec: 'border none · gap 12 · 11px #53658E / Instrument Serif 20px lh 1.06 #24354F / 12px #5B6574 · center',
    variant: 'portrait' as const,
    gap: 12 as const,
    lines: team.people[1].placeholder ?? [],
    frames: [
      { viewport: 1440 as const, label: 'Desktop · 544×376', width: '544px', ratio: '544/376' },
      { viewport: 768 as const, label: 'Tablet · 328×320', width: '328px', ratio: '328/320' },
      { viewport: 390 as const, label: 'Mobile · 342×340', width: '342px', ratio: '342/340' },
    ],
  },
  {
    key: 'portrait-image',
    title: 'Variant: portrait — Emre (real ImageMetadata src)',
    spec: 'Astro <Image> · object-fit: cover · aspect-ratio reserved · meaningful alt',
    variant: 'portrait' as const,
    gap: 12 as const,
    lines: ['PORTRAIT PLACEHOLDER', 'Emre Yılmaz', 'Approved photography to be supplied'],
    src: emrePhoto,
    alt: team.people[0].alt,
    frames: [
      { viewport: 1440 as const, label: 'Desktop · 624×440', width: '624px', ratio: '624/440' },
      { viewport: 768 as const, label: 'Tablet · 328×320', width: '328px', ratio: '328/320' },
      { viewport: 390 as const, label: 'Mobile · 342×360', width: '342px', ratio: '342/360' },
    ],
  },
  {
    key: 'work',
    title: 'Variant: work — /work page (featured, standard, compact, tablet, mobile)',
    spec: 'border 1px #D7D9DF · padding 24px · gap 16 · 12px Medium lh 18px / 14px Medium lh 20px #24354F · left',
    variant: 'work' as const,
    gap: 16 as const,
    lines: ['SCREENSHOT / AWAITING APPROVED CAPTURE', engagements.work[0].screenshotLabel],
    frames: [
      { viewport: 1440 as const, label: 'Desktop Featured · 720×450', width: '720px', ratio: '720/450' },
      { viewport: 1440 as const, label: 'Desktop Standard · 744×417', width: '744px', ratio: '744/417' },
      { viewport: 1440 as const, label: 'Desktop Compact · 744×465', width: '744px', ratio: '744/465' },
      { viewport: 768 as const, label: 'Tablet · 688×430', width: '688px', ratio: '688/430' },

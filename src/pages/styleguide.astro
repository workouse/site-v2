                </div>
              </div>

              <div class="border-t border-line pt-16">
                <p class="font-sans text-label text-secondary mb-12">Tablet &middot; 768px viewport (688px content)</p>
                <div class="border border-dashed border-line bg-raised px-16 pt-16" style="width: 100%; max-width: 688px;">
                  <EngagementFilterGroup interactive={false} data-sg-ef-frame="768" />
                </div>
              </div>

              <div class="border-t border-line pt-16">
                <p class="font-sans text-label text-secondary mb-12">Mobile &middot; 390px viewport (342px content &mdash; 4th filter wraps to row 2, zero horizontal scroll)</p>
                <div class="border border-dashed border-line bg-raised" style="width: 342px; max-width: 100%;">
                  <EngagementFilterGroup interactive={false} data-sg-ef-frame="390" />
                </div>
              </div>
            </div>
          </div>

          {/* 4. Live interactive filtering + keyboard + aria-live="polite" demo */}
          <div class="border border-line bg-raised p-24 text-ink" data-filter-scope data-sg-ef-demo>
            <div class="flex flex-wrap items-baseline justify-between gap-8 mb-24">
              <h3 class="font-sans text-ui">Interactive single-choice filtering &amp; polite live-region demo</h3>
              <p class="font-sans text-label text-secondary" data-sg-ef-event-readout>
                Active event: initial (All Work &middot; 3 engagements)
              </p>
            </div>

            <EngagementFilterGroup data-sg-ef-interactive="true" />

            <ul class="grid gap-16 md:grid-cols-3">
              {engagements.work.map((item) => (
                <li
                  data-filter-item
                  data-filters={item.filters.join(' ')}
                  data-sg-ef-card={item.client}
                  class="border border-line bg-ivory p-16"
                >
                  <p class="font-sans text-label text-indigo">{item.category}</p>
                  <p class="mt-4 font-serif text-body-large text-ink">{item.client}</p>
                  <p class="mt-8 font-sans text-label text-secondary">{item.technologies}</p>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <script>
          const demoScope = document.querySelector<HTMLElement>('[data-sg-ef-demo]');
          const readout = demoScope?.querySelector<HTMLElement>('[data-sg-ef-event-readout]');
          demoScope?.addEventListener('engagement-filter:change', (event) => {
            const detail = (event as CustomEvent<{
              value: string;
              label: string;
              visibleCount: number;
            }>).detail;
            if (readout && detail) {
              readout.textContent = `Active event: ${detail.label} (${detail.value}) · Showing ${detail.visibleCount} ${detail.visibleCount === 1 ? 'engagement' : 'engagements'}`;
            }
          });
        </script>
      </section>
    </main>
  </body>
</html>

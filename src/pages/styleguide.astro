---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Styleguide · Workouse design foundations</title>
  </head>
  <body class="font-sans">
    <main class="container-wo py-96">
      <SectionHeading
        id="page-hero"
        as="h1"
        eyebrow="DESIGN FOUNDATIONS"
        eyebrowSize={12}
        heading="Styleguide"
        size="section"
        data-sg-specimen="level-h1"
      />

      <section class="mt-96" aria-labelledby="colors">
        <h2 id="colors" class="font-serif text-heading-compact mb-24">Colors</h2>
        <ul class="grid grid-cols-2 gap-16 md:grid-cols-5">
          {colorTokens.map((color) => (
            <li>
              <div class={`h-80 border border-line ${color.className}`}></div>
              <p class="mt-8 font-sans text-ui text-ink">{color.name}</p>
              <p class="font-sans text-label text-secondary">{color.hex}</p>
            </li>
          ))}
        </ul>
      </section>

      <section class="mt-96" aria-labelledby="type">
        <h2 id="type" class="font-serif text-heading-compact mb-24">Typography</h2>
        <ul>
          {typeStyles.map((style) => (
            <li class="border-t border-line py-16">
              <p class="font-sans text-label text-secondary">{style.name} · {style.spec}</p>
              <p class={`mt-8 text-ink ${style.className}`}>{style.sample}</p>
            </li>
          ))}
        </ul>
        <p class="mt-24 font-sans text-body text-ink">
          Body text uses DM Sans with optical size 14 (font-variation-settings: "opsz" 14).
        </p>
      </section>

      <section class="mt-96" aria-labelledby="space">
        <h2 id="space" class="font-serif text-heading-compact mb-24">Space (4-pt scale)</h2>
        <ul class="flex flex-col gap-8">
          {spacingTokens.map((space) => (
            <li class="flex items-center gap-16 font-sans text-label text-secondary">
              <span class="w-48">{space}px</span>
              <span class="block h-16 bg-indigo" style={`width: var(--space-${space})`}></span>
            </li>
          ))}
        </ul>
      </section>

      <section class="mt-96" aria-labelledby="radii">
        <h2 id="radii" class="font-serif text-heading-compact mb-24">Radii</h2>
        <ul class="flex gap-24">
          {radiusTokens.map((radius) => (
            <li class="font-sans text-label text-secondary">
              <div class={`h-80 w-80 border border-ink bg-subtle ${radius.className}`}></div>
              <p class="mt-8">{radius.name} · {radius.px}px</p>
            </li>
          ))}
        </ul>
      </section>

      <section class="mt-96" aria-labelledby="focus">
        <h2 id="focus" class="font-serif text-heading-compact mb-24">Focus and links</h2>
        <a class="font-sans text-ui text-indigo underline" href="#colors">Sample link (tab to see the focus ring)</a>
      </section>

      <section class="mt-96" aria-labelledby="buttons">
        <h2 id="buttons" class="font-serif text-heading-compact mb-8">Buttons (WOR-4)</h2>
        <p class="font-sans text-body text-secondary mb-32">
          All 3 kinds × 5 states, external booking link, anchor vs button elements, icon variants, and mobile-menu block CTA.
        </p>

        <div class="flex flex-col gap-32">
          {buttonKinds.map(({ kind, label, darkBg, spec }) => (
            <div class={`border border-line p-24 ${darkBg ? 'bg-ink text-ivory' : 'bg-ivory text-ink'}`}>
              <div class="flex flex-wrap items-baseline justify-between gap-8 mb-24">
                <h3 class="font-sans text-ui">{label}</h3>
                <p class={`font-sans text-label ${darkBg ? 'text-ivory opacity-80' : 'text-secondary'}`}>{spec}</p>
              </div>
              <div class="flex flex-wrap items-center gap-24">
                {buttonStates.map((state) => (
                  <div class="flex flex-col items-start gap-8">
                    <span class={`font-sans text-label ${darkBg ? 'text-ivory opacity-80' : 'text-secondary'}`}>
                      {state.label}
                    </span>
                    <Button
                      kind={kind}
                      disabled={state.key === 'disabled'}
                      data-preview-state={
                        state.key === 'hover' || state.key === 'focus' || state.key === 'active'
                          ? state.key
                          : undefined
                      }
                    />
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>

        <div class="mt-48 grid gap-32 md:grid-cols-2">
          <div class="border border-line p-24">
            <h3 class="font-sans text-ui text-ink mb-16">Live interactive elements (&lt;a&gt; &amp; &lt;button&gt;)</h3>
            <div class="flex flex-wrap items-center gap-16">
              <Button kind="primary" href={links.booking.href} external />
              <Button kind="secondary" href={links.work.href} icon="→">View selected work</Button>
              <Button kind="primary" type="button" icon="none">Submit action</Button>
              <Button kind="secondary" type="button" disabled>Unavailable action</Button>
            </div>
          </div>

          <div class="border border-line p-24">
            <h3 class="font-sans text-ui text-ink mb-16">Mobile-menu CTA variant (block)</h3>
            <div class="border border-line bg-raised p-16" style="max-width: 320px;">
              <Button block href={links.booking.href} external />
            </div>
          </div>
        </div>
      </section>

      <section class="mt-96" aria-labelledby="directional-links">
        <h2 id="directional-links" class="font-serif text-heading-compact mb-8">DirectionalLink (WOR-5)</h2>
        <p class="font-sans text-body text-secondary mb-32">
          Inline-flex row (padding 12px 4px, gap 12px) pairing a 14px DM Sans Regular label with an 18px decorative arrow. Label underlines in 140ms with zero layout shift; arrow never underlines.
        </p>

        <div class="flex flex-col gap-32">
          {directionalLinkVariants.map((variant) => (
            <div class={`border border-line p-24 ${variant.darkBg ? 'bg-ink text-ivory' : 'bg-ivory text-ink'}`}>
              <div class="flex flex-wrap items-baseline justify-between gap-8 mb-24">
                <h3 class="font-sans text-ui">{variant.title}</h3>
                <p class={`font-sans text-label ${variant.darkBg ? 'text-ivory opacity-80' : 'text-secondary'}`}>
                  {variant.spec}
                </p>
              </div>
              <div class="flex flex-wrap items-center gap-24">
                {buttonStates.map((state) => (
                  <div class="flex flex-col items-start gap-8">
                    <span class={`font-sans text-label ${variant.darkBg ? 'text-ivory opacity-80' : 'text-secondary'}`}>
                      {state.label}
                    </span>
                    <DirectionalLink
                      href={variant.href}
                      label={variant.label}
                      arrow={variant.arrow}
                      external={variant.external}
                      tone={variant.tone}
                      aria-label={variant.ariaLabel}
                      disabled={state.key === 'disabled'}
                      data-preview-state={
                        state.key === 'hover' || state.key === 'focus' || state.key === 'active'
                          ? state.key
                          : undefined
                      }
                    />
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>

        <div class="mt-32 border border-line p-24">
          <h3 class="font-sans text-ui text-ink mb-16">Live site destinations</h3>
          <div class="flex flex-wrap items-center gap-24">
            <DirectionalLink href={links.work.href} label={hero.secondaryCta.label} />
            <DirectionalLink href={links.phpSymfony.href} label={services.php.link.label} />
            <DirectionalLink href={links.shopify.href} label={services.shopify.link.label} />
            <DirectionalLink href={links.sevenCups.href} label="Visit 7cups" arrow="↗" external />
          </div>
        </div>
      </section>

      <section class="mt-96" aria-labelledby="text-links">
        <h2 id="text-links" class="font-serif text-heading-compact mb-8">TextLink (WOR-5)</h2>
        <p class="font-sans text-body text-secondary mb-32">
          Compact inline link with arrow inside label text, min-height 44px touch target across sizes 14/13/12/11, tones ink/ivory/link, external new-tab announcements, and active navigation current state.
        </p>

        <div class="flex flex-col gap-32">
          {textLinkTones.map((item) => (
            <div class={`border border-line p-24 ${item.darkBg ? 'bg-ink text-ivory' : 'bg-ivory text-ink'}`}>
              <div class="flex flex-wrap items-baseline justify-between gap-8 mb-24">
                <h3 class="font-sans text-ui">{item.title}</h3>
                <p class={`font-sans text-label ${item.darkBg ? 'text-ivory opacity-80' : 'text-secondary'}`}>
                  {item.spec}
                </p>
              </div>
              <div class="flex flex-wrap items-center gap-24">
                {buttonStates.map((state) => (
                  <div class="flex flex-col items-start gap-8">
                    <span class={`font-sans text-label ${item.darkBg ? 'text-ivory opacity-80' : 'text-secondary'}`}>
                      {state.label}
                    </span>
                    <TextLink
                      href={item.href}
                      label={item.label}
                      tone={item.tone}
                      external={item.external}
                      disabled={state.key === 'disabled'}
                      data-preview-state={
                        state.key === 'hover' || state.key === 'focus' || state.key === 'active'
                          ? state.key
                          : undefined
                      }
                    />
                  </div>
                ))}
                {!item.darkBg && (
                  <div class="flex flex-col items-start gap-8">
                    <span class="font-sans text-label text-secondary">Current (nav)</span>
                    <TextLink href={links.work.href} current>Work</TextLink>
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>

        <div class="mt-32 grid gap-32 md:grid-cols-2">
          <div class="border border-line p-24">
            <h3 class="font-sans text-ui text-ink mb-16">Size scale (14 · 13 · 12 · 11 — all ≥44px touch height)</h3>
            <div class="flex flex-wrap items-center gap-24">
              {textLinkSizes.map((size) => (
                <div class="flex flex-col items-start gap-8">
                  <span class="font-sans text-label text-secondary">{size}px</span>
                  <TextLink href={team.people[0].href} size={size} external>
                    {team.people[0].linkLabel}
                  </TextLink>
                </div>
              ))}
            </div>
          </div>

          <div class="border border-line p-24">
            <h3 class="font-sans text-ui text-ink mb-16">Live site usages (nav, engagements, products, footer)</h3>
            <div class="flex flex-wrap items-center gap-24">
              <TextLink href={links.work.href} current>Work</TextLink>
              <TextLink href={links.products.href}>Products</TextLink>
              <TextLink href={engagements.home.items[1].href} external>{engagements.home.items[1].linkLabel}</TextLink>
              <TextLink href={products.featured.href} tone="link" external>{products.featured.linkLabel}</TextLink>
              <TextLink href={links.privacy.href} size={12}>Privacy Policy</TextLink>
            </div>
          </div>
        </div>
      </section>

      <section class="mt-96" aria-labelledby="section-headings">
        <SectionHeading
          headingId="section-headings"
          as="h2"
          eyebrow="EDITORIAL HEADING PRIMITIVE · WOR-6"
          eyebrowSize={11}
          heading="SectionHeading (WOR-6)"
          size="compact"
          data-sg-specimen="level-h2"

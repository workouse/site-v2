---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import SoloEdge from '../components/SoloEdge.astro';
import Competencies from '../components/Competencies.astro';
import Projects from '../components/Projects.astro';
import Clients from '../components/Clients.astro';
import Philosophy from '../components/Philosophy.astro';
import Expertise from '../components/Expertise.astro';
import NewsletterSubscribe from '../components/NewsletterSubscribe.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <!-- Sticky Nav Bar -->
  <Header />

  <!-- Single Page Content Sections -->
  <main id="main-content" class="flex-grow">
    <!-- Hero Header Block -->
    <Hero />

    <!-- Solo Architect Pitch & Profile -->
    <SoloEdge />

    <!-- Core Services/Competencies Cards -->
    <Competencies />

    <!-- Projects Section -->
    <Projects />

    <!-- Previous Clients Section -->
    <Clients />

    <!-- Simplicity Quote Axiom -->
    <Philosophy />

    <!-- Stack, Niche tech, and OSS work -->
    <Expertise />

    <!-- Newsletter & Campaign Email Subscription -->
    <NewsletterSubscribe />
  </main>

  <!-- Connect channels and legal info -->
  <Footer />
</Layout>

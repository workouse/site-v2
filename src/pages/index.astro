---
import Layout from '../layouts/Layout.astro';
import EditorialHero from '../components/sections/EditorialHero.astro';
import ClientLogoStrip from '../components/sections/ClientLogoStrip.astro';
import SpecialistServices from '../components/sections/SpecialistServices.astro';
import SelectedClientEngagements from '../components/sections/SelectedClientEngagements.astro';
import StudioProducts from '../components/sections/StudioProducts.astro';
import PeopleBehindWorkouse from '../components/sections/PeopleBehindWorkouse.astro';
import FinalContactCTA from '../components/sections/FinalContactCTA.astro';
import AuditHashRedirect from '../components/audit/AuditHashRedirect.astro';
---

<Layout>
  <!-- Forwards legacy /#audit links to the dedicated audit route -->
  <AuditHashRedirect />

  <EditorialHero />
  <ClientLogoStrip />
  <SpecialistServices />
  <SelectedClientEngagements />
  <StudioProducts />
  <PeopleBehindWorkouse />

  <FinalContactCTA slot="cta" />

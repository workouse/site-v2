---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import LanguageSwitch from '../../../components/LanguageSwitch.astro';
import NewsletterSubscribe from '../../../components/NewsletterSubscribe.astro';
import { getPostsByLang, getCleanSlug, getPostTranslation, calculateReadTime, type BlogPost } from '../../../lib/blog';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getPostsByLang('tr');
  return posts.map((post) => ({
    params: { slug: getCleanSlug(post.slug) },
    props: { post },
  }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const { Content } = await post.render();

const cleanSlug = getCleanSlug(post.slug);
const translationPost = await getPostTranslation(post, 'en');
const enPath = translationPost ? `/blog/${getCleanSlug(translationPost.slug)}` : '/blog';

const formattedDate = new Intl.DateTimeFormat('tr-TR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(post.data.pubDate);

const readTime = calculateReadTime(post.body || '');

const schema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://workouse.com/blog/tr/${cleanSlug}`
  },
  "headline": post.data.title,
  "description": post.data.description,
  "image": post.data.featuredImage || "https://avatars.githubusercontent.com/u/55496985?s=400&u=cf5cb2d74029d653813b39d624e44b8f74bc63c1&v=4",
  "datePublished": post.data.pubDate.toISOString(),
  "dateModified": (post.data.updatedDate || post.data.pubDate).toISOString(),
  "author": {
    "@type": "Person",
    "name": post.data.author
  },
  "publisher": {
    "@type": "Organization",
    "name": "Workouse",
    "url": "https://workouse.com",
    "logo": {
      "@type": "ImageObject",
      "url": "https://avatars.githubusercontent.com/u/55496985?s=400&u=cf5cb2d74029d653813b39d624e44b8f74bc63c1&v=4"
    }
  }
};
---

<Layout
  title={`${post.data.title} | Workouse Blog`}
  description={post.data.description}
  ogType="article"
  publishedTime={post.data.pubDate.toISOString()}
  modifiedTime={(post.data.updatedDate || post.data.pubDate).toISOString()}
  author={post.data.author}
  image={post.data.featuredImage}
  lang="tr"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
    <link rel="alternate" hreflang="tr" href={`https://workouse.com/blog/tr/${cleanSlug}`} />
    {translationPost && (
      <link rel="alternate" hreflang="en" href={`https://workouse.com${enPath}`} />
    )}
    <link rel="alternate" hreflang="x-default" href={`https://workouse.com/blog/${cleanSlug}`} />
  </Fragment>

  <Header />

  <main id="main-content" class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-20">
    <!-- Back to Blog Link & Language Selector -->
    <div class="flex items-center justify-between gap-4 mb-8">
      <a
        href="/blog/tr"
        class="inline-flex items-center gap-2 text-xs font-mono font-semibold uppercase text-zinc-600 dark:text-zinc-400 hover:text-brand-blue dark:hover:text-brand-yellow transition"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        <span>Bloga Dön</span>
      </a>

      <LanguageSwitch currentLang="tr" targetPathEn={enPath} targetPathTr={`/blog/tr/${cleanSlug}`} />
    </div>

    <!-- Article Header -->
    <header class="space-y-4 pb-8 border-b border-zinc-200 dark:border-zinc-900 mb-10">
      <div class="flex flex-wrap items-center gap-3 text-xs font-mono text-zinc-600 dark:text-zinc-400">
        <span class="px-2.5 py-0.5 rounded-full bg-brand-yellow/10 border border-brand-yellow/30 text-brand-blue dark:text-brand-yellow font-medium">
          TÜRKÇE
        </span>
        <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
        <span>•</span>
        <span>{readTime} dk okuma</span>
        <span>•</span>
        <span>Yazar: {post.data.author}</span>
      </div>

      <h1 class="font-display text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50 leading-tight">
        {post.data.title}
      </h1>

      <p class="text-zinc-600 dark:text-zinc-400 text-lg sm:text-xl leading-relaxed">
        {post.data.description}
      </p>

      <!-- Tags & Translation Switcher Banner -->
      <div class="flex flex-wrap items-center justify-between gap-4 pt-4">
        <div class="flex flex-wrap gap-2">
          {post.data.tags.map((tag) => (
            <a
              href={`/blog/tr?tag=${encodeURIComponent(tag.toLowerCase())}`}
              class="text-xs font-mono px-3 py-1 rounded bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-zinc-800 dark:text-zinc-300 hover:border-brand-yellow/50 hover:text-brand-blue dark:hover:text-brand-yellow transition duration-200"
            >
              #{tag}
            </a>
          ))}
        </div>

        {translationPost && (
          <a
            href={enPath}
            class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-brand-yellow/10 border border-brand-yellow/30 text-brand-blue dark:text-brand-yellow text-xs font-medium hover:bg-brand-yellow/20 transition"
          >
            <span>🇬🇧 Read this post in English</span>
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        )}
      </div>
    </header>

    <!-- Article Content -->
    <article class="prose prose-zinc dark:prose-invert max-w-none prose-headings:font-display prose-headings:font-bold prose-headings:text-zinc-950 dark:prose-headings:text-zinc-50 prose-p:text-zinc-700 dark:prose-p:text-zinc-300 prose-p:leading-relaxed prose-a:text-brand-blue dark:prose-a:text-brand-yellow hover:prose-a:underline prose-code:text-brand-blue dark:prose-code:text-brand-yellow prose-code:bg-zinc-100 dark:prose-code:bg-zinc-900 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-pre:bg-zinc-900 prose-pre:text-zinc-100 prose-pre:border prose-pre:border-zinc-800 prose-li:text-zinc-700 dark:prose-li:text-zinc-300">
      <Content />
    </article>

    <!-- Author Callout Box -->
    <div class="mt-16 pt-8 border-t border-zinc-200 dark:border-zinc-900 glow-card rounded-2xl p-6 sm:p-8 flex items-center gap-6 mb-12">
      <img
        src="https://avatars.githubusercontent.com/u/55496985?s=400&u=cf5cb2d74029d653813b39d624e44b8f74bc63c1&v=4"
        alt={post.data.author}
        class="w-16 h-16 rounded-full border border-zinc-300 dark:border-zinc-800 shrink-0"
      />
      <div>
        <h4 class="font-display font-bold text-zinc-950 dark:text-zinc-100 text-lg">{post.data.author}</h4>
        <p class="text-zinc-600 dark:text-zinc-400 text-sm mt-1">
          Workouse Kıdemli Yazılım Mimarı ve Kurucusu. Yüksek ölçekli mikrohizmetler, Haskell, Rust, Cloudflare Edge ve dayanıklı bulut mimarileri uzmanı.
        </p>
      </div>
    </div>

    <!-- Newsletter Subscription -->
    <NewsletterSubscribe lang="tr" />
  </main>

  <Footer />
</Layout>

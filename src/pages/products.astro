---
/**
 * Studio products page (/products) — Bitig, GroundBox, and Ula.
 *
 * Composes SectionHeading (page H1), the existing StudioProducts section
 * (featured Bitig + supporting product cards), and FinalContactCTA in Layout's
 * `cta` slot.
 */
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import StudioProducts from '../components/sections/StudioProducts.astro';
import FinalContactCTA from '../components/sections/FinalContactCTA.astro';
import { links, products } from '../data/site';

export const prerender = true;

const PAGE_TITLE = `${links.products.label} — Workouse`;
const PAGE_DESCRIPTION = products.intro;
---

<Layout
  title={PAGE_TITLE}
  description={PAGE_DESCRIPTION}
  currentPath={links.products.href}
>
  <section class="studio-page-intro" aria-labelledby="products-page-heading">
    <SectionHeading
      as="h1"
      size="section"
      eyebrow="STUDIO / OWN SOFTWARE"
      heading={links.products.label}
      headingId="products-page-heading"
    />
  </section>

  <div class="products-page-body">
    <StudioProducts />
  </div>

  <FinalContactCTA slot="cta" />
</Layout>

<style>
  .studio-page-intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-24, 24px);
    box-sizing: border-box;
    width: 100%;
    padding: 64px 24px 48px;
    background-color: var(--surface-page, #faf8f4);
    border-bottom: 1px solid var(--border-subtle, #d7d9df);
  }

  .studio-page-intro :global(.wo-section-heading),
  .studio-page-intro :global(.wo-section-heading__title) {
    max-width: 100%;
    overflow-wrap: break-word;
  }

  @media (min-width: 768px) {
    .studio-page-intro {
      padding: 80px 40px 64px;
    }
  }

  @media (min-width: 1024px) {
    .studio-page-intro {
      padding: 88px 96px 64px;
    }
  }

  @media (min-width: 1024px) and (max-width: 1439px) {
    .products-page-body :global(.studio-products__heading),
    .products-page-body :global(.studio-products__intro-body),
    .products-page-body :global(.featured-product__media),
    .products-page-body :global(.featured-product__details) {
      flex-shrink: 1;
      min-width: 0;
    }
  }
</style>
